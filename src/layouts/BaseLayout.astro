---
import "../styles/global.css";
import "../styles/search.css";
import "../styles/transitions.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import MobileBottomNav from "../components/MobileBottomNav.astro";
import PwaToast from "../components/PwaToast.astro";
import PwaInstallButton from "../components/PwaInstallButton.astro";
import ThemePicker from "../components/ThemePicker.astro";
import SEO from "../components/SEO.astro";
import type { SEOProps } from "../lib/seo";
import { languages, defaultLang, isRTL, stripLocalePrefix } from "../i18n/ui";
import { getAbsoluteLocaleUrl } from "astro:i18n";

export interface Props {
  seo?: SEOProps;
  title?: string;
  description?: string;
  image?: string;
  preloadHero?: boolean;
  /** Set false to keep app-like/private pages out of the Pagefind search index. */
  searchable?: boolean;
}

const { seo, title, description, image, preloadHero, searchable = true } = Astro.props;
const seoProps = { ...seo, title, description, image };
const currentLocale = Astro.currentLocale || defaultLang;
const localePath = stripLocalePrefix(Astro.url.pathname);
const alternateUrls = Object.keys(languages).map((locale) => ({
  locale,
  href: getAbsoluteLocaleUrl(locale, localePath),
}));
---

<!doctype html>
<html lang={currentLocale} dir={isRTL(currentLocale) ? "rtl" : "ltr"} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/pwa-192x192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#059669" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#059669" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Nayee Subah Foundation" />
    {preloadHero && <link rel="preload" as="image" href="/images/hero-bg.jpg" />}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/inter-latin.woff2" />
    <SEO {...seoProps} />
    {alternateUrls.map(({ locale, href }) => (
      <link rel="alternate" hreflang={locale} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLang, localePath)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NGO",
      name: "Nayee Subah Foundation",
      url: "https://nayeesubah.github.io",
      logo: "https://nayeesubah.github.io/favicon.svg",
      description: "Nayee Subah Foundation is a non-profit social organization dedicated to improving society through education, community development, humanitarian support, skill development, employment opportunities, health awareness, and social welfare.",
      address: { "@type": "PostalAddress", addressCountry: "IN" },
      sameAs: ["https://facebook.com/nayeesubah", "https://instagram.com/nayeesubah", "https://youtube.com/@nayeesubah"],
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Nayee Subah Foundation",
      url: "https://nayeesubah.github.io",
    })} />
    {import.meta.env.PUBLIC_UMAMI_URL && import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        defer
        src={`${import.meta.env.PUBLIC_UMAMI_URL}/script.js`}
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
      />
    )}
    <script is:inline>
      (function () {
        // Restore theme (default light)
        const theme = localStorage.getItem("theme");
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        }
        // Restore color palette theme
        const palette = localStorage.getItem("theme-palette");
        if (palette && palette !== "brand") {
          document.documentElement.setAttribute("data-theme", palette);
        }
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-page text-body font-sans antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-accent-text focus:rounded-xl focus:outline-none">
      Skip to main content
    </a>
    <Navbar />
    <main
      id="main-content"
      class="flex-1 pb-16 lg:pb-0"
      data-pagefind-body={searchable ? true : undefined}
      data-pagefind-ignore={searchable ? undefined : "all"}
    >
      <slot />
    </main>
    <Footer />
    <MobileBottomNav />
    <!-- <ThemePicker /> -->
    <PwaToast />
    <PwaInstallButton />

    <div
      id="search-modal"
      class="hidden fixed inset-0 z-[60]"
      role="dialog"
      aria-modal="true"
      aria-label="Search the site"
    >
      <div id="search-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
      <div class="relative mx-auto mt-16 sm:mt-24 w-[92%] max-w-2xl">
        <div class="card p-4 sm:p-6 shadow-2xl">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xs font-semibold text-muted uppercase tracking-widest">Search</h2>
            <button id="search-close" class="p-1.5 rounded-lg text-muted hover:text-accent hover:bg-accent-soft transition-colors" aria-label="Close search">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
            </button>
          </div>
          <div id="pagefind-search"></div>
          <p id="search-unavailable" class="hidden text-sm text-muted py-6 text-center">
            Search runs on the built site. Run <code class="text-accent">npm run build &amp;&amp; npm run preview</code> to try it locally.
          </p>
        </div>
      </div>
    </div>

    <script>
      // Lazy-loaded Pagefind search modal. The index lives at /pagefind/ and is
      // generated by `pagefind --site dist` during the build.
      let pagefindLoaded = false;

      function openSearch() {
        const modal = document.getElementById("search-modal");
        if (!modal) return;
        modal.classList.remove("hidden");
        document.body.style.overflow = "hidden";

        if (!pagefindLoaded) {
          pagefindLoaded = true;
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = "/pagefind/pagefind-ui.css";
          document.head.appendChild(link);

          const script = document.createElement("script");
          script.src = "/pagefind/pagefind-ui.js";
          script.onload = () => {
            try {
              // @ts-expect-error injected global
              new window.PagefindUI({
                element: "#pagefind-search",
                showSubResults: true,
                showImages: false,
                resetStyles: false,
              });
            } catch {
              document.getElementById("search-unavailable")?.classList.remove("hidden");
            }
            focusSearchInput();
          };
          script.onerror = () => {
            document.getElementById("search-unavailable")?.classList.remove("hidden");
          };
          document.body.appendChild(script);
        } else {
          focusSearchInput();
        }
      }

      function focusSearchInput() {
        requestAnimationFrame(() => {
          (document.querySelector("#pagefind-search input") as HTMLInputElement | null)?.focus();
        });
      }

      function closeSearch() {
        const modal = document.getElementById("search-modal");
        if (!modal) return;
        modal.classList.add("hidden");
        document.body.style.overflow = "";
      }

      // Delegated so it survives view-transition navigations.
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest("[data-search-open]")) {
          e.preventDefault();
          openSearch();
        } else if (target.id === "search-backdrop" || target.closest("#search-close")) {
          closeSearch();
        }
      });

      document.addEventListener("keydown", (e) => {
        const modalOpen = !document.getElementById("search-modal")?.classList.contains("hidden");
        if ((e.key === "k" && (e.metaKey || e.ctrlKey)) || (e.key === "/" && !isTyping(e))) {
          e.preventDefault();
          openSearch();
        } else if (e.key === "Escape" && modalOpen) {
          closeSearch();
        }
      });

      function isTyping(e: KeyboardEvent): boolean {
        const el = e.target as HTMLElement;
        return el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.isContentEditable;
      }
    </script>

    <script>
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js");
        });
      }
    </script>
  </body>
</html>
