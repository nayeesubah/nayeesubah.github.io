---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";

const volunteers = (await getCollection("volunteers"))
  .filter((v) => v.data.active)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const whyVolunteer = [
  {
    title: "Make a Difference",
    description: "Your time and skills can create real, lasting change in communities across India.",
    icon: "M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  },
  {
    title: "Build Skills",
    description: "Gain valuable experience in project management, community engagement, and leadership.",
    icon: "M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.627 48.627 0 0 1 12 20.904a48.627 48.627 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.57 50.57 0 0 0-2.658-.813A59.905 59.905 0 0 1 12 3.493a59.902 59.902 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342",
  },
  {
    title: "Meet Like-minded People",
    description: "Join a community of passionate individuals dedicated to social change.",
    icon: "M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z",
  },
  {
    title: "Flexible Commitment",
    description: "Volunteer on your own terms — weekends, events, or ongoing projects.",
    icon: "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  },
];

const getInitials = (name: string) =>
  name.split(" ").map((n) => n[0]).join("").slice(0, 2).toUpperCase();
---

<BaseLayout
  title="Volunteer with an NGO in Jharkhand — Make a Difference"
  description="Join Nayee Subah Foundation as a volunteer. Make a difference in rural Jharkhand communities through education, healthcare, skill development, and community projects."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/volunteer/" class="mb-8" />
        <div class="max-w-3xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Volunteer</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Lend a <span class="text-accent">Helping Hand</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed mb-8">
            Volunteers are the heart of Nayee Subah Foundation. Whether you have a few hours or want to commit regularly, your contribution makes a tangible difference in the lives of those we serve.
          </p>
          <a href="/volunteer/join/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200 text-lg px-8 py-4">
            Become a Volunteer
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-title mb-12">
          <h2>Why <span class="text-accent">Volunteer</span>?</h2>
          <p>Discover the benefits of joining our volunteer community.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {whyVolunteer.map((item) => (
            <div class="card p-6 text-center group">
              <div class="mx-auto mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <h3 class="font-semibold text-lg mb-3">{item.title}</h3>
              <p class="text-muted text-sm">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {volunteers.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-title mb-12">
          <h2>Our <span class="text-accent">Volunteers</span></h2>
          <p>Meet the dedicated individuals driving our mission forward.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {volunteers.map((v) => (
            <div class="card p-6 text-center group">
              <div class="mx-auto mb-4 h-20 w-20 rounded-full bg-accent-soft flex items-center justify-center text-accent text-xl font-bold group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
                {getInitials(v.data.name)}
              </div>
              <h3 class="font-semibold text-lg">{v.data.name}</h3>
              {v.data.availability && (
                <p class="text-xs text-muted mb-2">{v.data.availability}</p>
              )}
              {v.data.skills && v.data.skills.length > 0 && (
                <div class="flex flex-wrap justify-center gap-1.5 mb-3">
                  {v.data.skills.map((skill) => (
                    <span class="inline-flex items-center rounded-full bg-accent-soft text-accent px-2.5 py-0.5 text-xs font-medium">
                      {skill}
                    </span>
                  ))}
                </div>
              )}
              {v.data.recognition && (
                <p class="text-xs text-accent font-medium">{v.data.recognition}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
    )}

    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-6">
            Ready to <span class="text-accent">Volunteer</span>?
          </h2>
          <p class="text-muted text-lg mb-8">
            Join our team of passionate volunteers and help us create a better tomorrow.
          </p>
          <a href="/volunteer/join/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200 text-lg px-8 py-4">
            Register Now
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
