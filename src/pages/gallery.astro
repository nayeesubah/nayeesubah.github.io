---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";

const galleryItems = (await getCollection("gallery")).sort((a, b) => {
  if (!a.data.date || !b.data.date) return 0;
  return b.data.date.getTime() - a.data.date.getTime();
});

const galleryPhotos = galleryItems.flatMap((item) => {
  const images =
    item.data.media?.images?.length
      ? item.data.media.images
      : item.data.media?.image
        ? [item.data.media.image]
        : [];
  const base = {
    title: item.data.title || "Gallery Image",
    mediaUrl: item.data.media?.mediaUrl || "",
    category: item.data.category,
    project: item.data.project || "",
    location: item.data.location || "",
    description: item.data.description || "",
    date: item.data.date ? item.data.date.toISOString() : null,
    featured: item.data.featured,
  };
  if (item.data.media?.type === "video" && item.data.media.mediaUrl) {
    return [{ ...base, image: images[0] || "", isVideo: true }];
  }
  return images.map((image) => ({ ...base, image, isVideo: false }));
});

const categories = [...new Set(galleryPhotos.map((g) => g.category))];
const projects = new Set(galleryPhotos.map((g) => g.project).filter(Boolean));
const totalPhotos = galleryPhotos.length;

const formatCategory = (cat) =>
  cat.replace("-", " ").replace(/\b\w/g, (l) => l.toUpperCase());
---

<BaseLayout
  title="Photo & Video Gallery — Community Development in Action"
  description="Explore photos, videos, and project galleries from Nayee Subah Foundation's education, healthcare, and community development initiatives in rural India."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/gallery/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Gallery</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Our <span class="text-accent">Gallery</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            A photo album of moments captured from our events, activities, and community programs.
            Click any photo to open it in the viewer.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-10">
          <div class="card p-4 sm:p-5">
            <p class="text-2xl sm:text-3xl font-bold text-accent">{totalPhotos}</p>
            <p class="text-xs sm:text-sm text-muted mt-1">Moments Captured</p>
          </div>
          <div class="card p-4 sm:p-5">
            <p class="text-2xl sm:text-3xl font-bold text-accent">{categories.length}</p>
            <p class="text-xs sm:text-sm text-muted mt-1">Categories</p>
          </div>
          <div class="card p-4 sm:p-5">
            <p class="text-2xl sm:text-3xl font-bold text-accent">{projects.size}</p>
            <p class="text-xs sm:text-sm text-muted mt-1">Initiatives</p>
          </div>
          <div class="card p-4 sm:p-5">
            <p class="text-2xl sm:text-3xl font-bold text-accent">{galleryPhotos.filter((g) => g.featured).length}</p>
            <p class="text-xs sm:text-sm text-muted mt-1">Featured Stories</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mb-10" id="gallery-filters" role="group" aria-label="Filter gallery by category">
          <button class="gallery-filter px-4 py-2 rounded-lg text-sm font-medium bg-accent text-accent-text transition-colors" data-filter="all" aria-pressed="true">
            All
            <span class="ml-1.5 px-1.5 py-0.5 rounded-md bg-black/10 text-current text-[11px]">{totalPhotos}</span>
          </button>
          {categories.map((cat) => (
            <button class="gallery-filter px-4 py-2 rounded-lg text-sm font-medium bg-accent-soft text-accent hover:bg-accent hover:text-accent-text transition-colors" data-filter={cat} aria-pressed="false">
              {formatCategory(cat)}
              <span class="ml-1.5 px-1.5 py-0.5 rounded-md bg-black/10 text-current text-[11px]">{galleryPhotos.filter((g) => g.category === cat).length}</span>
            </button>
          ))}
        </div>

        <div class="columns-2 md:columns-3 xl:columns-4 gap-3 sm:gap-4" id="gallery-grid">
          {galleryPhotos.map((photo, i) => (
            <figure
              class="gallery-item gallery-card break-inside-avoid mb-3 sm:mb-4 rounded-2xl overflow-hidden bg-card border border-border hover:shadow-lg hover:border-accent-border transition-all duration-300"
              data-index={i}
              data-category={photo.category}
            >
              <button type="button" class="gallery-open relative block w-full cursor-zoom-in group" aria-label={`Open ${photo.title || "gallery image"} in viewer`}>
                <img
                  src={photo.image || "/images/nsf-logo.webp"}
                  alt={photo.description || photo.title || "Gallery image"}
                  class="w-full h-auto transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-between p-3 sm:p-4">
                  <span class="flex items-center gap-1.5 text-white text-xs sm:text-sm font-medium">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 7.5v6m3-3h-6" />
                    </svg>
                    View
                  </span>
                  {photo.isVideo && (
                    <span class="flex items-center justify-center h-9 w-9 rounded-full bg-black/50 text-white">
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                  )}
                </div>
                {photo.featured && (
                  <span class="absolute top-3 left-3 inline-flex items-center gap-1 px-2 py-1 rounded-full bg-accent text-accent-text text-[11px] font-semibold shadow-md">
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24"><path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>
                    Featured
                  </span>
                )}
              </button>
              <figcaption class="px-3.5 py-3 sm:px-4 sm:py-3.5 border-t border-border">
                <h3 class="font-semibold text-sm text-body truncate mb-1.5">{photo.title || "Gallery Image"}</h3>
                <div class="flex items-center justify-between gap-2">
                  <span class="flex items-center gap-1.5 text-xs text-muted shrink min-w-0">
                    <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                    </svg>
                    <span class="gallery-date truncate" data-date={photo.date || ""}>
                      {photo.date ? new Date(photo.date).toLocaleDateString("en-US", { year: "numeric", month: "short" }) : "—"}
                    </span>
                  </span>
                  <span class="shrink-0 px-2 py-0.5 rounded-full bg-accent-soft text-accent text-[11px] font-medium">{formatCategory(photo.category)}</span>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>

        <div id="no-results" class="hidden text-center py-20">
          <div class="text-5xl mb-4">🖼️</div>
          <h3 class="text-xl font-semibold mb-2">No Photos Found</h3>
          <p class="text-muted">Try selecting a different category.</p>
        </div>
      </div>
    </section>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[100] opacity-0 invisible transition-opacity duration-300" role="dialog" aria-modal="true" aria-label="Image viewer" aria-hidden="true">
    <div class="absolute inset-0 bg-black/95 backdrop-blur-sm"></div>

    <div class="relative z-10 flex flex-col h-full">
      <div class="flex items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4">
        <div class="flex items-center gap-3 min-w-0">
          <span id="lb-title" class="text-white font-semibold text-sm sm:text-base truncate"></span>
          <span id="lb-counter" class="text-white/60 text-xs sm:text-sm shrink-0"></span>
        </div>
        <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
          <button id="lb-zoom-out" class="lb-btn" aria-label="Zoom out" title="Zoom out (-)">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" /></svg>
          </button>
          <span id="lb-zoom" class="hidden sm:inline text-white/60 text-xs w-12 text-center">100%</span>
          <button id="lb-zoom-in" class="lb-btn" aria-label="Zoom in" title="Zoom in (+)">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14" /></svg>
          </button>
          <button id="lb-reset" class="lb-btn" aria-label="Reset zoom" title="Reset zoom (0)">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
          <span class="w-px h-5 bg-white/15 mx-1 hidden sm:block"></span>
          <a id="lb-open" href="#" target="_blank" rel="noopener" class="lb-btn" aria-label="Open full size image in new tab" title="Open full size">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
          </a>
          <button id="lb-close" class="lb-btn" aria-label="Close viewer" title="Close (Esc)">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>

      <div class="relative flex-1 min-h-0">
        <button id="lb-prev" class="lb-nav left-2 sm:left-5" aria-label="Previous image" title="Previous (←)">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
        </button>
        <div id="lb-frame" class="absolute inset-0 flex items-center justify-center p-3 sm:p-8">
          <img id="lb-img" class="max-w-full max-h-full select-none object-contain shadow-2xl rounded-lg" alt="" draggable="false" />
          <video id="lb-video" class="hidden max-w-full max-h-full rounded-lg shadow-2xl bg-black" controls playsinline></video>
        </div>
        <button id="lb-next" class="lb-nav right-2 sm:right-5" aria-label="Next image" title="Next (→)">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
        </button>
      </div>

      <div class="px-4 py-3 sm:px-6 sm:py-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2 flex-wrap min-w-0">
            <span id="lb-category" class="shrink-0 px-2.5 py-1 rounded-full bg-accent text-accent-text text-[11px] font-semibold"></span>
            <span id="lb-date" class="flex items-center gap-1.5 text-white/70 text-xs sm:text-sm">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
              <span id="lb-date-text"></span>
            </span>
            <span id="lb-location" class="flex items-center gap-1.5 text-white/70 text-xs sm:text-sm">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
              <span id="lb-location-text"></span>
            </span>
          </div>
          <span id="lb-hint" class="hidden sm:block text-white/50 text-xs">Drag to pan · Scroll / + − to zoom · ← → to navigate · Esc to close</span>
        </div>
        <p id="lb-description" class="text-white/80 text-sm mt-2 leading-relaxed line-clamp-2"></p>
        <div id="lb-thumbs" class="hidden lg:flex items-center gap-2 mt-3 overflow-x-auto no-scrollbar"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script type="application/json" id="gallery-data" set:html={JSON.stringify(galleryPhotos)} />

<script>
  const GALLERY = JSON.parse(document.getElementById("gallery-data").textContent);
  const grid = document.getElementById("gallery-grid");
  const filters = document.querySelectorAll(".gallery-filter");
  const cards = Array.from(document.querySelectorAll(".gallery-item"));
  const noResults = document.getElementById("no-results");

  const lb = {
    root: document.getElementById("lightbox"),
    title: document.getElementById("lb-title"),
    counter: document.getElementById("lb-counter"),
    category: document.getElementById("lb-category"),
    date: document.getElementById("lb-date-text"),
    location: document.getElementById("lb-location-text"),
    description: document.getElementById("lb-description"),
    hint: document.getElementById("lb-hint"),
    zoomLabel: document.getElementById("lb-zoom"),
    openLink: document.getElementById("lb-open"),
    close: document.getElementById("lb-close"),
    prev: document.getElementById("lb-prev"),
    next: document.getElementById("lb-next"),
    zoomIn: document.getElementById("lb-zoom-in"),
    zoomOut: document.getElementById("lb-zoom-out"),
    reset: document.getElementById("lb-reset"),
    frame: document.getElementById("lb-frame"),
    img: document.getElementById("lb-img"),
    video: document.getElementById("lb-video"),
    thumbs: document.getElementById("lb-thumbs"),
  };

  const state = {
    visible: [], // gallery indices currently in the DOM (in grid order)
    slides: [], // flattened [{ gi, image, isVideo }] for visible items
    index: 0,
    scale: 1,
    tx: 0,
    ty: 0,
    baseW: 0,
    baseH: 0,
    isVideo: false,
    open: false,
    dragging: false,
    pointers: new Map(),
    pinchDist: 0,
  };

  const MIN_SCALE = 1;
  const MAX_SCALE = 6;

  const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" });
  const categoryLabel = (cat) => cat.replace("-", " ").replace(/\b\w/g, (l) => l.toUpperCase());

  /* ---------- Filters ---------- */

  function applyFilter() {
    const active = document.querySelector(".gallery-filter[aria-pressed='true']")?.dataset.filter || "all";
    let visibleCount = 0;

    cards.forEach((card) => {
      const match = active === "all" || card.dataset.category === active;
      card.classList.toggle("hidden", !match);
      if (match) visibleCount++;
    });

    noResults.classList.toggle("hidden", visibleCount > 0);
    state.visible = cards.filter((card) => !card.classList.contains("hidden")).map((card) => Number(card.dataset.index));
  }

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      filters.forEach((b) => {
        const isActive = b === btn;
        b.setAttribute("aria-pressed", String(isActive));
        b.classList.toggle("bg-accent", isActive);
        b.classList.toggle("text-accent-text", isActive);
        b.classList.toggle("bg-accent-soft", !isActive);
        b.classList.toggle("text-accent", !isActive);
        b.classList.toggle("hover:bg-accent", !isActive);
        b.classList.toggle("hover:text-accent-text", !isActive);
      });
      applyFilter();
    });
  });

  grid.addEventListener("click", (e) => {
    const card = e.target.closest(".gallery-item");
    if (!card || card.classList.contains("hidden")) return;
    openAt(cards.indexOf(card));
  });

  applyFilter();

  /* ---------- Lightbox helpers ---------- */

  function applyTransform(animate = false) {
    lb.img.style.transition = animate ? "transform 180ms ease-out" : "none";
    lb.img.style.transform = `translate(${state.tx}px, ${state.ty}px) scale(${state.scale})`;
    lb.zoomLabel.textContent = `${Math.round(state.scale * 100)}%`;
  }

  function clampPan() {
    const vw = lb.frame.clientWidth;
    const vh = lb.frame.clientHeight;
    const w = state.baseW * state.scale;
    const h = state.baseH * state.scale;
    const maxX = Math.max(0, (w - vw) / 2);
    const maxY = Math.max(0, (h - vh) / 2);
    state.tx = Math.min(maxX, Math.max(-maxX, state.tx));
    state.ty = Math.min(maxY, Math.max(-maxY, state.ty));
  }

  function resetTransform() {
    state.scale = 1;
    state.tx = 0;
    state.ty = 0;
    applyTransform(true);
  }

  function zoomAt(clientX, clientY, factor) {
    const rect = lb.frame.getBoundingClientRect();
    const cx = clientX - rect.left - rect.width / 2;
    const cy = clientY - rect.top - rect.height / 2;
    const next = Math.min(MAX_SCALE, Math.max(MIN_SCALE, state.scale * factor));
    const ratio = next / state.scale;
    state.tx = cx - (cx - state.tx) * ratio;
    state.ty = cy - (cy - state.ty) * ratio;
    state.scale = next;
    clampPan();
    applyTransform(true);
  }

  function buildSlides() {
    state.slides = [];
    state.visible.forEach((gi) => {
      const item = GALLERY[gi];
      state.slides.push({ gi, image: item.image, isVideo: Boolean(item.mediaUrl) });
    });
  }

  function setImage(step) {
    if (!state.slides.length) return;
    state.index = (state.index + step + state.slides.length) % state.slides.length;
    const slide = state.slides[state.index];
    const item = GALLERY[slide.gi];
    state.isVideo = slide.isVideo;

    lb.title.textContent = item.title;
    lb.counter.textContent = `${state.index + 1} / ${state.slides.length}`;
    lb.category.textContent = categoryLabel(item.category);
    lb.date.textContent = item.date ? dateFmt.format(new Date(item.date)) : "";
    lb.date.style.display = item.date ? "" : "none";
    lb.location.textContent = item.location;
    lb.location.style.display = item.location ? "" : "none";
    lb.description.textContent = item.description;
    lb.hint.style.display = state.isVideo ? "none" : "";
    lb.openLink.href = slide.image;
    lb.openLink.style.display = state.isVideo ? "none" : "";

    resetTransform();

    if (state.isVideo) {
      lb.video.src = item.mediaUrl;
      lb.video.poster = slide.image || "";
      lb.video.classList.remove("hidden");
      lb.img.classList.add("hidden");
      lb.video.play().catch(() => {});
      lb.zoomIn.disabled = lb.zoomOut.disabled = lb.reset.disabled = true;
    } else {
      lb.video.pause();
      lb.video.removeAttribute("src");
      lb.video.load();
      lb.video.classList.add("hidden");
      lb.img.classList.remove("hidden");
      lb.img.alt = item.description || item.title;
      lb.img.src = slide.image;
      lb.zoomIn.disabled = lb.zoomOut.disabled = lb.reset.disabled = false;
      preloadNeighbors();
    }

    renderThumbs();
  }

  function preloadNeighbors() {
    if (!state.slides.length) return;
    const next = state.slides[(state.index + 1) % state.slides.length];
    const prev = state.slides[(state.index - 1 + state.slides.length) % state.slides.length];
    [next, prev].forEach((s) => {
      if (s && !s.isVideo && s.image) {
        const img = new Image();
        img.src = s.image;
      }
    });
  }

  function renderThumbs() {
    lb.thumbs.innerHTML = "";
    if (state.slides.length <= 1) return;
    state.slides.forEach((slide, i) => {
      const it = GALLERY[slide.gi];
      const btn = document.createElement("button");
      btn.className =
        "w-14 h-14 shrink-0 rounded-lg overflow-hidden ring-offset-0 transition-opacity" +
        (i === state.index ? " ring-2 ring-accent" : " opacity-60 hover:opacity-100");
      btn.setAttribute("aria-label", `Go to image ${i + 1}`);
      btn.setAttribute("data-slide", String(i));
      const img = document.createElement("img");
      img.src = slide.image || it.image;
      img.alt = "";
      img.className = "w-full h-full object-cover";
      if (slide.isVideo) {
        img.className += " brightness-75";
        const play = document.createElement("span");
        play.className = "absolute inset-0 flex items-center justify-center text-white";
        play.innerHTML =
          '<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>';
        btn.appendChild(play);
      }
      btn.appendChild(img);
      btn.addEventListener("click", () => {
        state.index = i;
        setImage(0);
      });
      lb.thumbs.appendChild(btn);
    });
  }

  function openAt(cardIndex) {
    buildSlides();
    const gi = Number(cards[cardIndex].dataset.index);
    state.index = Math.max(0, state.slides.findIndex((s) => s.gi === gi));
    if (state.index === -1) state.index = 0;
    setImage(0);

    lb.root.classList.remove("invisible", "opacity-0");
    lb.root.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    state.open = true;
    lb.close.focus();
  }

  function closeLb() {
    if (!state.open) return;
    state.open = false;
    lb.root.classList.add("invisible", "opacity-0");
    lb.root.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    lb.video.pause();
    state.scale = 1;
  }

  function initImageSize() {
    if (state.isVideo) return;
    state.baseW = lb.img.clientWidth;
    state.baseH = lb.img.clientHeight;
    clampPan();
    applyTransform();
  }

  lb.img.addEventListener("load", initImageSize);
  window.addEventListener("resize", initImageSize);

  /* ---------- Zoom / pan / navigation controls ---------- */

  lb.zoomIn.addEventListener("click", () => zoomAt(lb.frame.clientWidth / 2, lb.frame.clientHeight / 2, 1.4));
  lb.zoomOut.addEventListener("click", () => zoomAt(lb.frame.clientWidth / 2, lb.frame.clientHeight / 2, 1 / 1.4));
  lb.reset.addEventListener("click", () => {
    if (!state.isVideo) resetTransform();
  });
  lb.close.addEventListener("click", closeLb);
  lb.next.addEventListener("click", () => setImage(1));
  lb.prev.addEventListener("click", () => setImage(-1));

  lb.frame.addEventListener(
    "wheel",
    (e) => {
      if (state.isVideo) return;
      e.preventDefault();
      zoomAt(e.clientX, e.clientY, e.deltaY < 0 ? 1.12 : 1 / 1.12);
    },
    { passive: false },
  );

  lb.frame.addEventListener("dblclick", (e) => {
    if (state.isVideo) return;
    if (state.scale > 1) resetTransform();
    else zoomAt(e.clientX, e.clientY, 2.5);
  });

  lb.frame.addEventListener("click", (e) => {
    if (state.open && e.target === lb.frame && state.scale === 1 && !state.isVideo) {
      closeLb();
    }
  });

  lb.frame.addEventListener("pointerdown", (e) => {
    if (state.isVideo) return;
    state.pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (state.pointers.size === 2) {
      state.dragging = false;
      const [a, b] = [...state.pointers.values()];
      state.pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
      return;
    }
    if (state.scale > 1) {
      state.dragging = true;
      state.startX = e.clientX;
      state.startY = e.clientY;
      state.startTx = state.tx;
      state.startTy = state.ty;
      lb.frame.setPointerCapture(e.pointerId);
      lb.frame.classList.add("cursor-grabbing");
    }
  });

  lb.frame.addEventListener("pointermove", (e) => {
    if (state.isVideo || !state.pointers.has(e.pointerId)) return;
    state.pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (state.pointers.size === 2) {
      const [a, b] = [...state.pointers.values()];
      const dist = Math.hypot(a.x - b.x, a.y - b.y);
      if (state.pinchDist > 0) {
        const midX = (a.x + b.x) / 2;
        const midY = (a.y + b.y) / 2;
        zoomAt(midX, midY, dist / state.pinchDist);
      }
      state.pinchDist = dist;
      return;
    }

    if (state.dragging) {
      state.tx = state.startTx + (e.clientX - state.startX);
      state.ty = state.startTy + (e.clientY - state.startY);
      clampPan();
      applyTransform();
    }
  });

  const endPointer = (e) => {
    if (state.isVideo) return;
    state.pointers.delete(e.pointerId);
    state.dragging = false;
    state.pinchDist = 0;
    lb.frame.classList.remove("cursor-grabbing");
  };
  lb.frame.addEventListener("pointerup", endPointer);
  lb.frame.addEventListener("pointercancel", endPointer);
  lb.frame.addEventListener("pointerleave", endPointer);

  document.addEventListener("keydown", (e) => {
    if (!state.open) return;
    switch (e.key) {
      case "Escape":
        closeLb();
        break;
      case "ArrowRight":
        setImage(1);
        break;
      case "ArrowLeft":
        setImage(-1);
        break;
      case "+":
      case "=":
        e.preventDefault();
        if (!state.isVideo) zoomAt(lb.frame.clientWidth / 2, lb.frame.clientHeight / 2, 1.25);
        break;
      case "-":
        e.preventDefault();
        if (!state.isVideo) zoomAt(lb.frame.clientWidth / 2, lb.frame.clientHeight / 2, 1 / 1.25);
        break;
      case "0":
        if (!state.isVideo) resetTransform();
        break;
      case "Home":
        state.index = 0;
        setImage(0);
        break;
      case "End":
        state.index = state.slides.length - 1;
        setImage(0);
        break;
    }
  });
</script>

