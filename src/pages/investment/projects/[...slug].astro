---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import VaultGate from "../../../components/VaultGate.astro";
import InvestmentProjectBody from "../../../components/investment/InvestmentProjectBody.astro";
import { experimental_AstroContainer as AstroContainer } from "astro/container";
import { getCollection } from "astro:content";
import { encryptWithPassword } from "../../../lib/vault";
import { getMatrixPassword } from "../../../lib/secrets";

export async function getStaticPaths() {
  const projects = await getCollection("investment-projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;

const matrixPassword = getMatrixPassword();

const container = await AstroContainer.create();
const body = await container.renderToString(InvestmentProjectBody, { props: { project } });
const vault = await encryptWithPassword(body, matrixPassword);
const passwordConfigured = Boolean(matrixPassword);
---

<BaseLayout searchable={false}
  title={data.title}
  description={data.description}
  image={data.images?.[0]}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24 pb-4">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path={`/investment/projects/${project.id}/`} class="mb-8" />
        <div class="max-w-3xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Investment</span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mt-3 mb-4">{data.title}</h1>
          <p class="text-muted text-lg leading-relaxed">
            Project details are restricted to founder and administration. Enter the admin password to unlock.
          </p>
        </div>
      </div>
    </section>

    <VaultGate
      vault={vault}
      passwordConfigured={passwordConfigured}
      title={data.title}
      cacheKey="nsf-admin"
      description="Investment project details are restricted to founder and administration. Enter the admin password to continue."
    />
  </div>
</BaseLayout>
