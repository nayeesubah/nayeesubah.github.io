---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import VaultGate from "../../components/VaultGate.astro";
import InvestmentProjectsBody from "../../components/investment/InvestmentProjectsBody.astro";
import { experimental_AstroContainer as AstroContainer } from "astro/container";
import { getCollection } from "astro:content";
import { encryptWithPassword } from "../../lib/vault";

const [settings] = await getCollection("site-settings");
const matrixPassword = settings?.data.matrixPassword || "";

const container = await AstroContainer.create();
const body = await container.renderToString(InvestmentProjectsBody);
const vault = await encryptWithPassword(body, matrixPassword);
const passwordConfigured = Boolean(matrixPassword);
---

<BaseLayout
  title="Investment Projects & Portfolio"
  description="Explore Nayee Subah Foundation's community investment portfolio — agriculture, renewable energy, micro-finance, and community development projects generating social impact."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24 pb-4">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/investment/projects/" class="mb-8" />
        <div class="max-w-3xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Investment</span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mt-3 mb-4">Project Portfolio</h1>
          <p class="text-muted text-lg leading-relaxed">
            Portfolio project details are restricted to founder and administration. Enter the admin password to unlock.
          </p>
        </div>
      </div>
    </section>

    <VaultGate
      vault={vault}
      passwordConfigured={passwordConfigured}
      title="Investment Projects"
      description="Portfolio project data is restricted to founder and administration. Enter the admin password to continue."
    />
  </div>
</BaseLayout>

<script>
  (globalThis as any).__initVaultContent = (plaintext: string) => {
    const target = document.getElementById("vault-content");
    if (target) target.innerHTML = plaintext;

    const buttons = document.querySelectorAll(".filter-btn");
    const items = document.querySelectorAll(".project-item");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.category;
        buttons.forEach((b) => {
          b.className = b.className
            .replace("bg-accent text-accent-text", "bg-accent-soft text-accent")
            .replace("bg-accent-soft text-accent", "bg-accent-soft text-accent");
        });
        btn.className = btn.className.replace("bg-accent-soft text-accent", "bg-accent text-accent-text");

        items.forEach((item) => {
          if (cat === "all" || item.dataset.category === cat) {
            item.style.display = "";
          } else {
            item.style.display = "none";
          }
        });
      });
    });
  };
</script>
