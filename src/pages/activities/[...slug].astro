---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ActivityCard from "../../components/ActivityCard.astro";
import { getCollection, render } from "astro:content";
import { activityCategoryLabel, activityCategoryIcon } from "../../lib/activityCategories";
import { localeSlug } from "../../lib/site";

export async function getStaticPaths() {
  const activities = (await getCollection("activities")).filter((a) => (a.data.lang ?? "en") === "en");
  return activities.map((activity) => ({
    params: { slug: localeSlug(activity.id) },
    props: { activity },
  }));
}

const { activity } = Astro.props;
const { data } = activity;
const slug = localeSlug(activity.id);
const { Content } = await render(activity);
const icon = activityCategoryIcon(data.category);

const allActivities = (await getCollection("activities")).filter((a) => a.id !== activity.id && (a.data.lang ?? "en") === "en");
const related = [
  ...allActivities.filter((a) => a.data.category === data.category),
  ...allActivities.filter((a) => a.data.category !== data.category),
].slice(0, 3);
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.image}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path={`/activities/${slug}/`} class="mb-8" />
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
          <div>
            <span class="text-accent font-semibold text-sm uppercase tracking-widest">
              {activityCategoryLabel(data.category)}
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">{data.title}</h1>
            <p class="text-muted text-lg leading-relaxed mb-8">{data.description}</p>

            {data.impactNumbers && Object.keys(data.impactNumbers).length > 0 && (
              <div class="grid grid-cols-2 gap-4 mb-8">
                {Object.entries(data.impactNumbers).map(([key, val]) => (
                  <div class="card p-4 text-center">
                    <div class="text-2xl font-black text-accent">{val}</div>
                    <div class="text-xs text-muted capitalize">{key}</div>
                  </div>
                ))}
              </div>
            )}

            <div class="flex flex-wrap gap-2 mb-8">
              {data.location && (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-soft px-3 py-1.5 text-sm text-body">
                  <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                  {data.location}
                </span>
              )}
              {data.date && (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-soft px-3 py-1.5 text-sm text-body">
                  <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
                  {data.date.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" })}
                </span>
              )}
              {data.volunteers > 0 && (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-soft px-3 py-1.5 text-sm text-body">
                  <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
                  {data.volunteers} Volunteers
                </span>
              )}
            </div>

            <a href="/donate/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-8 py-4 text-lg font-medium hover:bg-accent-hover transition-all duration-200">
              Support This Initiative
            </a>
          </div>

          <div class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-accent-soft">
            {data.image ? (
              <img
                src={data.image}
                alt={data.title}
                class="h-full w-full object-cover"
                loading="eager"
                transition:name={`activity-image-${activity.id}`}
              />
            ) : (
              <div
                class="h-full w-full flex items-center justify-center bg-[radial-gradient(circle_at_30%_20%,var(--color-accent-soft),var(--color-card)_70%)]"
                transition:name={`activity-image-${activity.id}`}
              >
                <svg class="h-24 w-24 text-accent/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
                </svg>
              </div>
            )}
          </div>
        </div>

        <div class="mt-16 prose prose-lg dark:prose-invert max-w-none">
          <Content />
        </div>

        {related.length > 0 && (
          <div class="mt-20 pt-16 border-t border-border">
            <div class="section-title text-left mb-10">
              <h2>More Ways We <span class="text-accent">Help</span></h2>
              <p>Explore other programs making a difference in Jharkhand.</p>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {related.map((r) => <ActivityCard activity={r} />)}
            </div>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
