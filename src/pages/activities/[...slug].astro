---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const activities = await getCollection("activities");
  return activities.map((activity) => ({
    params: { slug: activity.id },
    props: { activity },
  }));
}

const { activity } = Astro.props;
const { data } = activity;
const { Content } = await render(activity);

const categoryLabels: Record<string, string> = {
  education: "Education",
  healthcare: "Healthcare",
  "skill-development": "Skill Development",
  "women-empowerment": "Women Empowerment",
  "youth-development": "Youth Development",
  employment: "Employment Support",
  "disaster-relief": "Disaster Relief",
  "blood-donation": "Blood Donation",
  "tree-plantation": "Tree Plantation",
  scholarships: "Scholarships",
  "community-development": "Community Development",
  "food-distribution": "Food Distribution",
  "awareness-campaigns": "Awareness Campaigns",
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.image}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path={`/activities/${activity.id}/`} class="mb-8" />
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
          <div>
            <span class="text-accent font-semibold text-sm uppercase tracking-widest">
              {categoryLabels[data.category] || data.category}
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">{data.title}</h1>
            <p class="text-muted text-lg leading-relaxed mb-8">{data.description}</p>

            {data.impactNumbers && Object.keys(data.impactNumbers).length > 0 && (
              <div class="grid grid-cols-2 gap-4 mb-8">
                {Object.entries(data.impactNumbers).map(([key, val]) => (
                  <div class="card p-4 text-center">
                    <div class="text-2xl font-black text-accent">{val}</div>
                    <div class="text-xs text-muted capitalize">{key}</div>
                  </div>
                ))}
              </div>
            )}

            {data.location && (
              <div class="flex items-center gap-2 text-sm text-muted mb-4">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                {data.location}
              </div>
            )}
            {data.date && (
              <div class="flex items-center gap-2 text-sm text-muted mb-4">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
                {data.date.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" })}
              </div>
            )}
            {data.volunteers > 0 && (
              <div class="flex items-center gap-2 text-sm text-muted mb-4">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
                {data.volunteers} Volunteers
              </div>
            )}

            <a href="/donate/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200 text-lg px-8 py-4 mt-6">
              Support This Initiative
            </a>
          </div>

          <div class="aspect-[4/3] rounded-2xl overflow-hidden">
            <img src={data.image || "/images/service-default.jpg"} alt={data.title} class="h-full w-full object-cover" loading="lazy" />
          </div>
        </div>

        <div class="mt-16 prose prose-lg dark:prose-invert max-w-none">
          <Content />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
