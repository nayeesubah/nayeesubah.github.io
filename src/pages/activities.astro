---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ActivityCard from "../components/ActivityCard.astro";
import StatCard from "../components/StatCard.astro";
import { getCollection } from "astro:content";
import { ACTIVITY_CATEGORIES, activityCategoryLabel } from "../lib/activityCategories";
import { defaultLang } from "../i18n/ui";
import { filterByLocale } from "../lib/site";

const locale = Astro.currentLocale || defaultLang;
const activities = filterByLocale(await getCollection("activities"), locale)
  .sort((a, b) => a.data.order - b.data.order);

// Only offer filters for categories that actually have a program — clicking a
// filter should never land on an empty grid.
const presentCategoryIds = new Set(activities.map((a) => a.data.category));
const categories = ACTIVITY_CATEGORIES.filter((c) => presentCategoryIds.has(c.id));

const totalVolunteers = activities.reduce((sum, a) => sum + (a.data.volunteers || 0), 0);
const totalLocations = new Set(activities.map((a) => a.data.location).filter(Boolean)).size;
---

<BaseLayout
  title="NGO Programs & Activities — Education, Healthcare, Skill Development"
  description="Explore Nayee Subah Foundation's NGO programs and activities in Jharkhand — education, healthcare, skill development, women empowerment, and community development initiatives."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/activities/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Our Work</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Our <span class="text-accent">Activities</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Explore the various initiatives and programs we run to create positive change in communities.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 mb-12">
          <StatCard value={String(activities.length)} label="Active Programs" />
          <StatCard value={`${totalVolunteers}+`} label="Volunteers Involved" />
          <StatCard value={String(categories.length)} label="Focus Areas" />
          <StatCard value={String(totalLocations)} label="Locations Served" />
        </div>

        <div class="flex flex-wrap gap-2 mb-8" id="category-filters">
          <button type="button" class="filter-btn is-active px-4 py-2 rounded-lg text-sm font-medium bg-accent text-accent-text transition-colors" data-category="all">All</button>
          {categories.map((cat) => (
            <button type="button" class="filter-btn px-4 py-2 rounded-lg text-sm font-medium bg-accent-soft text-accent hover:bg-accent hover:text-accent-text transition-colors" data-category={cat.id}>
              {activityCategoryLabel(cat.id, locale)}
            </button>
          ))}
        </div>

        <p id="results-count" class="text-sm text-muted mb-6" aria-live="polite"></p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="activities-grid">
          {activities.map((activity) => (
            <div class="activity-item transition-all duration-300 ease-out" data-category={activity.data.category}>
              <ActivityCard activity={activity} />
            </div>
          ))}
        </div>

        <div id="empty-state" class="hidden text-center py-20">
          <div class="text-5xl mb-4">🔍</div>
          <h3 class="text-xl font-semibold mb-2">No activities in this category yet</h3>
          <p class="text-muted">Check back soon, or explore another focus area above.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function boot() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const items = document.querySelectorAll<HTMLElement>(".activity-item");
    const resultsCount = document.getElementById("results-count");
    const emptyState = document.getElementById("empty-state");
    const grid = document.getElementById("activities-grid");
    if (!buttons.length || buttons[0].dataset.wired) return;

    function applyFilter(cat: string) {
      let visible = 0;
      items.forEach((item) => {
        const match = cat === "all" || item.dataset.category === cat;
        if (match) visible++;
        if (match) {
          item.classList.remove("hidden");
          requestAnimationFrame(() => item.classList.remove("opacity-0", "scale-95"));
        } else {
          item.classList.add("opacity-0", "scale-95");
          window.setTimeout(() => item.classList.add("hidden"), 250);
        }
      });

      if (resultsCount) {
        resultsCount.textContent = cat === "all"
          ? `Showing all ${items.length} activities`
          : `Showing ${visible} of ${items.length} activities`;
      }
      grid?.classList.toggle("hidden", visible === 0);
      emptyState?.classList.toggle("hidden", visible !== 0);
    }

    buttons.forEach((btn) => {
      btn.dataset.wired = "1";
      btn.addEventListener("click", () => {
        buttons.forEach((b) => {
          b.classList.remove("is-active", "bg-accent", "text-accent-text");
          b.classList.add("bg-accent-soft", "text-accent");
        });
        btn.classList.add("is-active", "bg-accent", "text-accent-text");
        btn.classList.remove("bg-accent-soft", "text-accent");
        applyFilter(btn.dataset.category || "all");
      });
    });

    applyFilter("all");
  }

  document.addEventListener("DOMContentLoaded", boot);
  document.addEventListener("astro:page-load", boot);
</script>
