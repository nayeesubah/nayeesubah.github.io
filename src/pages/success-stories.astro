---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";
import { defaultLang } from "../i18n/ui";
import { filterByLocale } from "../lib/site";

const locale = Astro.currentLocale || defaultLang;
const stories = filterByLocale((await getCollection("success-stories")).filter((s) => s.data.featured), locale)
  .sort((a, b) => (a.data.name > b.data.name ? 1 : -1));
---

<BaseLayout
  title="Success Stories — Real Impact in Rural Communities"
  description="Read inspiring success stories of individuals and communities transformed by Nayee Subah Foundation's education, healthcare, and livelihood programs in rural India."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/success-stories/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Stories</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Success <span class="text-accent">Stories</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Real stories of hope, transformation, and community impact.
          </p>
        </div>

        {stories.length === 0 && (
          <div class="text-center py-20">
            <div class="text-6xl mb-4">🌟</div>
            <h3 class="text-xl font-semibold mb-2">Coming Soon</h3>
            <p class="text-muted">Success stories are being compiled. Check back soon.</p>
          </div>
        )}

        <div class="grid md:grid-cols-2 gap-8">
          {stories.map((story) => (
            <div class="card overflow-hidden">
              {story.data.images && story.data.images.length > 0 && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img src={story.data.images[0]} alt={story.data.name} class="h-full w-full object-cover" loading="lazy" />
                </div>
              )}
              <div class="p-6">
                <h3 class="text-xl font-bold mb-1">{story.data.name}</h3>
                {story.data.location && <p class="text-accent text-sm font-medium mb-3">{story.data.location}</p>}
                {story.data.challenges && (
                  <div class="mb-3">
                    <p class="text-xs uppercase tracking-widest text-muted font-semibold mb-1">Challenges</p>
                    <p class="text-sm text-muted">{story.data.challenges}</p>
                  </div>
                )}
                <div class="mb-3">
                  <p class="text-xs uppercase tracking-widest text-muted font-semibold mb-1">How NSF Helped</p>
                  <p class="text-sm text-muted">{story.data.help}</p>
                </div>
                {story.data.status && (
                  <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-success/10 text-success text-xs font-medium">
                    <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
                    {story.data.status}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
