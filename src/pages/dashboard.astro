---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { getCollection } from "astro:content";
import { formatINR, MONTHS } from "../lib/site";

const [members, payments, incomeEntries, expenseEntries, donorEntries, projects, eventEntries, blogPosts] = await Promise.all([
  getCollection("members"),
  getCollection("payments"),
  getCollection("income"),
  getCollection("expenses"),
  getCollection("donors"),
  getCollection("investment-projects"),
  getCollection("events"),
  getCollection("blog"),
]);

// --- Reporting year: latest year with any financial data ---
const yearsPresent = new Set<number>();
incomeEntries.forEach((e) => yearsPresent.add(e.data.date.getFullYear()));
expenseEntries.forEach((e) => yearsPresent.add(e.data.date.getFullYear()));
donorEntries.forEach((d) => yearsPresent.add(d.data.date.getFullYear()));
payments.forEach((p) => yearsPresent.add(p.data.year));
const reportYear = Math.max(...yearsPresent);
const paymentYear = Math.max(...payments.map((p) => p.data.year));

// --- Income sources for reporting year ---
const membershipIncome = payments.filter((p) => p.data.year === reportYear).reduce((s, p) => s + p.data.amount, 0);
const yearDonors = donorEntries.filter((d) => d.data.date.getFullYear() === reportYear);
const donationIncome = yearDonors.reduce((s, d) => s + d.data.amount, 0);
const yearIncomeEntries = incomeEntries.filter((e) => e.data.date.getFullYear() === reportYear);
const manualIncome = yearIncomeEntries.reduce((s, e) => s + e.data.amount, 0);

const incomeSources = [
  { label: "Membership Collection", amount: membershipIncome },
  { label: "Donations", amount: donationIncome },
  { label: "Program & Other", amount: manualIncome },
].filter((i) => i.amount > 0).sort((a, b) => b.amount - a.amount);
const totalIncome = incomeSources.reduce((s, i) => s + i.amount, 0);

// --- Expenses for reporting year ---
const yearExpenses = expenseEntries.filter((e) => e.data.date.getFullYear() === reportYear);
const totalExpense = yearExpenses.reduce((s, e) => s + e.data.amount, 0);
const expenseByCat: Record<string, number> = {};
for (const e of yearExpenses) expenseByCat[e.data.category] = (expenseByCat[e.data.category] || 0) + e.data.amount;
const expenseSources = Object.entries(expenseByCat)
  .map(([label, amount]) => ({ label, amount }))
  .sort((a, b) => b.amount - a.amount);

const netSurplus = totalIncome - totalExpense;

// --- Membership collection health (latest payment year) ---
const activeMembers = members.filter((m) => m.data.membershipStatus === "active");
const yearPayments = payments.filter((p) => p.data.year === paymentYear);
const collected = yearPayments.reduce((s, p) => s + p.data.amount, 0);
const expected = activeMembers.reduce((s, m) => s + m.data.subscriptionAmount * 12, 0);
const collectionRate = expected > 0 ? Math.round((collected / expected) * 100) : 0;
const outstanding = Math.max(0, expected - collected);

const paidByMember = new Map<string, number>();
for (const p of yearPayments) {
  paidByMember.set(p.data.memberId, (paidByMember.get(p.data.memberId) || 0) + p.data.amount);
}
const pendingMembers = activeMembers
  .map((m) => {
    const paid = paidByMember.get(m.data.memberId) || 0;
    const due = m.data.subscriptionAmount * 12;
    return { name: m.data.name, memberId: m.data.memberId, paid, due, pending: Math.max(0, due - paid) };
  })
  .sort((a, b) => b.pending - a.pending)
  .slice(0, 5);
const membersPaidFull = activeMembers.filter((m) => (paidByMember.get(m.data.memberId) || 0) >= m.data.subscriptionAmount * 12).length;

// --- Investment portfolio ---
const totalInvested = projects.reduce((s, p) => s + p.data.investmentAmount, 0);
const totalCurrentValue = projects.reduce((s, p) => s + p.data.currentValue, 0);
const totalExpectedReturn = projects.reduce((s, p) => s + p.data.expectedReturn, 0);
const totalActualReturn = projects.reduce((s, p) => s + (p.data.actualReturn || 0), 0);
const portfolioGain = totalCurrentValue - totalInvested;

// --- Upcoming events ---
const upcomingEvents = eventEntries
  .filter((e) => e.data.status === "upcoming" || e.data.status === "ongoing")
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);

// --- Recent activity feed ---
type Activity = { date: Date; type: "payment" | "income" | "expense" | "donation"; title: string; amount: number };
const activity: Activity[] = [];
for (const p of payments) {
  activity.push({ date: p.data.date || new Date(p.data.year, p.data.month, 1), type: "payment", title: `${p.data.memberId} · ${MONTHS[p.data.month]} ${p.data.year}`, amount: p.data.amount });
}
for (const e of incomeEntries) {
  activity.push({ date: e.data.date, type: "income", title: e.data.description || e.data.category, amount: e.data.amount });
}
for (const e of expenseEntries) {
  activity.push({ date: e.data.date, type: "expense", title: e.data.description || e.data.category, amount: e.data.amount });
}
for (const d of donorEntries) {
  activity.push({ date: d.data.date, type: "donation", title: d.data.anonymous ? "Anonymous Donor" : d.data.name, amount: d.data.amount });
}
const recentActivity = activity.sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 8);

const activityMeta = {
  payment: { dot: "bg-success", label: "Payment" },
  income: { dot: "bg-accent", label: "Income" },
  expense: { dot: "bg-error", label: "Expense" },
  donation: { dot: "bg-warning", label: "Donation" },
};

// --- Content collection counts ---
const collectionCounts = [
  { name: "members", label: "Members", count: members.length },
  { name: "payments", label: "Payments", count: payments.length },
  { name: "donors", label: "Donors", count: donorEntries.length },
  { name: "income", label: "Income Entries", count: incomeEntries.length },
  { name: "expenses", label: "Expenses", count: expenseEntries.length },
  { name: "investment-projects", label: "Investments", count: projects.length },
  { name: "events", label: "Events", count: eventEntries.length },
  { name: "activities", label: "Activities", count: (await getCollection("activities")).length },
  { name: "blog", label: "Blog Posts", count: blogPosts.length },
  { name: "financial-reports", label: "Reports", count: (await getCollection("financial-reports")).length },
  { name: "gallery", label: "Gallery", count: (await getCollection("gallery")).length },
  { name: "team", label: "Team", count: (await getCollection("team")).length },
];
---

<BaseLayout
  title="NSF Operations Dashboard"
  description="Nayee Subah Foundation operations dashboard — financial overview, membership collection health, investment portfolio, and recent activity."
  noIndex
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/dashboard/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Admin</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Operations <span class="text-accent">Dashboard</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            A live operational view for FY {reportYear} — income, expenses, membership collection, and investments. Data is pulled from the CMS collections. <a href="/admin/" class="text-accent hover:underline">Manage via Sveltia CMS</a>.
          </p>
        </div>

        <!-- KPI cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-4 mb-12">
          <div class="card p-5 text-center bg-inverse text-inverted">
            <div class="text-2xl font-black text-accent">{formatINR(netSurplus)}</div>
            <div class="text-[11px] uppercase tracking-wider opacity-80 mt-1">Net Surplus FY{reportYear}</div>
          </div>
          <div class="card p-5 text-center">
            <div class="text-2xl font-black text-success">{formatINR(totalIncome)}</div>
            <div class="text-[11px] uppercase tracking-wider text-muted mt-1">Income FY{reportYear}</div>
          </div>
          <div class="card p-5 text-center">
            <div class="text-2xl font-black text-error">{formatINR(totalExpense)}</div>
            <div class="text-[11px] uppercase tracking-wider text-muted mt-1">Expenses FY{reportYear}</div>
          </div>
          <div class="card p-5 text-center">
            <div class="text-2xl font-black text-accent">{collectionRate}%</div>
            <div class="text-[11px] uppercase tracking-wider text-muted mt-1">Collection Rate {paymentYear}</div>
          </div>
          <div class="card p-5 text-center">
            <div class="text-2xl font-black text-warning">{formatINR(totalCurrentValue)}</div>
            <div class="text-[11px] uppercase tracking-wider text-muted mt-1">Portfolio Value</div>
          </div>
          <div class="card p-5 text-center">
            <div class="text-2xl font-black text-accent">{activeMembers.length}</div>
            <div class="text-[11px] uppercase tracking-wider text-muted mt-1">Active Members</div>
          </div>
        </div>

        <!-- Financial overview + collection health -->
        <div class="grid lg:grid-cols-2 gap-6 mb-12">
          <div class="card p-6 sm:p-8">
            <h2 class="text-xl font-semibold mb-6 flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-success"></span>
              Financial Overview — FY{reportYear}
            </h2>
            {incomeSources.length > 0 ? (
              <div class="space-y-4 mb-6">
                <div class="text-xs uppercase tracking-wider text-muted mb-2">Income Sources</div>
                {incomeSources.map((i) => {
                  const pct = Math.round((i.amount / totalIncome) * 100);
                  return (
                    <div>
                      <div class="flex items-center justify-between text-sm mb-1">
                        <span class="text-muted">{i.label}</span>
                        <span class="font-medium">{formatINR(i.amount)}</span>
                      </div>
                      <div class="h-2 rounded-full bg-section overflow-hidden">
                        <div class="h-full rounded-full bg-success" style={`width: ${pct}%`}></div>
                      </div>
                    </div>
                  );
                })}
                <div class="pt-3 border-t border-border flex items-center justify-between font-bold">
                  <span>Total Income</span>
                  <span class="text-success">{formatINR(totalIncome)}</span>
                </div>
              </div>
            ) : (
              <p class="text-muted text-sm py-4 text-center">No income recorded for FY{reportYear}.</p>
            )}

            {expenseSources.length > 0 && (
              <div class="space-y-4">
                <div class="text-xs uppercase tracking-wider text-muted mb-2">Expense Categories</div>
                {expenseSources.slice(0, 5).map((e) => {
                  const pct = Math.round((e.amount / totalExpense) * 100);
                  return (
                    <div>
                      <div class="flex items-center justify-between text-sm mb-1">
                        <span class="text-muted">{e.label}</span>
                        <span class="font-medium">{formatINR(e.amount)}</span>
                      </div>
                      <div class="h-2 rounded-full bg-section overflow-hidden">
                        <div class="h-full rounded-full bg-error/70" style={`width: ${pct}%`}></div>
                      </div>
                    </div>
                  );
                })}
                {expenseSources.length > 5 && (
                  <p class="text-xs text-muted">+{expenseSources.length - 5} more categories</p>
                )}
                <div class="pt-3 border-t border-border flex items-center justify-between font-bold">
                  <span>Total Expenses</span>
                  <span class="text-error">{formatINR(totalExpense)}</span>
                </div>
              </div>
            )}
            <a href="/transparency/" class="inline-flex items-center gap-1.5 text-sm text-accent hover:text-accent-hover font-medium mt-6">
              View full transparency report
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>

          <div class="card p-6 sm:p-8">
            <h2 class="text-xl font-semibold mb-6 flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-accent"></span>
              Membership Collection — {paymentYear}
            </h2>
            <div class="flex items-end justify-between mb-2">
              <div class="text-4xl font-black text-accent">{collectionRate}%</div>
              <div class="text-xs text-muted text-right">
                {formatINR(collected)} of {formatINR(expected)} collected
              </div>
            </div>
            <div class="h-3 rounded-full bg-section overflow-hidden mb-6">
              <div class={`h-full rounded-full ${collectionRate >= 75 ? "bg-success" : collectionRate >= 40 ? "bg-warning" : "bg-error"}`} style={`width: ${Math.min(100, collectionRate)}%`}></div>
            </div>
            <div class="grid grid-cols-3 gap-3 mb-6">
              <div class="p-3 rounded-xl bg-accent-soft/20 text-center">
                <div class="text-lg font-black text-accent">{membersPaidFull}</div>
                <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">Paid in Full</div>
              </div>
              <div class="p-3 rounded-xl bg-warning/10 text-center">
                <div class="text-lg font-black text-warning">{formatINR(outstanding)}</div>
                <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">Outstanding</div>
              </div>
              <div class="p-3 rounded-xl bg-accent-soft/20 text-center">
                <div class="text-lg font-black">{activeMembers.length}</div>
                <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">Active Members</div>
              </div>
            </div>
            {pendingMembers.length > 0 && (
              <div>
                <div class="text-xs uppercase tracking-wider text-muted mb-3">Top Pending Dues</div>
                <ul class="space-y-2">
                  {pendingMembers.map((m) => (
                    <li class="flex items-center justify-between gap-3 text-sm">
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                          <span class="font-medium truncate">{m.name}</span>
                          <span class="text-error shrink-0">{formatINR(m.pending)}</span>
                        </div>
                        <div class="h-1.5 rounded-full bg-section overflow-hidden mt-1">
                          <div class="h-full rounded-full bg-success" style={`width: ${m.due > 0 ? Math.round((m.paid / m.due) * 100) : 0}%`}></div>
                        </div>
                      </div>
                      <span class="text-xs text-muted font-mono shrink-0">{m.memberId}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <a href="/members/matrix/" class="inline-flex items-center gap-1.5 text-sm text-accent hover:text-accent-hover font-medium mt-6">
              Open contribution matrix
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>
        </div>

        <!-- Investment portfolio + upcoming events -->
        <div class="grid lg:grid-cols-2 gap-6 mb-12">
          <div class="card p-6 sm:p-8 border-2 border-dashed border-warning/40 bg-warning/[0.03]">
            <div class="flex items-center justify-between gap-2 mb-2">
              <h2 class="text-xl font-semibold flex items-center gap-2">
                <span class="h-3 w-3 rounded-full bg-warning"></span>
                Investment Department
              </h2>
              <span class="inline-flex items-center gap-1 rounded-full bg-warning/15 text-warning text-[10px] font-bold uppercase tracking-wider px-2.5 py-1">
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" /></svg>
                Experimental
              </span>
            </div>
            <p class="text-xs text-muted mb-6">
              Independent department of NSF — returns from investment projects are tracked separately from membership fees and donations, and are <span class="text-warning font-medium">not included</span> in the financial overview above.
            </p>
            <div class="grid grid-cols-2 gap-3 mb-6">
              <div class="p-3 rounded-xl bg-accent-soft/20">
                <div class="text-sm font-black">{formatINR(totalInvested)}</div>
                <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">Invested Capital</div>
              </div>
              <div class={`p-3 rounded-xl ${portfolioGain >= 0 ? "bg-success/10" : "bg-error/10"}`}>
                <div class={`text-sm font-black ${portfolioGain >= 0 ? "text-success" : "text-error"}`}>{formatINR(totalCurrentValue)}</div>
                <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">{portfolioGain >= 0 ? "Current Value" : "Current Value"}</div>
              </div>
              <div class="p-3 rounded-xl bg-accent-soft/20">
                <div class="text-sm font-black">{formatINR(totalActualReturn)}</div>
                <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">Returns Received</div>
              </div>
              <div class="p-3 rounded-xl bg-accent-soft/20">
                <div class="text-sm font-black">{formatINR(totalExpectedReturn)}</div>
                <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">Expected Return</div>
              </div>
            </div>
            <div>
              <div class="text-xs uppercase tracking-wider text-muted mb-3">Projects</div>
              <ul class="space-y-4">
                {projects.slice(0, 4).map((p) => (
                  <li>
                    <div class="flex items-center justify-between gap-2 text-sm mb-1">
                      <span class="font-medium truncate">{p.data.title}</span>
                      <span class="flex items-center gap-2 shrink-0">
                        <StatusBadge status={p.data.status} />
                        <span class="text-muted text-xs">{formatINR(p.data.investmentAmount)}</span>
                      </span>
                    </div>
                    <div class="h-1.5 rounded-full bg-section overflow-hidden">
                      <div class="h-full rounded-full bg-warning" style={`width: ${p.data.progress}%`}></div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
            <a href="/admin/#/collections/investment-projects" class="inline-flex items-center gap-1.5 text-sm text-accent hover:text-accent-hover font-medium mt-6">
              Manage investment projects
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>

          <div class="card p-6 sm:p-8">
            <h2 class="text-xl font-semibold mb-6 flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-info"></span>
              Upcoming Events
            </h2>
            {upcomingEvents.length > 0 ? (
              <ul class="space-y-3">
                {upcomingEvents.map((e) => (
                  <li class="flex items-start gap-4 p-3 rounded-xl bg-accent-soft/20">
                    <div class="shrink-0 h-14 w-14 rounded-xl bg-accent text-accent-text flex flex-col items-center justify-center">
                      <span class="text-lg font-black leading-none">{e.data.date.getDate()}</span>
                      <span class="text-[10px] uppercase tracking-wider opacity-90">{MONTHS[e.data.date.getMonth()].slice(0, 3)}</span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1">
                        <StatusBadge status={e.data.status} />
                      </div>
                      <p class="font-medium text-sm leading-snug">{e.data.title}</p>
                      <p class="text-xs text-muted mt-1 truncate">{e.data.venue}</p>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-muted text-sm py-8 text-center">No upcoming events scheduled.</p>
            )}
            <a href="/admin/#/collections/events" class="inline-flex items-center gap-1.5 text-sm text-accent hover:text-accent-hover font-medium mt-6">
              Manage events
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>
        </div>

        <!-- Recent activity -->
        <div class="card p-6 sm:p-8 mb-12">
          <h2 class="text-xl font-semibold mb-6 flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-accent"></span>
            Recent Activity
          </h2>
          {recentActivity.length > 0 ? (
            <ul class="divide-y divide-border/60">
              {recentActivity.map((a) => {
                const meta = activityMeta[a.type];
                return (
                  <li class="flex items-center gap-4 py-3">
                    <span class={`h-2.5 w-2.5 rounded-full shrink-0 ${meta.dot}`}></span>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-medium truncate">{a.title}</p>
                      <p class="text-xs text-muted">{meta.label}</p>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                      <span class={`text-sm font-bold ${a.type === "expense" ? "text-error" : "text-success"}`}>
                        {a.type === "expense" ? "−" : "+"}{formatINR(a.amount)}
                      </span>
                      <span class="text-xs text-muted w-16 text-right">{a.date.toLocaleDateString("en-IN", { day: "numeric", month: "short" })}</span>
                    </div>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="text-muted text-sm py-8 text-center">No financial activity recorded yet.</p>
          )}
        </div>

        <!-- Quick actions -->
        <div class="card p-6 mb-12">
          <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
            </svg>
            Quick Actions
          </h3>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <a href="/admin/#/collections/payments" class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors text-sm">
              <span class="h-8 w-8 rounded-lg bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">P</span>
              Record a Payment
            </a>
            <a href="/admin/#/collections/expenses" class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors text-sm">
              <span class="h-8 w-8 rounded-lg bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">E</span>
