          </div>
        </div>

        <!-- Content collection counts -->
        <div class="card p-6 mb-12">
          <h3 class="text-lg font-semibold mb-4">Content Collections</h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
            {collectionCounts.map((c) => (
              <a href={`/admin/#/collections/${c.name}`} class="flex items-center justify-between gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors">
                <span class="text-sm font-medium">{c.label}</span>
                <span class="text-lg font-black text-accent">{c.count}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3 text-sm text-muted">
            <svg class="h-5 w-5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            All figures are computed at build time from CMS collections. Changes take effect after commit and rebuild.
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
