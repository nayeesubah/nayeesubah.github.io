---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import EventCard from "../../components/EventCard.astro";
import { getCollection, render } from "astro:content";
import { buildGoogleCalendarUrl, icsDataUri, googleMapsSearchUrl } from "../../lib/calendar";
import { localeSlug } from "../../lib/site";

export async function getStaticPaths() {
  const events = (await getCollection("events")).filter((e) => (e.data.lang ?? "en") === "en");
  return events.map((event) => ({
    params: { slug: localeSlug(event.id) },
    props: { event },
  }));
}

const { event } = Astro.props;
const { data } = event;
const slug = localeSlug(event.id);
const { Content } = await render(event);

const statusConfig = {
  upcoming: { label: "Upcoming", class: "bg-accent/10 text-accent" },
  ongoing: { label: "Ongoing", class: "bg-info/10 text-info" },
  completed: { label: "Completed", class: "bg-muted/10 text-muted" },
  cancelled: { label: "Cancelled", class: "bg-error/10 text-error" },
} as const;

const cfg = statusConfig[data.status];
const CALENDAR_ICON = "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5";

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
}

const calendarInput = { id: event.id, title: data.title, description: data.description, location: data.venue, start: data.date };
const googleCalUrl = buildGoogleCalendarUrl(calendarInput);
const icsHref = icsDataUri(calendarInput);
const mapsUrl = googleMapsSearchUrl(data.venue);

const eventStatusSchema = data.status === "cancelled" ? "https://schema.org/EventCancelled" : "https://schema.org/EventScheduled";
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: data.title,
  startDate: data.date.toISOString(),
  eventStatus: eventStatusSchema,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: data.venue,
    address: data.venue,
  },
  description: data.description,
  ...(data.image ? { image: [new URL(data.image, Astro.site).href] } : {}),
  organizer: {
    "@type": "Organization",
    name: "Nayee Subah Foundation",
    url: "https://nayeesubah.github.io",
  },
};

const allEvents = (await getCollection("events")).filter((e) => e.id !== event.id && (e.data.lang ?? "en") === "en");
const related = [
  ...allEvents.filter((e) => e.data.status === "upcoming" || e.data.status === "ongoing"),
  ...allEvents.filter((e) => e.data.status !== "upcoming" && e.data.status !== "ongoing"),
].slice(0, 3);
---


<BaseLayout
  title={data.title}
  description={data.description}
  image={data.image}
  seo={{
    type: "article",
    publishedTime: data.date.toISOString(),
    breadcrumbs: [
      { label: "Events", href: "/events/" },
      { label: data.title, href: `/events/${slug}/` },
    ],
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path={`/events/${slug}/`} class="mb-8" />
        <article class="max-w-3xl mx-auto">
          <div class="relative aspect-[16/9] rounded-2xl overflow-hidden mb-8">
            {data.image ? (
              <img src={data.image} alt={data.title} class="h-full w-full object-cover" transition:name={`event-image-${event.id}`} />
            ) : (
              <div class="h-full w-full bg-linear-to-br from-accent-soft to-section flex items-center justify-center" transition:name={`event-image-${event.id}`}>
                <svg class="h-20 w-20 text-accent/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d={CALENDAR_ICON} /></svg>
              </div>
            )}
          </div>

          <div class="flex items-center gap-3 text-sm mb-4 flex-wrap">
            <span class={`px-3 py-1 rounded-full text-xs font-semibold ${cfg.class}`}>{cfg.label}</span>
            {data.featured && (
              <span class="px-3 py-1 rounded-full bg-warning/10 text-warning text-xs font-semibold">Featured</span>
            )}
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">{data.title}</h1>

          <div class="grid sm:grid-cols-2 gap-4 mb-8">
            <div class="flex items-start gap-3 p-4 rounded-xl bg-section border border-border">
              <svg class="h-5 w-5 mt-0.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={CALENDAR_ICON} /></svg>
              <div>
                <p class="text-xs text-muted">Date</p>
                <p class="text-sm font-semibold">{formatDate(data.date)}</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 rounded-xl bg-section border border-border">
              <svg class="h-5 w-5 mt-0.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
              <div class="min-w-0">
                <p class="text-xs text-muted">Venue</p>
                <p class="text-sm font-semibold truncate">{data.venue}</p>
                <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-accent hover:underline">View on map</a>
              </div>
            </div>
          </div>

          {data.organizers.length > 0 && (
            <div class="flex items-center gap-2 text-sm text-muted mb-8 flex-wrap">
              <span>Organized by:</span>
              {data.organizers.map((o) => (
                <span class="px-3 py-1 rounded-full bg-accent-soft text-accent text-xs font-medium">{o}</span>
              ))}
            </div>
          )}

          <div class="flex flex-wrap items-start gap-3 mb-10">
            {data.registerLink && (
              <a href={data.registerLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl bg-accent text-accent-text px-5 py-2.5 text-sm font-medium hover:bg-accent-hover transition-colors">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                Register Now
              </a>
            )}

            <details class="relative group/cal">
              <summary class="list-none inline-flex items-center gap-2 rounded-xl border-2 border-btn-secondary-border text-btn-secondary-text px-5 py-2.5 text-sm font-medium hover:bg-btn-secondary-hover-bg hover:text-btn-secondary-hover-text transition-all duration-200 cursor-pointer select-none">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={CALENDAR_ICON} /></svg>
                Add to Calendar
                <svg class="h-3.5 w-3.5 transition-transform group-open/cal:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
              </summary>
              <div class="absolute z-20 mt-2 w-56 rounded-xl border border-border bg-card shadow-lg overflow-hidden">
                <a href={googleCalUrl} target="_blank" rel="noopener noreferrer" class="block px-4 py-2.5 text-sm hover:bg-accent-soft transition-colors">Google Calendar</a>
                <a href={icsHref} download={`${slug}.ics`} class="block px-4 py-2.5 text-sm hover:bg-accent-soft transition-colors border-t border-border">Apple / Outlook (.ics)</a>
              </div>
            </details>

            <button id="share-event-btn" type="button" class="inline-flex items-center gap-2 rounded-xl border-2 border-btn-secondary-border text-btn-secondary-text px-5 py-2.5 text-sm font-medium hover:bg-btn-secondary-hover-bg hover:text-btn-secondary-hover-text transition-all duration-200">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" /></svg>
              Share Event
            </button>
          </div>

          <div class="prose prose-lg dark:prose-invert max-w-none">
            {data.description && <p class="text-lg text-muted mb-6">{data.description}</p>}
            <Content />
          </div>

          <div class="mt-10 pt-8 border-t border-border">
            <a href="/events/" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-btn-secondary-border text-btn-secondary-text px-6 py-3 font-medium hover:bg-btn-secondary-hover-bg hover:text-btn-secondary-hover-text transition-all duration-200">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
              View All Events
            </a>
          </div>
        </article>

        {related.length > 0 && (
          <div class="mt-20 pt-16 border-t border-border max-w-5xl mx-auto">
            <div class="section-title text-left mb-10">
              <h2>Other <span class="text-accent">Events</span></h2>
              <p>More from Nayee Subah Foundation.</p>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {related.map((r) => <EventCard event={r} />)}
            </div>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.getElementById("share-event-btn")?.addEventListener("click", async () => {
    const url = window.location.href;
    const title = document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {}
    } else {
      try {
        await navigator.clipboard.writeText(url);
        const btn = document.getElementById("share-event-btn") as HTMLButtonElement;
        const original = btn.innerHTML;
        btn.innerHTML = `<svg class="h-4 w-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg> Link copied!`;
        setTimeout(() => btn.innerHTML = original, 2000);
      } catch {}
    }
  });

  // Close the "Add to Calendar" popover on outside click.
  document.addEventListener("click", (e) => {
    document.querySelectorAll('details[open]').forEach((el) => {
      if (el.classList.contains("group/cal") && !el.contains(e.target as Node)) {
        el.removeAttribute("open");
      }
    });
  });
</script>
