---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import BlogCard from "../../../components/BlogCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => p.data.published);
  const tags = new Map<string, { tag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      const key = tag.toLowerCase().replace(/\s+/g, "-");
      if (!tags.has(key)) tags.set(key, { tag, posts: [] });
      tags.get(key)!.posts.push(post);
    }
  }
  return [...tags.entries()].map(([key, { tag, posts }]) => ({
    params: { tag: key },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props;
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title={`${tag} — Nayee Subah Foundation Blog`}
  description={`Articles tagged "${tag}" from Nayee Subah Foundation's education, healthcare, and community development programs.`}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/blog/" class="mb-8" />
        <div class="section-title text-left max-w-2xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Blog / Tag</span>
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mt-3 mb-6">
            #{tag}
          </h1>
          <p class="text-muted text-lg">
            {sorted.length} article{sorted.length === 1 ? "" : "s"} tagged with {tag}.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
          {sorted.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>

        <div class="mt-12">
          <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-accent-hover transition-colors">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
            Back to All Articles
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
