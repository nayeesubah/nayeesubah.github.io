---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";

const faqItems = (await getCollection("faq"))
  .sort((a, b) => a.data.order - b.data.order);

const categories = [...new Set(faqItems.map((f) => f.data.category))];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.data.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.data.answer,
    },
  })),
};
---

<BaseLayout
  title="FAQ — Membership, Donations & Volunteering"
  description="Find answers to common questions about Nayee Subah Foundation NGO — membership, donations, investment program, volunteering, activities, and financial transparency."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/faq/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">FAQ</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Frequently Asked <span class="text-accent">Questions</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Find answers to common questions about our foundation, membership, donations, and activities.
          </p>
        </div>

        <div class="grid lg:grid-cols-4 gap-8">
          <div class="lg:col-span-1">
            <nav class="flex lg:flex-col gap-2 flex-wrap">
              {categories.map((cat) => (
                <a href={`#${cat}`} class="px-4 py-2 rounded-lg text-sm font-medium bg-accent-soft text-accent hover:bg-accent hover:text-accent-text transition-colors capitalize">
                  {cat.replace("-", " ")}
                </a>
              ))}
            </nav>
          </div>

          <div class="lg:col-span-3 space-y-12">
            {categories.map((cat) => {
              const items = faqItems.filter((f) => f.data.category === cat);
              return (
                <div id={cat}>
                  <h2 class="text-2xl font-bold capitalize mb-6">{cat.replace("-", " ")}</h2>
                  <div class="space-y-4">
                    {items.map((item) => (
                      <details class="card group open:border-accent-border transition-all">
                        <summary class="flex items-center justify-between p-5 cursor-pointer list-none font-medium hover:text-accent transition-colors">
                          {item.data.question}
                          <svg class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                          </svg>
                        </summary>
                        <div class="px-5 pb-5 text-muted leading-relaxed text-sm">
                          {item.data.answer}
                        </div>
                      </details>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
