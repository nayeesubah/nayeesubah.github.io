---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => p.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = [...new Set(posts.map((p) => p.data.category))];
const featured = posts.filter((p) => p.data.featured);
const regular = posts.filter((p) => !p.data.featured);
const sorted = [...featured, ...regular];
---

<BaseLayout
  title="NGO News, Impact Stories & Updates — Nayee Subah Foundation Blog"
  description="Latest news, impact stories, and updates from Nayee Subah Foundation's education, healthcare, and community development programs in rural India."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/blog/" class="mb-8" />
        <div class="section-title text-left max-w-2xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Blog</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Latest <span class="text-accent">Articles</span>
          </h1>
          <p class="text-muted text-lg">
            Stay updated with our latest initiatives, impact stories, and community news.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 mb-10 items-start sm:items-center">
          <div class="relative flex-1 max-w-md">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            <input
              id="search-input"
              type="text"
              placeholder="Search articles..."
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-input-border bg-card text-body text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
            />
          </div>
          <div class="flex flex-wrap gap-2" id="category-filters">
            <button class="filter-btn px-4 py-2 rounded-lg text-sm font-medium bg-accent text-accent-text transition-colors" data-category="all">All</button>
            {categories.map((cat) => (
              <button class="filter-btn px-4 py-2 rounded-lg text-sm font-medium bg-accent-soft text-accent hover:bg-accent hover:text-accent-text transition-colors" data-category={cat.toLowerCase()}>
                {cat}
              </button>
            ))}
            <a href="/blog/tags/" class="px-4 py-2 rounded-lg text-sm font-medium bg-muted/10 text-muted hover:bg-accent-soft hover:text-accent transition-colors">
              Tags
            </a>
            <a href="/rss.xml" class="px-4 py-2 rounded-lg text-sm font-medium bg-muted/10 text-muted hover:bg-accent-soft hover:text-accent transition-colors flex items-center gap-1.5" aria-label="Subscribe to RSS feed">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a5.25 5.25 0 015.25 5.25v.75m-9-6A11.25 11.25 0 0114.25 15.75M6.75 16.5h.008v.008H6.75V16.5zM3 12a9 9 0 019 9M3 3a18 18 0 0118 18" /></svg>
              RSS
            </a>
          </div>
        </div>

        {posts.length > 0 ? (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
            {sorted.map((post) => (
              <div class="post-item" data-category={post.data.category.toLowerCase()}>
                <BlogCard post={post} />
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-20">
            <h3 class="text-xl font-semibold mb-2">No Articles Yet</h3>
            <p class="text-muted">Check back soon for new content.</p>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const searchParams = new URLSearchParams(window.location.search);
  const initialCat = searchParams.get("category") || "all";

  const buttons = document.querySelectorAll(".filter-btn");
  const items = document.querySelectorAll(".post-item");
  const searchInput = document.getElementById("search-input");

  function filterPosts() {
    const category = document.querySelector(".filter-btn.bg-accent.text-accent-text")?.dataset.category || "all";
    const query = (searchInput?.value || "").toLowerCase().trim();

    items.forEach((item) => {
      const matchCat = category === "all" || item.dataset.category === category;
      const matchSearch = !query || item.textContent.toLowerCase().includes(query);
      item.style.display = matchCat && matchSearch ? "" : "none";
    });
  }

  function setActive(category) {
    buttons.forEach((b) => {
      const isActive = b.dataset.category === category;
      b.className = isActive
        ? "filter-btn px-4 py-2 rounded-lg text-sm font-medium bg-accent text-accent-text transition-colors"
        : "filter-btn px-4 py-2 rounded-lg text-sm font-medium bg-accent-soft text-accent hover:bg-accent hover:text-accent-text transition-colors";
    });
    filterPosts();
  }

  setActive(initialCat);

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => setActive(btn.dataset.category));
  });

  searchInput?.addEventListener("input", filterPosts);
</script>
