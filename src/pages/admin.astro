---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";
import { formatINR } from "../lib/site";

const collections = [
  { name: "members", label: "Members", icon: "M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" },
  { name: "activities", label: "Activities", icon: "M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" },
  { name: "events", label: "Events", icon: "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" },
  { name: "blog", label: "Blog Posts", icon: "M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" },
  { name: "team", label: "Team Members", icon: "M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" },
  { name: "testimonials", label: "Testimonials", icon: "M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" },
  { name: "faq", label: "FAQ", icon: "M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" },
  { name: "gallery", label: "Gallery", icon: "M2.25 15.75l5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 0 1 3.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Z" },
  { name: "partners", label: "Partners", icon: "M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" },
  { name: "volunteers", label: "Volunteers", icon: "M6 4.5h16.5M6 9.75h16.5M6 15h16.5M6 20.25h16.5M3 4.5h.008v.008H3V4.5Zm0 5.25h.008v.008H3V9.75Zm0 5.25h.008v.008H3V15Zm0 5.25h.008v.008H3v-.008Z" },
  { name: "success-stories", label: "Success Stories", icon: "M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" },
  { name: "investment-projects", label: "Investment Projects", icon: "M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" },
  { name: "financial-reports", label: "Financial Reports", icon: "M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" },
  { name: "donors", label: "Donors", icon: "M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" },
  { name: "income", label: "Income (Manual)", icon: "M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" },
  { name: "expenses", label: "Expenses", icon: "M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 21.75h16.5A2.25 2.25 0 0 0 22.5 19.5v-15a2.25 2.25 0 0 0-2.25-2.25H3.75A2.25 2.25 0 0 0 1.5 4.5v15a2.25 2.25 0 0 0 2.25 2.25Z" },
  { name: "payments", label: "Payments", icon: "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" },
  { name: "pages", label: "CMS Pages", icon: "M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582" },
];

const counts = await Promise.all(
  collections.map(async (c) => ({
    ...c,
    count: (await getCollection(c.name as any)).length,
  }))
);

const totalEntries = counts.reduce((sum, c) => sum + c.count, 0);
const featuredEntries = (await getCollection("blog")).filter((p) => p.data.featured && p.data.published).length;
const upcomingEvents = (await getCollection("events")).filter((e) => e.data.status === "upcoming").length;
const activeMembers = (await getCollection("members")).filter((m) => m.data.membershipStatus === "active").length;
const activeVolunteers = (await getCollection("volunteers")).filter((v) => v.data.active).length;
---

<BaseLayout
  title="Admin Dashboard"
  description="Nayee Subah Foundation content management dashboard."
  noIndex
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/admin/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Admin</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Content <span class="text-accent">Dashboard</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Overview of all content collections. Manage content through <a href="/admin/" class="text-accent hover:underline">Sveltia CMS</a> or directly in <code class="text-accent font-mono">src/content/</code>.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-12">
          <div class="card p-5 text-center bg-accent text-accent-text">
            <div class="text-3xl font-black">{totalEntries}</div>
            <div class="text-xs uppercase tracking-wider opacity-80 mt-1">Total Entries</div>
          </div>
          <div class="card p-5 text-center">
            <div class="text-3xl font-black text-success">{activeMembers}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Active Members</div>
          </div>
          <div class="card p-5 text-center">
            <div class="text-3xl font-black text-info">{activeVolunteers}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Active Volunteers</div>
          </div>
          <div class="card p-5 text-center">
            <div class="text-3xl font-black text-warning">{upcomingEvents}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Upcoming Events</div>
          </div>
          <div class="card p-5 text-center">
            <div class="text-3xl font-black text-accent">{featuredEntries}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Featured Stories</div>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {counts.map((c) => (
            <div class="card p-5 flex items-center gap-4 hover:shadow-lg transition-shadow duration-200">
              <div class="h-10 w-10 shrink-0 rounded-xl bg-accent-soft text-accent flex items-center justify-center">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={c.icon} /></svg>
              </div>
              <div class="min-w-0 flex-1">
                <div class="text-sm font-medium truncate">{c.label}</div>
                <div class="text-2xl font-black">{c.count}</div>
              </div>
            </div>
          ))}
        </div>

        <div class="card p-6 mt-12">
          <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
            </svg>
            Quick Actions
          </h3>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <a href="/admin/#/collections/payments" class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors text-sm">
              <span class="h-8 w-8 rounded-lg bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">P</span>
              Record a Payment
            </a>
            <a href="/admin/#/collections/expenses" class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors text-sm">
              <span class="h-8 w-8 rounded-lg bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">E</span>
              Add an Expense
            </a>
            <a href="/admin/#/collections/income" class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors text-sm">
              <span class="h-8 w-8 rounded-lg bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">I</span>
              Record Income
            </a>
            <a href="/admin/#/collections/members" class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors text-sm">
              <span class="h-8 w-8 rounded-lg bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">M</span>
              Add a Member
            </a>
            <a href="/admin/#/collections/donors" class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors text-sm">
              <span class="h-8 w-8 rounded-lg bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">D</span>
              Add a Donor
            </a>
            <a href="/members/matrix/" class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors text-sm">
              <span class="h-8 w-8 rounded-lg bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">M</span>
              Payment Matrix
            </a>
            <a href="/transparency/" class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors text-sm">
              <span class="h-8 w-8 rounded-lg bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">T</span>
              Transparency Page
            </a>
            <a href="/admin/#/collections/blog" class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20 hover:bg-accent-soft/40 transition-colors text-sm">
              <span class="h-8 w-8 rounded-lg bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">B</span>
              Write a Blog Post
            </a>
          </div>
        </div>

        <div class="card p-6 mt-6">
          <div class="flex items-center gap-3 text-sm text-muted">
            <svg class="h-5 w-5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            Content is managed via markdown files in <code class="text-accent font-mono">src/content/</code>. Changes are loaded at build time after commit.
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
