---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getSiteSettings } from "../../lib/site";


const locale = "ur" as const;

const copy = {
  hi: {
    title: "संपर्क करें — गिरिडीह, झारखंड में एनजीओ",
    description: "गिरिडीह, झारखंड में नयी सुबह फाउंडेशन एनजीओ से संपर्क करें। सदस्यता, दान, स्वयंसेवा, साझेदारी या हमारे सामुदायिक कार्यक्रमों से जुड़े किसी भी प्रश्न के लिए संपर्क करें।",
    badge: "संपर्क",
    heading: "हमसे",
    headingAccent: "जुड़ें",
    intro: "हमें आपसे सुनकर खुशी होगी। चाहे आप सदस्यता में रुचि रखते हों, दान करना चाहते हों, स्वयंसेवा करना चाहते हों, या कोई प्रश्न हो — हमारी टीम मदद के लिए तैयार है।",
    address: "पता",
    phone: "फ़ोन",
    email: "ईमेल",
    workingHours: "कार्य समय",
    whatsapp: "व्हाट्सएप",
    whatsappChat: "व्हाट्सएप पर चैट करें",
    formTitle: "हमें संदेश भेजें",
    fullName: "पूरा नाम",
    fullNamePh: "आपका नाम",
    emailPh: "your@email.com",
    phoneLabel: "फ़ोन",
    subject: "विषय",
    subjectSelect: "विषय चुनें",
    subjectMembership: "सदस्यता",
    subjectDonation: "दान",
    subjectVolunteer: "स्वयंसेवा",
    subjectInvestment: "निवेश कार्यक्रम",
    subjectGeneral: "सामान्य प्रश्न",
    message: "संदेश",
    messagePh: "हम आपकी कैसे मदद कर सकते हैं?",
    send: "संदेश भेजें",
    waTitle: "नयी सुबह फाउंडेशन वेबसाइट से नई पूछताछ",
    waName: "नाम",
    waEmail: "ईमेल",
    waPhone: "फ़ोन",
    waSubject: "विषय",
    waGeneral: "सामान्य",
    waMessage: "संदेश",
  },
  ur: {
    title: "ہم سے رابطہ کریں — گریڈیہ، جھارکھنڈ میں این جی او",
    description: "گریڈیہ، جھارکھنڈ میں نئی صبح فاؤنڈیشن این جی او سے رابطہ کریں۔ رکنیت، عطیات، رضاکارانہ خدمات، شراکت داری یا ہمارے کمیونٹی پروگراموں کے بارے میں کسی بھی سوال کے لیے رابطہ کریں۔",
    badge: "رابطہ",
    heading: "ہم سے",
    headingAccent: "رابطہ کریں",
    intro: "ہمیں آپ سے سن کر خوشی ہوگی۔ چاہے آپ رکنیت میں دلچسپی رکھتے ہوں، عطیہ دینا چاہتے ہوں، رضاکارانہ خدمات انجام دینا چاہتے ہوں، یا کوئی سوال ہو — ہماری ٹیم مدد کے لیے تیار ہے۔",
    address: "پتہ",
    phone: "فون",
    email: "ای میل",
    workingHours: "اوقاتِ کار",
    whatsapp: "واٹس ایپ",
    whatsappChat: "واٹس ایپ پر بات کریں",
    formTitle: "ہمیں پیغام بھیجیں",
    fullName: "پورا نام",
    fullNamePh: "آپ کا نام",
    emailPh: "your@email.com",
    phoneLabel: "فون",
    subject: "موضوع",
    subjectSelect: "موضوع منتخب کریں",
    subjectMembership: "رکنیت",
    subjectDonation: "عطیہ",
    subjectVolunteer: "رضاکارانہ خدمات",
    subjectInvestment: "سرمایہ کاری پروگرام",
    subjectGeneral: "عمومی سوال",
    message: "پیغام",
    messagePh: "ہم آپ کی کس طرح مدد کر سکتے ہیں؟",
    send: "پیغام بھیجیں",
    waTitle: "نئی صبح فاؤنڈیشن ویب سائٹ سے نئی انکوائری",
    waName: "نام",
    waEmail: "ای میل",
    waPhone: "فون",
    waSubject: "موضوع",
    waGeneral: "عمومی",
    waMessage: "پیغام",
  },
}[locale];

const settings = await getSiteSettings();
const phoneClean = (p: string) => p.replace(/[^0-9]/g, "");
const phoneDisplay = (p: string) => phoneClean(p).replace(/(\d{4})(\d{4})(\d+)?/, (_, a, b, c) => c ? `${a} ${b} ${c}` : `${a} ${b}`);
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/contact/" class="mb-8" />
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
          <div>
            <span class="text-accent font-semibold text-sm uppercase tracking-widest">{copy.badge}</span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
              {copy.heading} <span class="text-accent">{copy.headingAccent}</span>
            </h1>
            <p class="text-muted text-lg leading-relaxed mb-10">
              {copy.intro}
            </p>

            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="h-12 w-12 rounded-xl bg-accent-soft flex items-center justify-center shrink-0">
                  <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
                </div>
                <div>
                  <h3 class="font-semibold">{copy.address}</h3>
                  <p class="text-muted mt-1">{settings.address}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="h-12 w-12 rounded-xl bg-accent-soft flex items-center justify-center shrink-0">
                  <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg>
                </div>
                <div>
                  <h3 class="font-semibold">{copy.phone}</h3>
                  <p class="text-muted mt-1">
                    {settings.phone.map((p) => (
                      <a href={`tel:${phoneClean(p)}`} class="block hover:text-accent">{phoneDisplay(p)}</a>
                    ))}
                  </p>
                </div>
              </div>

              {settings.email && (
              <div class="flex items-start gap-4">
                <div class="h-12 w-12 rounded-xl bg-accent-soft flex items-center justify-center shrink-0">
                  <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>
                </div>
                <div>
                  <h3 class="font-semibold">{copy.email}</h3>
                  <a href={`mailto:${settings.email}`} class="text-muted mt-1 block hover:text-accent">{settings.email}</a>
                </div>
              </div>
              )}

              <div class="flex items-start gap-4">
                <div class="h-12 w-12 rounded-xl bg-accent-soft flex items-center justify-center shrink-0">
                  <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                </div>
                <div>
                  <h3 class="font-semibold">{copy.workingHours}</h3>
                  <p class="text-muted mt-1">{settings.workingHours}</p>
                </div>
              </div>

              {settings.social?.whatsapp && (
              <div class="flex items-start gap-4">
                <div class="h-12 w-12 rounded-xl bg-accent-soft flex items-center justify-center shrink-0">
                  <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155"/></svg>
                </div>
                <div>
                  <h3 class="font-semibold">{copy.whatsapp}</h3>
                  <a href={`https://wa.me/${phoneClean(settings.social.whatsapp)}`} target="_blank" rel="noopener noreferrer" class="text-muted mt-1 block hover:text-accent">
                    {copy.whatsappChat}
                  </a>
                </div>
              </div>
              )}
            </div>
          </div>

          <div class="card p-6 sm:p-8">
            <h2 class="text-2xl font-semibold mb-6">{copy.formTitle}</h2>
            <form id="contact-form" class="space-y-5">
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-sm font-medium mb-2">{copy.fullName}</label>
                  <input type="text" id="name" name="name" required class="w-full rounded-xl border border-accent-border/20 bg-transparent px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors" placeholder={copy.fullNamePh} />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium mb-2">{copy.email}</label>
                  <input type="email" id="email" name="email" required class="w-full rounded-xl border border-accent-border/20 bg-transparent px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors" placeholder={copy.emailPh} />
                </div>
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium mb-2">{copy.phoneLabel}</label>
                <input type="tel" id="phone" name="phone" class="w-full rounded-xl border border-accent-border/20 bg-transparent px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors" placeholder="+91 ..." />
              </div>
              <div>
                <label for="subject" class="block text-sm font-medium mb-2">{copy.subject}</label>
                <select id="subject" name="subject" class="w-full rounded-xl border border-accent-border/20 bg-transparent px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors">
                  <option value="">{copy.subjectSelect}</option>
                  <option value="membership">{copy.subjectMembership}</option>
                  <option value="donation">{copy.subjectDonation}</option>
                  <option value="volunteer">{copy.subjectVolunteer}</option>
                  <option value="investment">{copy.subjectInvestment}</option>
                  <option value="general">{copy.subjectGeneral}</option>
                </select>
              </div>
              <div>
                <label for="message" class="block text-sm font-medium mb-2">{copy.message}</label>
                <textarea id="message" name="message" rows="5" required class="w-full rounded-xl border border-accent-border/20 bg-transparent px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors resize-none" placeholder={copy.messagePh}></textarea>
              </div>
              <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200 w-full py-4">
                {copy.send}
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.126A59.768 59.768 0 0 1 21.485 12 59.77 59.77 0 0 1 3.27 20.876L5.999 12Zm0 0h7.5" /></svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="h-[450px] w-full bg-muted/10">
        <iframe src={settings.googleMapsEmbedUrl} width="100%" height="100%" style="border: 0" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Nayee Subah Foundation Location"></iframe>
      </div>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ whatsappNumber: phoneClean(settings.social?.whatsapp ?? settings.phone[0]), waTitle: copy.waTitle, waName: copy.waName, waEmail: copy.waEmail, waPhone: copy.waPhone, waSubject: copy.waSubject, waGeneral: copy.waGeneral, waMessage: copy.waMessage }}>
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const name = form.querySelector("#name").value.trim();
    const email = form.querySelector("#email").value.trim();
    const phone = form.querySelector("#phone").value.trim();
    const subject = form.querySelector("#subject").value;
    const message = form.querySelector("#message").value.trim();

    const text = [
      `*${waTitle}*`,
      ``,
      `*${waName}:* ${name}`,
      `*${waEmail}:* ${email}`,
      `*${waPhone}:* ${phone}`,
      `*${waSubject}:* ${subject || waGeneral}`,
      ``,
      `*${waMessage}:*`,
      `${message}`,
    ].join("\n");

    const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
    window.open(url, "_blank", "noopener,noreferrer");
  });
</script>
