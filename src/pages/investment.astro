---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import VaultGate from "../components/VaultGate.astro";
import InvestmentLandingBody from "../components/investment/InvestmentLandingBody.astro";
import { experimental_AstroContainer as AstroContainer } from "astro/container";
import { getCollection } from "astro:content";
import { encryptWithPassword } from "../lib/vault";

const [settings] = await getCollection("site-settings");
const matrixPassword = settings?.data.matrixPassword || "";

const container = await AstroContainer.create();
const body = await container.renderToString(InvestmentLandingBody);
const vault = await encryptWithPassword(body, matrixPassword);
const passwordConfigured = Boolean(matrixPassword);
---

<BaseLayout
  title="Investment Program — Fund Community Development"
  description="Nayee Subah Foundation's Investment Program lets you invest in community projects that generate sustainable income while supporting rural development and social welfare in India."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24 pb-4">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/investment/" class="mb-8" />
        <div class="max-w-3xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Investment Program</span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mt-3 mb-4">Portfolio Access</h1>
          <p class="text-muted text-lg leading-relaxed">
            Detailed investment portfolio information is restricted to founder and administration. Enter the admin password to unlock.
          </p>
        </div>
      </div>
    </section>

    <VaultGate
      vault={vault}
      passwordConfigured={passwordConfigured}
      title="Investment Portfolio"
      description="Portfolio performance, allocations, and project details are restricted to founder and administration. Enter the admin password to continue."
    />
  </div>
</BaseLayout>
