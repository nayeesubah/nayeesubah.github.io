---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getCollection } from "astro:content";
import { formatINR } from "../lib/site";

// --- Reporting year: latest year with any financial data ---
const expensesAll = await getCollection("expenses");
const payments = await getCollection("payments");
const incomeEntriesAll = await getCollection("income");
const donorsAll = (await getCollection("donors")).map((d) => d.data);
const projects = await getCollection("investment-projects");

const yearsPresent = new Set<number>();
expensesAll.forEach((e) => yearsPresent.add(e.data.date.getFullYear()));
incomeEntriesAll.forEach((e) => yearsPresent.add(e.data.date.getFullYear()));
donorsAll.forEach((d) => yearsPresent.add(d.date.getFullYear()));
payments.forEach((p) => yearsPresent.add(p.data.year));
const selectedYear = Math.max(...yearsPresent);

// --- Expenses ---
const expenses = expensesAll
  .map((e) => ({ ...e.data, id: e.id }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const yearExpenses = expenses.filter((e) => e.date.getFullYear() === selectedYear);

const expenseByCategory: Record<string, number> = {};
for (const e of yearExpenses) {
  expenseByCategory[e.category] = (expenseByCategory[e.category] || 0) + e.amount;
}
const expenseItems = Object.entries(expenseByCategory)
  .map(([category, amount]) => ({ category, amount }))
  .sort((a, b) => b.amount - a.amount);

const totalExpense = yearExpenses.reduce((s, e) => s + e.amount, 0);

// --- Income Sources ---

// 1. Membership collection from actual payments
const membershipIncome = payments
  .filter((p) => p.data.year === selectedYear)
  .reduce((s, p) => s + p.data.amount, 0);

// 2. Investment income from investment projects (tracked separately — independent department)
const investmentIncome = projects.reduce((s, p) => s + (p.data.actualReturn || 0), 0);
const totalInvested = projects.reduce((s, p) => s + p.data.investmentAmount, 0);
const totalCurrentValue = projects.reduce((s, p) => s + p.data.currentValue, 0);
const totalExpectedReturn = projects.reduce((s, p) => s + p.data.expectedReturn, 0);

// 3. Donations from donors
const donors = donorsAll.filter((d) => d.date.getFullYear() === selectedYear);
const donationIncome = donors.reduce((s, d) => s + d.amount, 0);

// 4. Manual income entries (program revenue, other, grants)
const incomeEntries = incomeEntriesAll
  .map((e) => ({ ...e.data, id: e.id }))
  .filter((e) => e.date.getFullYear() === selectedYear);

const incomeByCategory: Record<string, number> = {};
for (const e of incomeEntries) {
  incomeByCategory[e.category] = (incomeByCategory[e.category] || 0) + e.amount;
}

const incomeItems = [
  { category: "Membership Collection", amount: membershipIncome, source: "payments" },
  { category: "Donations & Grants", amount: donationIncome, source: "donors" },
  ...Object.entries(incomeByCategory).map(([category, amount]) => ({
    category,
    amount,
    source: "manual" as const,
  })),
].filter((i) => i.amount > 0).sort((a, b) => b.amount - a.amount);

const totalIncome = incomeItems.reduce((s, i) => s + i.amount, 0);
const netSurplus = totalIncome - totalExpense;
const manualIncomeTotal = incomeEntries.reduce((s, e) => s + e.amount, 0);

const reportsSections = [
  { title: "Yearly Financial Reports", description: "Comprehensive annual financial statements and breakdowns." },
  { title: "Audit Reports", description: "External audit reports verifying our financial accuracy and compliance." },
  { title: "Meeting Minutes", description: "Minutes from committee meetings, board meetings, and general body meetings." },
  { title: "Annual Reports", description: "Annual reports covering our activities, achievements, and financial overview." },
];

const allIncomeEntries = [
  ...payments
    .filter((p) => p.data.year === selectedYear)
    .map((p) => ({
      date: p.data.date || new Date(selectedYear, p.data.month, 1),
      category: "Membership Collection",
      description: `Payment from member ${p.data.memberId}`,
      amount: p.data.amount,
    })),
  ...donors.map((d) => ({
    date: d.date,
    category: "Donations & Grants",
    description: `Donation from ${d.anonymous ? "Anonymous" : d.name}${d.purpose ? ` — ${d.purpose}` : ""}`,
    amount: d.amount,
  })),
  ...incomeEntries.map((e) => ({
    date: e.date,
    category: e.category,
    description: e.description,
    amount: e.amount,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<BaseLayout
  title="Financial Transparency — Income, Expenses & Reports"
  description="Nayee Subah Foundation's financial transparency page. Review our income, expenses, membership collections, and audited financial reports with complete openness."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/transparency/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Transparency</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Financial <span class="text-accent">Transparency</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            We believe in complete transparency. Every rupee received and spent is accounted for. Below is a summary of our financial activities for FY {selectedYear}, with detailed reports available for review.
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-8 mb-12">
          <div class="card p-6 sm:p-8">
            <h2 class="text-xl font-semibold mb-6 flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-success"></span>
              Income Summary — {selectedYear}
            </h2>
            {incomeItems.length > 0 ? (
              <div class="space-y-3">
                {incomeItems.map((item) => {
                  const pct = Math.round((item.amount / totalIncome) * 100);
                  return (
                    <div>
                      <div class="flex items-center justify-between text-sm mb-1">
                        <span class="text-muted">{item.category}</span>
                        <span class="font-medium">{formatINR(item.amount)}</span>
                      </div>
                      <div class="h-2 rounded-full bg-section overflow-hidden">
                        <div class="h-full rounded-full bg-success" style={`width: ${pct}%`}></div>
                      </div>
                    </div>
                  );
                })}
                <div class="pt-3 border-t border-border flex items-center justify-between font-bold">
                  <span>Total Income</span>
                  <span class="text-success">{formatINR(totalIncome)}</span>
                </div>
              </div>
            ) : (
              <p class="text-muted text-sm py-8 text-center">No income recorded for {selectedYear}. Data is pulled from member payments, donations, and manual income entries.</p>
            )}
          </div>

          <div class="card p-6 sm:p-8">
            <h2 class="text-xl font-semibold mb-6 flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-error"></span>
              Expense Summary — {selectedYear}
            </h2>
            {expenseItems.length > 0 ? (
              <div class="space-y-3">
                {expenseItems.map((item) => {
                  const pct = Math.round((item.amount / totalExpense) * 100);
                  return (
                    <div>
                      <div class="flex items-center justify-between text-sm mb-1">
                        <span class="text-muted">{item.category}</span>
                        <span class="font-medium">{formatINR(item.amount)}</span>
                      </div>
                      <div class="h-2 rounded-full bg-section overflow-hidden">
                        <div class="h-full rounded-full bg-error/70" style={`width: ${pct}%`}></div>
                      </div>
                    </div>
                  );
                })}
                <div class="pt-3 border-t border-border flex items-center justify-between font-bold">
                  <span>Total Expenses</span>
                  <span class="text-error">{formatINR(totalExpense)}</span>
                </div>
              </div>
            ) : (
              <p class="text-muted text-sm py-8 text-center">No expenses recorded for {selectedYear}. Add them via the CMS.</p>
            )}
          </div>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
          <div class="card p-6 text-center">
            <div class="text-2xl font-black text-accent">{formatINR(membershipIncome)}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Membership Collection</div>
          </div>
          <div class="card p-6 text-center">
            <div class="text-2xl font-black text-accent">{formatINR(donationIncome)}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Donations & Grants</div>
          </div>
          <div class="card p-6 text-center">
            <div class="text-2xl font-black text-accent">{formatINR(manualIncomeTotal)}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Program & Other</div>
          </div>
          <div class="card p-6 text-center">
            <div class="text-2xl font-black text-accent">{formatINR(totalExpense)}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Total Expenses</div>
          </div>
        </div>

        <div class="card p-8 mb-12 text-center bg-inverse text-inverted">
          <h3 class="text-2xl font-bold mb-2">Net Surplus</h3>
          <div class="text-5xl font-black text-accent">{formatINR(netSurplus)}</div>
          <p class="text-white/60 text-sm mt-2">Reinvested into programs and reserves</p>
        </div>

        <div class="card p-6 sm:p-8 mb-12 border-2 border-dashed border-warning/40 bg-warning/[0.03]">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h2 class="text-xl font-semibold flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-warning"></span>
              Investment Department
            </h2>
            <span class="inline-flex items-center gap-1 rounded-full bg-warning/15 text-warning text-[10px] font-bold uppercase tracking-wider px-2.5 py-1">
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" /></svg>
              Experimental
            </span>
          </div>
          <p class="text-xs text-muted mb-6">
            Independent department of NSF — investment projects are tracked separately from membership fees and donations. Returns and portfolio figures below are <span class="text-warning font-medium">not included</span> in the financial overview above.
          </p>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="p-4 rounded-xl bg-accent-soft/20">
              <div class="text-xl font-black">{formatINR(totalInvested)}</div>
              <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">Invested Capital</div>
            </div>
            <div class="p-4 rounded-xl bg-accent-soft/20">
              <div class="text-xl font-black">{formatINR(totalCurrentValue)}</div>
              <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">Current Value</div>
            </div>
            <div class="p-4 rounded-xl bg-accent-soft/20">
              <div class="text-xl font-black">{formatINR(investmentIncome)}</div>
              <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">Returns Received</div>
            </div>
            <div class="p-4 rounded-xl bg-accent-soft/20">
              <div class="text-xl font-black">{formatINR(totalExpectedReturn)}</div>
              <div class="text-[11px] uppercase tracking-wider text-muted mt-0.5">Expected Return</div>
            </div>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-muted mb-3">Projects</div>
            <div class="grid sm:grid-cols-2 gap-4">
              {projects.map((p) => (
                <div class="p-4 rounded-xl bg-accent-soft/20">
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="font-medium text-sm truncate">{p.data.title}</span>
                    <span class="text-xs font-bold text-warning shrink-0">{formatINR(p.data.actualReturn || 0)}</span>
                  </div>
                  <p class="text-xs text-muted mb-2">{p.data.businessCategory} &middot; {formatINR(p.data.investmentAmount)} invested</p>
                  <div class="h-2 rounded-full bg-section overflow-hidden">
                    <div class="h-full rounded-full bg-warning" style={`width: ${p.data.progress}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {allIncomeEntries.length > 0 && (
        <div class="card p-6 sm:p-8 mb-12">
          <h2 class="text-xl font-semibold mb-6">Detailed Income Ledger — {selectedYear}</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left py-3 px-4 font-medium text-muted">Date</th>
                  <th class="text-left py-3 px-4 font-medium text-muted">Category</th>
                  <th class="text-left py-3 px-4 font-medium text-muted">Description</th>
                  <th class="text-right py-3 px-4 font-medium text-muted">Amount</th>
                </tr>
              </thead>
              <tbody>
                {allIncomeEntries.map((e) => (
                  <tr class="border-b border-border/50 hover:bg-accent-soft/30 transition-colors">
                    <td class="py-3 px-4 text-muted whitespace-nowrap">{e.date.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}</td>
                    <td class="py-3 px-4 text-body">{e.category}</td>
                    <td class="py-3 px-4 text-muted max-w-xs truncate" title={e.description}>{e.description}</td>
                    <td class="py-3 px-4 text-right font-medium text-body text-success">{formatINR(e.amount)}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr class="font-bold border-t-2 border-border bg-accent-soft/20">
                  <td colspan="3" class="py-3 px-4 text-body text-right">Total Income</td>
                  <td class="py-3 px-4 text-right text-body text-success">{formatINR(totalIncome)}</td>
                </tr>
              </tfoot>
            </table>
          </div>
          <p class="mt-4 text-xs text-muted">{allIncomeEntries.length} income entries for {selectedYear}.</p>
        </div>
        )}

        {expenseItems.length > 0 && (
        <div class="card p-6 sm:p-8 mb-12">
          <h2 class="text-xl font-semibold mb-6">Detailed Expense Ledger — {selectedYear}</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left py-3 px-4 font-medium text-muted">Date</th>
                  <th class="text-left py-3 px-4 font-medium text-muted">Category</th>
                  <th class="text-left py-3 px-4 font-medium text-muted">Description</th>
                  <th class="text-left py-3 px-4 font-medium text-muted hidden sm:table-cell">Vendor</th>
                  <th class="text-right py-3 px-4 font-medium text-muted">Amount</th>
                </tr>
              </thead>
              <tbody>
                {yearExpenses.map((e) => (
                  <tr class="border-b border-border/50 hover:bg-accent-soft/30 transition-colors">
                    <td class="py-3 px-4 text-muted whitespace-nowrap">{e.date.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}</td>
                    <td class="py-3 px-4 text-body">{e.category}</td>
                    <td class="py-3 px-4 text-muted max-w-xs truncate" title={e.description}>{e.description}</td>
                    <td class="py-3 px-4 text-muted hidden sm:table-cell">{e.vendor || "\u2014"}</td>
                    <td class="py-3 px-4 text-right font-medium text-body">{formatINR(e.amount)}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr class="font-bold border-t-2 border-border bg-accent-soft/20">
                  <td colspan="4" class="py-3 px-4 text-body text-right">Total Expenses</td>
                  <td class="py-3 px-4 text-right text-body">{formatINR(totalExpense)}</td>
                </tr>
              </tfoot>
            </table>
          </div>
          <p class="mt-4 text-xs text-muted">{yearExpenses.length} expense entries for {selectedYear}. Manage via CMS.</p>
        </div>
        )}

        {donors.length > 0 && (
        <div class="card p-6 sm:p-8 mb-12">
          <h2 class="text-xl font-semibold mb-6">Recent Donors ({selectedYear})</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {donors.sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 9).map((d) => (
              <div class="flex items-center gap-3 p-3 rounded-xl bg-accent-soft/20">
                <div class="h-9 w-9 rounded-full bg-accent/20 flex items-center justify-center text-accent font-bold text-xs shrink-0">
                  {d.name.split(" ").map(n => n[0]).join("").slice(0, 2).toUpperCase()}
                </div>
                <div class="min-w-0 flex-1">
                  <p class="font-medium text-sm truncate">{d.name}</p>
                  <p class="text-xs text-muted">{formatINR(d.amount)} &middot; {d.date.toLocaleDateString("en-IN", { month: "short", year: "numeric" })}</p>
                </div>
              </div>
            ))}
          </div>
          {donors.length > 9 && <p class="text-xs text-muted mt-3">+{donors.length - 9} more donors</p>}
        </div>
        )}

        <div class="card p-6 mb-12">
          <div class="flex items-center gap-3 text-sm text-muted">
            <svg class="h-5 w-5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
            </svg>
            All data is pulled from live CMS collections — member payments, donations, and manual income/expense entries. Investment projects are tracked separately under the independent Investment Department. <a href="/admin/" class="text-accent hover:underline">Manage via CMS</a>
          </div>
        </div>

        <div class="section-title mb-12">
          <h2>Financial <span class="text-accent">Reports</span></h2>
          <p>Detailed reports for comprehensive review.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {reportsSections.map((r) => (
            <div class="card p-6 text-center">
              <h3 class="font-semibold mb-2">{r.title}</h3>
              <p class="text-muted text-sm">{r.description}</p>
            </div>
          ))}
        </div>
        <div class="text-center mt-6">
          <p class="text-sm text-muted">Reports will be available for download once published.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
