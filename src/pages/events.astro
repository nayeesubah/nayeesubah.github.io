---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import EventCard from "../components/EventCard.astro";
import { getCollection } from "astro:content";

const allEvents = (await getCollection("events"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const upcoming = allEvents.filter((e) => e.data.status === "upcoming" || e.data.status === "ongoing");
const past = allEvents.filter((e) => e.data.status === "completed" || e.data.status === "cancelled");
const featured = allEvents.filter((e) => e.data.featured);
const nonFeatured = allEvents.filter((e) => !e.data.featured);
---

<BaseLayout
  title="NGO Events & Community Programs in Jharkhand"
  description="Stay updated with Nayee Subah Foundation NGO events, health camps, workshops, and community gatherings in Jharkhand and across rural India."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/events/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Events</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Our <span class="text-accent">Events</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Stay connected with our upcoming events, workshops, and community gatherings.
          </p>
        </div>

        {/* Tab bar */}
        <div class="flex flex-wrap items-center gap-2 mb-8" id="tab-bar">
          <button class="tab-btn px-5 py-2.5 rounded-xl bg-accent text-accent-text font-semibold text-sm transition-all duration-200" data-tab="all">
            All Events
            <span class="ml-1.5 px-1.5 py-0.5 rounded-md bg-white/20 text-[11px]">{allEvents.length}</span>
          </button>
          <button class="tab-btn px-5 py-2.5 rounded-xl bg-accent-soft text-accent font-semibold text-sm hover:bg-accent hover:text-accent-text transition-all duration-200" data-tab="upcoming">
            Upcoming
            {upcoming.length > 0 && <span class="ml-1.5 px-1.5 py-0.5 rounded-md bg-accent/10 text-[11px]">{upcoming.length}</span>}
          </button>
          <button class="tab-btn px-5 py-2.5 rounded-xl bg-accent-soft text-accent font-semibold text-sm hover:bg-accent hover:text-accent-text transition-all duration-200" data-tab="past">
            Past
            {past.length > 0 && <span class="ml-1.5 px-1.5 py-0.5 rounded-md bg-accent/10 text-[11px]">{past.length}</span>}
          </button>
          <div class="ml-auto relative max-w-xs flex-1 sm:flex-none">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            <input
              id="event-search"
              type="text"
              placeholder="Search events..."
              class="w-full sm:w-56 pl-9 pr-4 py-2.5 rounded-xl border border-input-border bg-card text-body text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
            />
          </div>
        </div>

        {/* Featured Events Banner */}
        {featured.length > 0 && (
          <div class="mb-10" id="featured-section">
            <h2 class="text-lg font-bold mb-4 flex items-center gap-2">
              <svg class="h-5 w-5 text-warning" fill="currentColor" viewBox="0 0 24 24"><path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>
              Featured Events
            </h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {featured.slice(0, 3).map((event) => <EventCard event={event} />)}
            </div>
          </div>
        )}

        {/* Events Grid */}
        {allEvents.length > 0 ? (
          <>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="events-grid">
              {nonFeatured.map((event) => (
                <div class="event-item" data-status={event.data.status} data-search={`${event.data.title} ${event.data.description} ${event.data.venue}`.toLowerCase()}>
                  <EventCard event={event} />
                </div>
              ))}
            </div>
            <div id="no-results" class="hidden text-center py-20">
              <div class="text-5xl mb-4">🔍</div>
              <h3 class="text-xl font-semibold mb-2">No Events Found</h3>
              <p class="text-muted">Try adjusting your search or filter.</p>
            </div>
          </>
        ) : (
          <div class="text-center py-20">
            <div class="text-6xl mb-4">📅</div>
            <h3 class="text-xl font-semibold mb-2">No Events Yet</h3>
            <p class="text-muted">Check back soon for upcoming events.</p>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll(".tab-btn");
  const items = document.querySelectorAll(".event-item");
  const searchInput = document.getElementById("event-search");
  const noResults = document.getElementById("no-results");
  const featuredSection = document.getElementById("featured-section");

  let activeTab = "all";

  function filterEvents() {
    const query = (searchInput?.value || "").toLowerCase().trim();
    let visibleCount = 0;

    items.forEach((item) => {
      const matchTab = activeTab === "all" || item.dataset.status === activeTab;
      const matchSearch = !query || item.dataset.search.includes(query);
      const show = matchTab && matchSearch;
      item.style.display = show ? "" : "none";
      if (show) visibleCount++;
    });

    if (featuredSection) {
      featuredSection.style.display = activeTab === "all" ? "" : "none";
    }

    if (noResults) {
      noResults.classList.toggle("hidden", visibleCount > 0);
    }
  }

  function setActiveTab(tab) {
    activeTab = tab;
    tabs.forEach((btn) => {
      const isActive = btn.dataset.tab === tab;
      btn.className = isActive
        ? "tab-btn px-5 py-2.5 rounded-xl bg-accent text-accent-text font-semibold text-sm transition-all duration-200"
        : "tab-btn px-5 py-2.5 rounded-xl bg-accent-soft text-accent font-semibold text-sm hover:bg-accent hover:text-accent-text transition-all duration-200";
    });
    filterEvents();
  }

  tabs.forEach((btn) => {
    btn.addEventListener("click", () => setActiveTab(btn.dataset.tab));
  });

  searchInput?.addEventListener("input", filterEvents);
</script>
