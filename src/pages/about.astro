---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import StatCard from "../components/StatCard.astro";
import VideoThumbnail from "../components/VideoThumbnail.astro";
import { getCollection } from "astro:content";
import { getSiteSettings } from "../lib/site";

const teamMembers = (await getCollection("team"))
  .sort((a, b) => a.data.order - b.data.order);

const settings = await getSiteSettings();

const values = [
  { title: "Education", description: "We believe education is the most powerful tool for breaking the cycle of poverty and building a better future.", icon: "M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.627 48.627 0 0 1 12 20.904a48.627 48.627 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.57 50.57 0 0 0-2.658-.813A59.905 59.905 0 0 1 12 3.493a59.902 59.902 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" },
  { title: "Community Unity", description: "We bring communities together regardless of background, fostering harmony and collective progress.", icon: "M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" },
  { title: "Transparency", description: "Complete openness in all our operations — every rupee is tracked, every decision is shared.", icon: "M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" },
  { title: "Rural Focus", description: "We concentrate our efforts on underserved rural communities where the need is greatest.", icon: "M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21" },
];
---

<BaseLayout
    title="About Us — Mission & Vision of an NGO in Rural Jharkhand"
  description="Learn about Nayee Subah Foundation — our mission to promote education, social reform, healthcare, and community development in rural Jharkhand and across India."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/about/" class="mb-8" />
        <div class="max-w-3xl">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">About Us</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Education. Unity.<br />
            <span class="text-accent">A New Dawn</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Nayee Subah Foundation has been founded with the sole aim of creation of awareness about education and its propagation, social reforms, unity and community development. Based in Giridih, Jharkhand, we are dedicated to uplifting underprivileged communities through education, healthcare, and social welfare programs.
          </p>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {
          settings.aboutVideoUrl ? (
            <div class="grid lg:grid-cols-2 gap-16 items-center">
              <div>
                <h2 class="text-2xl sm:text-3xl font-semibold mb-6">Our <span class="text-accent">Mission</span></h2>
                <div class="space-y-4 text-muted leading-relaxed">
                  <p>Nayee Subah Foundation has been founded with the sole aim of creation of awareness about education and its propagation, social reforms, and community unity. The underserved communities, particularly in rural Jharkhand, face economic and academic backwardness that demands immediate attention and action.</p>
                  <div class="mb-6 lg:hidden">
                    <VideoThumbnail videoUrl={settings.aboutVideoUrl} thumbnailUrl={settings.aboutVideoThumbnail} />
                  </div>
                  <p>We are on a mission to:</p>
                  <ul class="space-y-2">
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Carry forward the lamp of knowledge in society</li>
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Impart literacy and education to the underprivileged</li>
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Provide every possible means to underprivileged students for their betterment</li>
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Conduct career guidance programs and seminars</li>
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Combat child labour and substance abuse</li>
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Promote rural women empowerment and support local farmers</li>
                  </ul>
                </div>
              </div>
              <div class="hidden lg:block">
                <VideoThumbnail videoUrl={settings.aboutVideoUrl} thumbnailUrl={settings.aboutVideoThumbnail} />
              </div>
            </div>
          ) : (
            <div class="grid lg:grid-cols-2 gap-16 items-center">
              <div>
                <h2 class="text-2xl sm:text-3xl font-semibold mb-6">Our <span class="text-accent">Mission</span></h2>
                <div class="space-y-4 text-muted leading-relaxed">
                  <p>Nayee Subah Foundation has been founded with the sole aim of creation of awareness about education and its propagation, social reforms, and community unity. The underserved communities, particularly in rural Jharkhand, face economic and academic backwardness that demands immediate attention and action.</p>
                  <p>We are on a mission to:</p>
                  <ul class="space-y-2">
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Carry forward the lamp of knowledge in society</li>
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Impart literacy and education to the underprivileged</li>
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Provide every possible means to underprivileged students for their betterment</li>
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Conduct career guidance programs and seminars</li>
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Combat child labour and substance abuse</li>
                    <li class="flex items-start gap-2"><span class="text-accent mt-1.5 shrink-0">✦</span> Promote rural women empowerment and support local farmers</li>
                  </ul>
                </div>
              </div>
              <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-accent-soft flex items-center justify-center">
                <div class="text-center p-12">
                  <span class="text-8xl">🌱</span>
                  <p class="mt-6 text-lg text-accent font-medium">Growing Together</p>
                </div>
              </div>
            </div>
          )
        }
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-title mb-12">
          <h2>Our <span class="text-accent">Values</span></h2>
          <p>The principles that guide everything we do.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {values.map((v) => (
            <div class="card p-6 text-center group">
              <div class="mx-auto mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={v.icon} />
                </svg>
              </div>
              <h3 class="font-semibold text-lg mb-3">{v.title}</h3>
              <p class="text-muted text-sm">{v.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {teamMembers.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-title mb-12">
          <h2>Our <span class="text-accent">Team</span></h2>
          <p>Dedicated professionals committed to our mission.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {teamMembers.map((member) => (
            <div class="card p-6 text-center group">
              <div class="mx-auto mb-4 h-24 w-24 rounded-full bg-accent-soft flex items-center justify-center text-accent text-3xl font-bold group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
                {member.data.name.split(" ").map(n => n[0]).join("").slice(0, 2)}
              </div>
              <h3 class="font-semibold text-lg">{member.data.name}</h3>
              <p class="text-accent text-sm font-medium mb-2">{member.data.role}</p>
              {member.data.bio && <p class="text-muted text-sm">{member.data.bio}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
    )}

    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-6">
            Be Part of <span class="text-accent">the Change</span>
          </h2>
          <p class="text-muted text-lg mb-8">
            Join us in bringing education, opportunity, and hope to rural Jharkhand. Every member, volunteer, and donor helps build a new dawn.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/members/join/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200">
              Become a Member
            </a>
            <a href="/donate/" class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-btn-secondary-border text-body px-6 py-3 font-medium hover:bg-btn-secondary-hover-bg hover:text-btn-secondary-hover-text transition-all duration-200">
              Support Us
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
