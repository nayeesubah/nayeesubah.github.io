---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const donateOptions = [
  { id: "education", title: "Education Fund", description: "Support education for underprivileged children.", icon: "M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.627 48.627 0 0 1 12 20.904a48.627 48.627 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.57 50.57 0 0 0-2.658-.813A59.905 59.905 0 0 1 12 3.493a59.902 59.902 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" },
  { id: "medical", title: "Medical Fund", description: "Help provide healthcare to those in need.", icon: "M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" },
  { id: "scholarship", title: "Scholarship Fund", description: "Fund scholarships for deserving students.", icon: "M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18" },
  { id: "general", title: "General Support", description: "Support our overall mission and operations.", icon: "M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" },
  { id: "community", title: "Community Library", description: "Build and maintain rural libraries.", icon: "M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" },
  { id: "infrastructure", title: "Infrastructure", description: "Support building and infrastructure.", icon: "M3 2.25h.75a.75.75 0 0 1 .75.75v1.5m0 0h13.5m-13.5 0v10.5a.75.75 0 0 0 .75.75h13.5a.75.75 0 0 0 .75-.75V6.75m-13.5 0h13.5m-13.5 0V3a.75.75 0 0 1 .75-.75h12a.75.75 0 0 1 .75.75v3.75" },
];

const presetAmounts = [500, 1000, 2000, 5000];

const impactMap = {
  100: "Provides textbooks for one student",
  500: "Covers one child's school supplies for a year",
  1000: "Funds a month of after-school tutoring for 5 children",
  2000: "Supplies books to a community library section",
  5000: "Sponsors one student's full annual scholarship",
  10000: "Funds a complete health camp for 200 villagers",
  25000: "Sets up a computer terminal in a rural library",
  50000: "Runs a full month of community programs",
};
---

<BaseLayout
  title="Donate to an NGO — Support Rural Education in Jharkhand"
    description="Support Nayee Subah Foundation with a secure online donation. Your contribution funds education, healthcare, and community development for rural communities in Jharkhand."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/donate/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Support Our Cause</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Make a <span class="text-accent">Donation</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Your contribution directly supports our education, healthcare, library, and community development programs in rural Jharkhand. Every donation, big or small, makes a difference.
          </p>
        </div>

        <div class="grid lg:grid-cols-5 gap-8">
          <div class="lg:col-span-3 space-y-8">
            <div class="card p-6 sm:p-8">
              <h2 class="text-xl font-bold mb-2">Choose a Cause</h2>
              <p class="text-sm text-muted mb-6">Select where you'd like your donation to go.</p>
              <div class="grid sm:grid-cols-2 gap-3" id="cause-grid">
                {donateOptions.map((opt) => (
                  <button class="cause-btn flex items-start gap-3 p-4 rounded-xl border-2 border-border text-left hover:border-accent-border hover:bg-accent-soft/50 transition-all duration-200" data-cause={opt.id}>
                    <div class="mt-0.5 shrink-0 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-accent-soft text-accent">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d={opt.icon} />
                      </svg>
                    </div>
                    <div>
                      <p class="font-semibold text-sm">{opt.title}</p>
                      <p class="text-xs text-muted mt-0.5">{opt.description}</p>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <div class="card p-6 sm:p-8" id="amount-section">
              <h2 class="text-xl font-bold mb-2">Choose Amount</h2>
              <p class="text-sm text-muted mb-6">Select a preset or enter a custom amount.</p>
              <div class="flex flex-wrap gap-3 mb-5" id="amount-pills">
                {presetAmounts.map((amt) => (
                  <button class="amount-btn px-6 py-3 rounded-xl border-2 border-border font-semibold text-base hover:border-accent hover:text-accent transition-all duration-200" data-amount={amt}>
                    ₹{amt.toLocaleString("en-IN")}
                  </button>
                ))}
                <button id="custom-amount-btn" class="amount-btn px-6 py-3 rounded-xl border-2 border-border font-semibold text-base hover:border-accent hover:text-accent transition-all duration-200" data-amount="custom">
                  Custom
                </button>
              </div>
              <div id="custom-input-wrapper" class="hidden mb-5">
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-lg font-semibold text-muted">₹</span>
                  <input
                    id="custom-amount-input"
                    type="number"
                    min="1"
                    placeholder="Enter amount"
                    class="w-full pl-10 pr-4 py-3 rounded-xl border-2 border-input-border bg-card text-body text-lg font-semibold focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
                  />
                </div>
              </div>
              <div id="impact-preview" class="rounded-xl bg-accent-soft/50 border border-accent-border p-4 text-center hidden">
                <p class="text-sm text-muted">Your donation of <span id="impact-amount" class="font-bold text-accent">₹0</span></p>
                <p id="impact-text" class="text-base font-semibold text-body mt-1">Makes a difference in someone's life</p>
              </div>
            </div>

            <div class="card p-6 sm:p-8">
              <h2 class="text-xl font-bold mb-4">Payment Options</h2>
              <div class="grid sm:grid-cols-2 gap-4">
                <button id="show-upi" class="payment-tab flex items-center justify-center gap-2 rounded-xl border-2 border-accent bg-accent text-accent-text px-4 py-3 font-semibold text-sm transition-all duration-200">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
                  Pay via UPI
                </button>
                <button id="show-bank" class="payment-tab flex items-center justify-center gap-2 rounded-xl border-2 border-border text-body px-4 py-3 font-semibold text-sm hover:border-accent transition-all duration-200">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21" /></svg>
                  Bank Transfer
                </button>
              </div>

              <div id="upi-section" class="mt-6">
                <div class="rounded-xl bg-section border border-border p-6 text-center">
                  <div class="inline-flex items-center justify-center h-24 w-24 rounded-2xl bg-accent-soft mb-4">
                    <svg class="h-12 w-12 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
                  </div>
                  <p class="text-sm text-muted mb-1">Scan with any UPI app</p>
                  <p class="text-lg font-bold tracking-wide">nsfgiridih@upi</p>
                  <div class="flex items-center justify-center gap-2 mt-3">
                    <a href="upi://pay?pa=nsfgiridih@upi&pn=Nayee%20Subah%20Foundation&mc=0000" class="inline-flex items-center gap-1.5 rounded-lg bg-accent text-accent-text px-4 py-2 text-sm font-medium hover:bg-accent-hover transition-colors">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                      Pay via UPI
                    </a>
                    <button class="copy-btn inline-flex items-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-accent-soft transition-colors" data-copy="nsfgiridih@upi">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" /></svg>
                      Copy UPI ID
                    </button>
                  </div>
                </div>
              </div>

              <div id="bank-section" class="mt-6 hidden">
                <div class="rounded-xl bg-section border border-border p-6">
                  <div class="space-y-3">
                    {[
                      { label: "Account Name", value: "Nayee Subah Foundation", copy: "Nayee Subah Foundation" },
                      { label: "Account Number", value: "38272911011", copy: "38272911011" },
                      { label: "Bank", value: "State Bank of India", copy: "" },
                      { label: "IFSC Code", value: "SBIN0012636", copy: "SBIN0012636" },
                      { label: "Branch", value: "Giridih, Jharkhand", copy: "" },
                    ].map((row) => (
                      <div class="flex items-center justify-between py-2 border-b border-border last:border-0">
                        <span class="text-sm text-muted">{row.label}</span>
                        <div class="flex items-center gap-2">
                          <span class="text-sm font-semibold">{row.value}</span>
                          {row.copy && (
                            <button class="copy-btn text-muted hover:text-accent transition-colors" data-copy={row.copy} title={`Copy ${row.label}`}>
                              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" /></svg>
                            </button>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-2 space-y-6">
            <div class="card p-6 sm:p-8 text-center">
              <h2 class="text-xl font-bold mb-2">Your Impact</h2>
              <p class="text-sm text-muted mb-6">See what your contribution enables.</p>
              <div class="space-y-4" id="impact-list">
                {[500, 2000, 5000, 10000, 25000].map((amt) => (
                  <div class="impact-item flex items-center gap-3 p-3 rounded-xl border border-border text-left">
                    <div class="shrink-0 flex items-center justify-center h-10 w-10 rounded-full bg-accent-soft text-accent font-bold text-sm">
                      ₹{amt >= 1000 ? `${(amt / 1000).toFixed(0)}k` : amt}
                    </div>
                    <div>
                      <p class="text-sm font-semibold">{impactMap[amt as keyof typeof impactMap]}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="card p-6 sm:p-8">
              <h2 class="text-xl font-bold mb-2">Other Ways to Give</h2>
              <div class="space-y-4 mt-4">
                <a href="/members/join/" class="flex items-center gap-3 p-3 rounded-xl border border-border hover:border-accent-border hover:bg-accent-soft/50 transition-all duration-200">
                  <div class="shrink-0 h-10 w-10 rounded-lg bg-accent-soft flex items-center justify-center text-accent">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
                  </div>
                  <div class="flex-1">
                    <p class="font-semibold text-sm">Become a Monthly Member</p>
                    <p class="text-xs text-muted">From just ₹200/month</p>
                  </div>
                  <svg class="h-5 w-5 text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                </a>
                <a href="/volunteer/" class="flex items-center gap-3 p-3 rounded-xl border border-border hover:border-accent-border hover:bg-accent-soft/50 transition-all duration-200">
                  <div class="shrink-0 h-10 w-10 rounded-lg bg-accent-soft flex items-center justify-center text-accent">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
                  </div>
                  <div class="flex-1">
                    <p class="font-semibold text-sm">Volunteer Your Time</p>
                    <p class="text-xs text-muted">Skills, teaching, or on-ground support</p>
                  </div>
                  <svg class="h-5 w-5 text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                </a>
                <a href="mailto:nsfgiridih@gmail.com" class="flex items-center gap-3 p-3 rounded-xl border border-border hover:border-accent-border hover:bg-accent-soft/50 transition-all duration-200">
                  <div class="shrink-0 h-10 w-10 rounded-lg bg-accent-soft flex items-center justify-center text-accent">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
                  </div>
                  <div class="flex-1">
                    <p class="font-semibold text-sm">Corporate Sponsorship</p>
                    <p class="text-xs text-muted">Partner with us for greater impact</p>
                  </div>
                  <svg class="h-5 w-5 text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const impactMap = {
    100: "Provides textbooks for one student",
    500: "Covers one child's school supplies for a year",
    1000: "Funds a month of after-school tutoring for 5 children",
    2000: "Supplies books to a community library section",
    5000: "Sponsors one student's full annual scholarship",
    10000: "Funds a complete health camp for 200 villagers",
    25000: "Sets up a computer terminal in a rural library",
    50000: "Runs a full month of community programs",
  };

  const impactKeys = Object.keys(impactMap).map(Number).sort((a, b) => a - b);

  let selectedAmount = 0;
  let selectedCause = "general";
  const amountBtns = document.querySelectorAll(".amount-btn");
  const customInput = document.getElementById("custom-amount-input");
  const customWrapper = document.getElementById("custom-input-wrapper");
  const customBtn = document.getElementById("custom-amount-btn");
  const impactPreview = document.getElementById("impact-preview");
  const impactAmount = document.getElementById("impact-amount");
  const impactText = document.getElementById("impact-text");
  const causeBtns = document.querySelectorAll(".cause-btn");

  function getImpactText(amount) {
    let closest = impactKeys[0];
    for (const k of impactKeys) {
      if (amount >= k) closest = k;
    }
    return impactMap[closest as keyof typeof impactMap] || "Makes a difference in someone's life";
  }

  function updateAmount(value) {
    selectedAmount = value;
    amountBtns.forEach((b) => {
      const isActive = b.dataset.amount === String(value);
      b.className = isActive
        ? "amount-btn px-6 py-3 rounded-xl border-2 border-accent bg-accent text-accent-text font-semibold text-base transition-all duration-200"
        : "amount-btn px-6 py-3 rounded-xl border-2 border-border font-semibold text-base hover:border-accent hover:text-accent transition-all duration-200";
    });
    if (value > 0) {
      impactPreview.classList.remove("hidden");
      impactAmount.textContent = "₹" + value.toLocaleString("en-IN");
      impactText.textContent = getImpactText(value);
    } else {
      impactPreview.classList.add("hidden");
    }
  }

  amountBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn.dataset.amount === "custom") {
        customWrapper.classList.remove("hidden");
        customInput.focus();
        amountBtns.forEach((b) => {
          b.className = "amount-btn px-6 py-3 rounded-xl border-2 border-border font-semibold text-base hover:border-accent hover:text-accent transition-all duration-200";
        });
        btn.className = "amount-btn px-6 py-3 rounded-xl border-2 border-accent bg-accent text-accent-text font-semibold text-base transition-all duration-200";
        const val = parseInt(customInput.value) || 0;
        updateAmount(val);
        return;
      }
      customWrapper.classList.add("hidden");
      const val = parseInt(btn.dataset.amount) || 0;
      updateAmount(val);
    });
  });

  customInput.addEventListener("input", () => {
    const val = parseInt(customInput.value) || 0;
    selectedAmount = val;
    if (val > 0) {
      impactPreview.classList.remove("hidden");
      impactAmount.textContent = "₹" + val.toLocaleString("en-IN");
      impactText.textContent = getImpactText(val);
    } else {
      impactPreview.classList.add("hidden");
    }
  });

  causeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      selectedCause = btn.dataset.cause;
      causeBtns.forEach((b) => {
        b.className = "cause-btn flex items-start gap-3 p-4 rounded-xl border-2 border-border text-left hover:border-accent-border hover:bg-accent-soft/50 transition-all duration-200";
      });
      btn.className = "cause-btn flex items-start gap-3 p-4 rounded-xl border-2 border-accent bg-accent-soft/50 text-left transition-all duration-200";
    });
  });

  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.innerHTML;
        btn.innerHTML = `<svg class="h-4 w-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>`;
        setTimeout(() => btn.innerHTML = original, 2000);
      } catch {}
    });
  });

  document.getElementById("show-upi")?.addEventListener("click", () => {
    document.getElementById("upi-section")?.classList.remove("hidden");
    document.getElementById("bank-section")?.classList.add("hidden");
    const upiBtn = document.getElementById("show-upi");
    const bankBtn = document.getElementById("show-bank");
    if (upiBtn) upiBtn.className = "payment-tab flex items-center justify-center gap-2 rounded-xl border-2 border-accent bg-accent text-accent-text px-4 py-3 font-semibold text-sm transition-all duration-200";
    if (bankBtn) bankBtn.className = "payment-tab flex items-center justify-center gap-2 rounded-xl border-2 border-border text-body px-4 py-3 font-semibold text-sm hover:border-accent transition-all duration-200";
  });

  document.getElementById("show-bank")?.addEventListener("click", () => {
    document.getElementById("bank-section")?.classList.remove("hidden");
    document.getElementById("upi-section")?.classList.add("hidden");
    const upiBtn = document.getElementById("show-upi");
    const bankBtn = document.getElementById("show-bank");
    if (bankBtn) bankBtn.className = "payment-tab flex items-center justify-center gap-2 rounded-xl border-2 border-accent bg-accent text-accent-text px-4 py-3 font-semibold text-sm transition-all duration-200";
    if (upiBtn) upiBtn.className = "payment-tab flex items-center justify-center gap-2 rounded-xl border-2 border-border text-body px-4 py-3 font-semibold text-sm hover:border-accent transition-all duration-200";
  });
</script>
