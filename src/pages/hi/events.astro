---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import EventCard from "../../components/EventCard.astro";
import { getCollection } from "astro:content";
import { filterByLocale, localeSlug } from "../../lib/site";


const locale = "hi" as const;

const copy = {
  hi: {
    title: "झारखंड में एनजीओ कार्यक्रम और सामुदायिक गतिविधियाँ",
    description: "झारखंड और पूरे ग्रामीण भारत में नयी सुबह फाउंडेशन एनजीओ के कार्यक्रमों, स्वास्थ्य शिविरों, कार्यशालाओं और सामुदायिक सभाओं के साथ अपडेट रहें।",
    badge: "कार्यक्रम",
    heading: "हमारे",
    headingAccent: "कार्यक्रम",
    subtitle: "हमारे आगामी कार्यक्रमों, कार्यशालाओं और सामुदायिक सभाओं से जुड़े रहें।",
    nextEvent: "अगला कार्यक्रम",
    today: "आज",
    tomorrow: "कल",
    daysSuffix: "दिन",
    toGo: "शेष",
    viewDetails: "विवरण देखें",
    allEvents: "सभी कार्यक्रम",
    upcoming: "आगामी",
    past: "पिछले",
    searchPh: "कार्यक्रम खोजें...",
    noResultsTitle: "कोई कार्यक्रम नहीं मिला",
    noResultsBody: "अपनी खोज या फ़िल्टर समायोजित करके देखें।",
    noEventsTitle: "अभी तक कोई कार्यक्रम नहीं",
    noEventsBody: "आगामी कार्यक्रमों के लिए जल्द ही वापस देखें।",
    showingAll: "सभी {n} कार्यक्रम दिखा रहे हैं",
    showingFiltered: "{n} में से {v} कार्यक्रम दिखा रहे हैं",
    dateLocale: "hi-IN",
  },
  ur: {
    title: "جھارکھنڈ میں این جی او پروگرام اور کمیونٹی سرگرمیاں",
    description: "جھارکھنڈ اور دیہی ہندوستان بھر میں نئی صبح فاؤنڈیشن این جی او کے پروگراموں، صحت کیمپوں، ورکشاپس اور کمیونٹی اجتماعات کے ساتھ اپ ڈیٹ رہیں۔",
    badge: "پروگرام",
    heading: "ہمارے",
    headingAccent: "پروگرام",
    subtitle: "ہمارے آئندہ پروگراموں، ورکشاپس اور کمیونٹی اجتماعات سے جڑے رہیں۔",
    nextEvent: "اگلا پروگرام",
    today: "آج",
    tomorrow: "کل",
    daysSuffix: "دن",
    toGo: "باقی",
    viewDetails: "تفصیلات دیکھیں",
    allEvents: "تمام پروگرام",
    upcoming: "آئندہ",
    past: "گزشتہ",
    searchPh: "پروگرام تلاش کریں...",
    noResultsTitle: "کوئی پروگرام نہیں ملا",
    noResultsBody: "اپنی تلاش یا فلٹر کو ایڈجسٹ کرکے دیکھیں۔",
    noEventsTitle: "ابھی تک کوئی پروگرام نہیں",
    noEventsBody: "آئندہ پروگراموں کے لیے جلد دوبارہ دیکھیں۔",
    showingAll: "تمام {n} پروگرام دکھائے جا رہے ہیں",
    showingFiltered: "{n} میں سے {v} پروگرام دکھائے جا رہے ہیں",
    dateLocale: "ur-IN",
  },
}[locale];

const allEvents = filterByLocale(await getCollection("events"), locale)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const bucket = (status: string) => (status === "upcoming" || status === "ongoing" ? "upcoming" : "past");
const upcoming = allEvents.filter((e) => bucket(e.data.status) === "upcoming");
const past = allEvents.filter((e) => bucket(e.data.status) === "past");

const now = Date.now();
const nextEvent = upcoming
  .filter((e) => e.data.date.getTime() >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())[0];
const gridEvents = nextEvent ? allEvents.filter((e) => e.id !== nextEvent.id) : allEvents;

function formatDate(d: Date) {
  return d.toLocaleDateString(copy.dateLocale, { weekday: "long", day: "numeric", month: "long", year: "numeric" });
}
const nextDiffDays = nextEvent ? Math.ceil((nextEvent.data.date.getTime() - now) / (1000 * 60 * 60 * 24)) : 0;
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/events/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">{copy.badge}</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            {copy.heading} <span class="text-accent">{copy.headingAccent}</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            {copy.subtitle}
          </p>
        </div>

        {nextEvent && (
          <a
            href={`/${locale}/events/${localeSlug(nextEvent.id)}/`}
            class="card-hover card block overflow-hidden mb-12 group"
          >
            <div class="grid md:grid-cols-[minmax(0,1fr)_2fr] items-stretch">
              <div class="relative bg-linear-to-br from-accent to-accent-hover text-accent-text p-8 flex flex-col justify-center min-h-[200px]">
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest opacity-90 mb-3">
                  <span class="h-1.5 w-1.5 rounded-full bg-white animate-pulse" />
                  {copy.nextEvent}
                </span>
                <div class="text-4xl font-black leading-none">
                  {nextDiffDays === 0 ? copy.today : nextDiffDays === 1 ? copy.tomorrow : `${nextDiffDays} ${copy.daysSuffix}`}
                </div>
                {nextDiffDays > 1 && <div class="text-sm opacity-90 mt-1">{copy.toGo}</div>}
              </div>
              <div class="p-6 sm:p-8">
                <p class="text-sm font-medium text-accent mb-2">{formatDate(nextEvent.data.date)}</p>
                <h2 class="text-2xl font-bold mb-2 group-hover:text-accent transition-colors">{nextEvent.data.title}</h2>
                <p class="text-muted text-sm flex items-center gap-1.5 mb-3">
                  <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                  {nextEvent.data.venue}
                </p>
                <p class="text-muted text-sm leading-relaxed line-clamp-2 mb-4">{nextEvent.data.description}</p>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
                  {copy.viewDetails}
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                </span>
              </div>
            </div>
          </a>
        )}

        {/* Tab bar */}
        <div class="flex flex-wrap items-center gap-2 mb-10" id="tab-bar">
          <button type="button" class="tab-btn is-active px-5 py-2.5 rounded-xl bg-accent text-accent-text font-semibold text-sm transition-all duration-200" data-tab="all">
            {copy.allEvents}
            <span class="ml-1.5 px-1.5 py-0.5 rounded-md bg-white/20 text-[11px]">{allEvents.length}</span>
          </button>
          <button type="button" class="tab-btn px-5 py-2.5 rounded-xl bg-accent-soft text-accent font-semibold text-sm hover:bg-accent hover:text-accent-text transition-all duration-200" data-tab="upcoming">
            {copy.upcoming}
            {upcoming.length > 0 && <span class="ml-1.5 px-1.5 py-0.5 rounded-md bg-accent/10 text-[11px]">{upcoming.length}</span>}
          </button>
          <button type="button" class="tab-btn px-5 py-2.5 rounded-xl bg-accent-soft text-accent font-semibold text-sm hover:bg-accent hover:text-accent-text transition-all duration-200" data-tab="past">
            {copy.past}
            {past.length > 0 && <span class="ml-1.5 px-1.5 py-0.5 rounded-md bg-accent/10 text-[11px]">{past.length}</span>}
          </button>
          <div class="ml-auto relative max-w-xs flex-1 sm:flex-none">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            <input
              id="event-search"
              type="text"
              placeholder={copy.searchPh}
              class="w-full sm:w-56 pl-9 pr-4 py-2.5 rounded-xl border border-input-border bg-card text-body text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
            />
          </div>
        </div>

        {/* Events Grid */}
        {gridEvents.length > 0 ? (
          <>
            <p id="results-count" class="text-sm text-muted mb-6" aria-live="polite"></p>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="events-grid">
              {gridEvents.map((event) => (
                <div
                  class="event-item transition-all duration-300 ease-out"
                  data-bucket={bucket(event.data.status)}
                  data-search={`${event.data.title} ${event.data.description} ${event.data.venue}`.toLowerCase()}
                >
                  <EventCard event={event} />
                </div>
              ))}
            </div>
            <div id="no-results" class="hidden text-center py-20">
              <div class="text-5xl mb-4">🔍</div>
              <h3 class="text-xl font-semibold mb-2">{copy.noResultsTitle}</h3>
              <p class="text-muted">{copy.noResultsBody}</p>
            </div>
          </>
        ) : (
          <div class="text-center py-20">
            <div class="text-6xl mb-4">📅</div>
            <h3 class="text-xl font-semibold mb-2">{copy.noEventsTitle}</h3>
            <p class="text-muted">{copy.noEventsBody}</p>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ showingAllTpl: copy.showingAll, showingFilteredTpl: copy.showingFiltered }}>
  function boot() {
    const tabs = document.querySelectorAll(".tab-btn");
    const items = document.querySelectorAll(".event-item");
    const searchInput = document.getElementById("event-search");
    const noResults = document.getElementById("no-results");
    const resultsCount = document.getElementById("results-count");
    const grid = document.getElementById("events-grid");
    if (!tabs.length || tabs[0].dataset.wired) return;

    let activeTab = "all";

    function filterEvents() {
      const query = (searchInput?.value || "").toLowerCase().trim();
      let visibleCount = 0;

      items.forEach((item) => {
        const matchTab = activeTab === "all" || item.dataset.bucket === activeTab;
        const matchSearch = !query || (item.dataset.search || "").includes(query);
        const show = matchTab && matchSearch;
        if (show) visibleCount++;
        if (show) {
          item.classList.remove("hidden");
          requestAnimationFrame(() => item.classList.remove("opacity-0", "scale-95"));
        } else {
          item.classList.add("opacity-0", "scale-95");
          window.setTimeout(() => item.classList.add("hidden"), 250);
        }
      });

      if (resultsCount) {
        resultsCount.textContent = query || activeTab !== "all"
          ? showingFilteredTpl.replace("{v}", String(visibleCount)).replace("{n}", String(items.length))
          : showingAllTpl.replace("{n}", String(items.length));
      }
      grid?.classList.toggle("hidden", visibleCount === 0);
      noResults?.classList.toggle("hidden", visibleCount > 0);
    }

    function setActiveTab(tab) {
      activeTab = tab;
      tabs.forEach((btn) => {
        const isActive = btn.dataset.tab === tab;
        btn.classList.toggle("is-active", isActive);
        btn.classList.toggle("bg-accent", isActive);
        btn.classList.toggle("text-accent-text", isActive);
        btn.classList.toggle("bg-accent-soft", !isActive);
        btn.classList.toggle("text-accent", !isActive);
      });
      filterEvents();
    }

    tabs.forEach((btn) => {
      btn.dataset.wired = "1";
      btn.addEventListener("click", () => setActiveTab(btn.dataset.tab || "all"));
    });

    searchInput?.addEventListener("input", filterEvents);
    filterEvents();
  }

  document.addEventListener("DOMContentLoaded", boot);
  document.addEventListener("astro:page-load", boot);
</script>
