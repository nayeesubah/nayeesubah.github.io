      { title: "شفافیت", description: "ہمارے تمام کاموں میں مکمل کھلا پن — ہر روپیہ ٹریک کیا جاتا ہے، ہر فیصلہ شیئر کیا جاتا ہے۔", icon: ICONS.transparency },
      { title: "دیہی توجہ", description: "ہم اپنی کوششیں ان پسماندہ دیہی کمیونٹیز پر مرکوز کرتے ہیں جہاں ضرورت سب سے زیادہ اور وسائل سب سے کم ہیں۔", icon: ICONS.rural },
    ],
    impactHeading: "ہمارا",
    impactAccent: "اثر",
    impactSubtitle: "ہماری خدمت کی جانے والی کمیونٹیز میں قابل پیمائش تبدیلی۔",
    impactNumbers: [
      { value: "500+", label: "تعلیم یافتہ بچے", icon: ICONS.education },
      { value: "3,000+", label: "لائبریری میں کتابیں", icon: ICONS.library },
      { value: "2,000+", label: "علاج شدہ مریض", icon: ICONS.patients },
      { value: "200+", label: "بااختیار خواتین", icon: ICONS.volunteers },
    ],
    activitiesHeading: "ہماری",
    activitiesAccent: "سرگرمیاں",
    activitiesSubtitle: "ان اقدامات کو دیکھیں جن پر ہم کام کر رہے ہیں۔",
    viewAllActivities: "تمام سرگرمیاں دیکھیں",
    testimonialsHeading: "لوگ کیا",
    testimonialsAccent: "کہتے ہیں",
    testimonialsSubtitle: "ان لوگوں سے سنیں جن کی زندگیاں ہمارے کام سے متاثر ہوئی ہیں۔",
    blogHeading: "میدان",
    blogAccent: "سے",
    blogSubtitle: "دیہی جھارکھنڈ میں ہمارے کام کی کہانیاں، اپ ڈیٹس اور تفصیلات۔",
    viewAllNews: "تمام خبریں دیکھیں",
    ctaHeading: "ہمارے ساتھ ایک نئی صبح بنائیں",
    ctaSubtitle: "چاہے ماہانہ رکنیت کے ذریعے، ایک بار کے عطیے، یا رضاکار کے طور پر آپ کا وقت — آپ کا تعاون دیہی جھارکھنڈ میں تعلیم، امید اور مواقع لاتا ہے۔",
    ctaSupport: "ہمارے کام کی حمایت کریں",
    ctaJoin: "رکن بنیں",
  },
}[locale];

const settings = await getSiteSettings();

const featuredActivities = filterByLocale((await getCollection("activities")).filter((a) => a.data.featured), locale)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const latestPosts = filterByLocale((await getCollection("blog")).filter((p) => p.data.published), locale)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const featuredTestimonials = filterByLocale((await getCollection("testimonials")).filter((t) => t.data.featured), locale)
  .slice(0, 3);
---

<BaseLayout preloadHero title={copy.title} description={copy.description}>
  <Hero heroVideoUrl={settings.heroVideoUrl} />

  {/* Founder's Message */}
  <section class="py-16 sm:py-20 lg:py-24 bg-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-2 flex justify-center">
          <div class="relative">
            <div class="h-56 w-56 sm:h-64 sm:w-64 rounded-full bg-accent-soft flex items-center justify-center text-accent text-6xl sm:text-7xl font-bold ring-4 ring-accent/20 ring-offset-4 ring-offset-section">
              MI
            </div>
            <div class="absolute -bottom-2 -right-2 rounded-full bg-accent text-accent-text p-3 shadow-lg">
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M4.5 6.375a4.125 4.125 0 1 1 8.25 0 4.125 4.125 0 0 1-8.25 0ZM14.25 8.625a3.375 3.375 0 1 1 6.75 0 3.375 3.375 0 0 1-6.75 0ZM1.5 19.125a7.125 7.125 0 0 1 14.25 0v.003l-.001.119a.75.75 0 0 1-.363.63 13.067 13.067 0 0 1-6.761 1.873c-2.472 0-4.786-.684-6.76-1.873a.75.75 0 0 1-.364-.63l-.001-.122ZM17.25 19.128l-.001.144a2.25 2.25 0 0 1-.233.96 10.088 10.088 0 0 0 5.06-1.01.75.75 0 0 0 .42-.643 4.875 4.875 0 0 0-6.957-4.611 8.586 8.586 0 0 1 1.71 5.157v.003Z"/></svg>
            </div>
          </div>
        </div>
        <div class="lg:col-span-3">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">{copy.founderLabel}</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mt-3 mb-6">
            {copy.founderHeading} <span class="text-accent">{copy.founderHeadingAccent}</span> {copy.founderHeadingSuffix}
          </h2>
          <div class="space-y-4 text-muted leading-relaxed text-lg">
            <p>{copy.founderQuote1}</p>
            <p>{copy.founderQuote2}</p>
          </div>
          <div class="mt-6 flex items-center gap-4">
            <div class="h-px flex-1 bg-border max-w-16" />
            <div>
              <p class="font-semibold text-body">{copy.founderName}</p>
              <p class="text-sm text-muted">{copy.founderTitle}</p>
              <p class="text-xs text-muted/60">{copy.founderCred}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Stats Bar */}
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {copy.stats.map((stat) => <StatCard {...stat} />)}
      </div>
    </div>
  </section>

  {/* About Intro */}
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">{copy.aboutBadge}</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mt-3 mb-6">
            {copy.aboutHeading}
            <span class="text-accent"> {copy.aboutHeadingAccent}</span>
          </h2>
          <p class="text-muted leading-relaxed text-lg mb-6">
            {copy.aboutP1}
          </p>
          <p class="text-muted leading-relaxed mb-8">
            {copy.aboutP2}
          </p>
          <a href={`/${locale}/about/`} class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200">
            {copy.learnMission}
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="aspect-[3/4] rounded-2xl overflow-hidden bg-accent-soft flex items-center justify-center">
            <div class="text-center p-8">
              <span class="text-6xl">📚</span>
              <p class="mt-4 text-sm text-accent font-medium">{copy.educationForAll}</p>
            </div>
          </div>
          <div class="aspect-[3/4] rounded-2xl overflow-hidden mt-8 bg-section flex items-center justify-center">
            <div class="text-center p-8">
              <span class="text-6xl">🌾</span>
              <p class="mt-4 text-sm text-accent font-medium">{copy.ruralDevelopment}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  {/* Community Library */}
  <section class="py-16 sm:py-20 lg:py-24 bg-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">{copy.libraryBadge}</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mt-3 mb-6">
            {copy.libraryHeading} <span class="text-accent">{copy.libraryHeadingAccent}</span>
          </h2>
          <p class="text-muted leading-relaxed text-lg mb-6">
            {copy.libraryP1}
          </p>
          <p class="text-muted leading-relaxed mb-6">
            {copy.libraryP2}
          </p>
          <div class="grid grid-cols-2 gap-4 mb-8">
            <div class="card p-4 text-center">
              <div class="text-2xl font-bold text-accent">3,000+</div>
              <div class="text-sm text-muted">{copy.booksInLibrary}</div>
            </div>
            <div class="card p-4 text-center">
              <div class="text-2xl font-bold text-accent">500+</div>
              <div class="text-sm text-muted">{copy.studentsServed}</div>
            </div>
          </div>
          <a href={`/${locale}/activities/community-library/`} class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium hover:bg-accent-hover transition-all duration-200">
            {copy.learnMore}
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
        <div>
          <VideoThumbnail videoUrl={settings.aboutVideoUrl} thumbnailUrl={settings.aboutVideoThumbnail} />
        </div>
      </div>
    </div>
  </section>

  {/* Our Approach */}
  <section class="py-16 sm:py-20 lg:py-24 bg-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="section-title mb-12 sm:mb-16">
        <h2>{copy.approachHeading} <span class="text-accent">{copy.approachAccent}</span></h2>
        <p>{copy.approachSubtitle}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {copy.whyNSF.map((item) => (
          <div class="text-center group">
            <div class="mx-auto mb-5 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-accent-soft text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-accent-text">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
            </div>
            <h3 class="text-lg font-semibold mb-3">{item.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Impact Numbers */}
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="section-title mb-12 sm:mb-16">
        <h2>{copy.impactHeading} <span class="text-accent">{copy.impactAccent}</span></h2>
        <p>{copy.impactSubtitle}</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {copy.impactNumbers.map((item) => <ImpactCard {...item} />)}
      </div>
    </div>
  </section>

  {/* Featured Activities */}
  {featuredActivities.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-title mb-12 sm:mb-16">
          <h2>{copy.activitiesHeading} <span class="text-accent">{copy.activitiesAccent}</span></h2>
          <p>{copy.activitiesSubtitle}</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredActivities.map((activity) => <ActivityCard activity={activity} />)}
        </div>
        <div class="text-center mt-10">
          <a href={`/${locale}/activities/`} class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-8 py-4 text-lg font-medium hover:bg-accent-hover transition-all duration-200">
            {copy.viewAllActivities}
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  {/* Testimonials */}
  {featuredTestimonials.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-title mb-12 sm:mb-16">
          <h2>{copy.testimonialsHeading} <span class="text-accent">{copy.testimonialsAccent}</span></h2>
          <p>{copy.testimonialsSubtitle}</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {featuredTestimonials.map((t) => (
            <TestimonialCard
              name={t.data.name}
              content={t.data.content}
              role={t.data.type}
              avatar={t.data.avatar}
              rating={t.data.rating}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Blog */}
  {latestPosts.length > 0 && (
    <section class="py-16 sm:py-20 lg:py-24 bg-section">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="section-title mb-12 sm:mb-16">
          <h2>{copy.blogHeading} <span class="text-accent">{copy.blogAccent}</span></h2>
          <p>{copy.blogSubtitle}</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {latestPosts.map((post) => <BlogCard post={post} />)}
        </div>
        <div class="text-center mt-10">
          <a href={`/${locale}/blog/`} class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-btn-secondary-border text-body px-6 py-3 font-medium hover:bg-btn-secondary-hover-bg hover:text-btn-secondary-hover-text transition-all duration-200">
            {copy.viewAllNews}
          </a>
        </div>
      </div>
    </section>
  )}

  {/* CTA */}
  <section class="py-16 sm:py-20 lg:py-24 relative overflow-hidden bg-inverse">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(5,150,105,0.1),transparent_60%)]" />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-inverted mb-4">
        {copy.ctaHeading}
      </h2>
      <p class="text-inverted/60 text-lg max-w-2xl mx-auto mb-8">
        {copy.ctaSubtitle}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={`/${locale}/donate/`} class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-8 py-4 text-lg font-medium hover:bg-accent-hover transition-all duration-200">
          {copy.ctaSupport}
        </a>
        <a href={`/${locale}/members/join/`} class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-inverted/30 text-inverted px-8 py-4 text-lg font-medium hover:bg-inverted hover:text-inverse transition-all duration-200">
          {copy.ctaJoin}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
