---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import VaultGate from "../../components/VaultGate.astro";
import { getCollection } from "astro:content";
import { formatINR } from "../../lib/matrix";
import { encryptWithPassword } from "../../lib/vault";
import { getMemberPassword } from "../../lib/secrets";

export async function getStaticPaths() {
  const members = await getCollection("members");
  return members.map((member) => ({
    params: { slug: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
const { data } = member;
const initials = data.name.split(" ").map((n) => n[0]).join("").slice(0, 2).toUpperCase();
const firstName = data.name.split(" ")[0];

const currentYear = new Date().getFullYear();
const years = Array.from({ length: 5 }, (_, i) => currentYear - 2 + i);

const allPayments = (await getCollection("payments"))
  .filter((p) => p.data.memberId === data.memberId)
  .map((p) => ({ memberId: data.memberId, year: p.data.year, month: p.data.month, status: p.data.status, amount: p.data.amount }));

const memberPassword = getMemberPassword(data.memberId);

const vault = await encryptWithPassword(
  JSON.stringify({
    memberId: data.memberId,
    subscriptionAmount: data.subscriptionAmount,
    payments: allPayments,
    contact: {
      mobile: data.mobile,
      email: data.email ?? "",
      city: data.city,
      state: data.state,
      occupation: data.occupation,
      bloodGroup: data.bloodGroup ?? "",
    },
  }),
  memberPassword,
);

const joinedAt = data.joiningDate;
const membershipYears = Math.max(0, currentYear - joinedAt.getFullYear());
const passwordConfigured = Boolean(memberPassword);
---

<BaseLayout searchable={false}
  title={`${data.name} — Member Portal`}
  description={`Personal member portal for ${data.name}`}
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path={`/members/${member.id}/`} class="mb-8" />

        <div class="card p-8 sm:p-10 mb-8 relative overflow-hidden">
          <div class="absolute -top-24 -right-24 h-64 w-64 rounded-full bg-accent/10 blur-3xl pointer-events-none"></div>
          <div class="relative flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div>
              <span class="inline-flex items-center gap-2 text-accent font-semibold text-sm uppercase tracking-widest mb-2">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
                Member Portal
              </span>
              <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-body">
                Welcome back, <span class="text-accent">{firstName}</span>
              </h1>
              <p class="text-muted mt-2 text-sm sm:text-base">
                {data.memberId} &middot; Member since {joinedAt.toLocaleDateString("en-US", { month: "long", year: "numeric" })}
                {membershipYears > 0 && <span> &middot; {membershipYears} year{membershipYears > 1 ? "s" : ""} with us</span>}
              </p>
            </div>
            <div class="flex flex-col items-start sm:items-end gap-3 shrink-0">
              <StatusBadge status={data.membershipStatus} size="md" />
              <span class="text-xs text-muted">{formatINR(data.subscriptionAmount)}/month &middot; {data.city}</span>
            </div>
          </div>
        </div>

        <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
          <div class="lg:col-span-1">
            <div class="card p-8 text-center">
              <div class="mx-auto h-24 w-24 rounded-full bg-accent/10 flex items-center justify-center overflow-hidden ring-4 ring-accent/10 mb-4">
                {data.photo ? (
                  <img src={data.photo} alt={data.name} class="h-full w-full object-cover" />
                ) : (
                  <span class="text-accent font-bold text-3xl">{initials}</span>
                )}
              </div>
              <h2 class="text-2xl font-bold text-body">{data.name}</h2>
              <p class="text-sm text-muted mt-1">{data.memberId}</p>
              <div class="mt-4 flex justify-center">
                <StatusBadge status={data.membershipStatus} size="md" />
              </div>
              <div id="member-contact" class="mt-6 pt-6 border-t border-border space-y-3 text-sm text-left hidden"></div>
              <p id="member-contact-locked" class="mt-6 pt-6 border-t border-border text-xs text-muted text-left flex items-center gap-2">
                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
                Contact details are private. Unlock below to view.
              </p>
              <a href={`/members/id-card/${member.id}/`} class="mt-4 flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl bg-accent text-accent-text text-sm font-semibold hover:bg-accent-hover transition-colors" target="_blank">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z" />
                </svg>
                Generate ID Card
              </a>
            </div>
          </div>

          <div class="lg:col-span-2 space-y-8">
            <VaultGate
              vault={vault}
              passwordConfigured={passwordConfigured}
              title="Payment Overview & Matrix"
              description="Your contribution details are encrypted and private. Enter your member password to view your payment history."
              placeholder="Enter your password"
              ariaLabel="Member password"
              contentSelector="vault-content"
              cacheKey={`member-${data.memberId}`}
            />

            <div id="vault-content" class="hidden">
              <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold text-body">Payment Overview</h2>
                <select id="payment-year" class="px-4 py-2 rounded-xl border border-input-border bg-card text-body text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors">
                  {years.map((y) => (
                    <option value={y} selected={y === currentYear}>{y}</option>
                  ))}
                </select>
              </div>

              <div id="payment-stats" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4"></div>

              <div class="card p-6">
                <div id="payment-matrix"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
<script>
  import { MONTHS_FULL, formatINR, buildPayments, PAYMENT_COLORS, PAYMENT_LABELS, paymentIcon } from "../../lib/matrix";

  interface PortalPayment {
    memberId: string;
    year: number;
    month: number;
    status: string;
    amount: number;
  }

  interface PortalContact {
    mobile: string;
    email: string;
    city: string;
    state: string;
    occupation: string;
    bloodGroup: string;
  }

  interface PortalVault {
    memberId: string;
    subscriptionAmount: number;
    payments: PortalPayment[];
    contact?: PortalContact;
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => (
      { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string
    ));
  }

  function renderContact(contact?: PortalContact) {
    const container = document.getElementById("member-contact");
    const locked = document.getElementById("member-contact-locked");
    if (locked) locked.classList.add("hidden");
    if (!container || !contact) return;

    const iconWrap = (path: string) =>
      `<svg class="h-5 w-5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">${path}</svg>`;
    const rows: string[] = [];

    if (contact.mobile) {
      rows.push(`<div class="flex items-center gap-3">${iconWrap('<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />')}<a href="tel:${escapeHtml(contact.mobile)}" class="text-muted hover:text-accent">${escapeHtml(contact.mobile)}</a></div>`);
    }
    if (contact.email) {
      rows.push(`<div class="flex items-center gap-3">${iconWrap('<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />')}<a href="mailto:${escapeHtml(contact.email)}" class="text-accent hover:underline truncate">${escapeHtml(contact.email)}</a></div>`);
    }
    if (contact.city || contact.state) {
      const loc = [contact.city, contact.state].filter(Boolean).join(", ");
      rows.push(`<div class="flex items-center gap-3">${iconWrap('<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />')}<span class="text-muted">${escapeHtml(loc)}</span></div>`);
    }
    if (contact.occupation) {
      rows.push(`<div class="flex items-center gap-3">${iconWrap('<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />')}<span class="text-muted">${escapeHtml(contact.occupation)}</span></div>`);
    }
    if (contact.bloodGroup) {
      rows.push(`<div class="flex items-center gap-3">${iconWrap('<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3" />')}<span class="text-muted">${escapeHtml(contact.bloodGroup)}</span></div>`);
    }

    if (rows.length === 0) {
      rows.push('<p class="text-xs text-muted">No contact details on file.</p>');
    }
    container.innerHTML = rows.join("");
    container.classList.remove("hidden");
  }

  (globalThis as any).__initVaultContent = (plaintext: string) => {
    const vaultData = JSON.parse(plaintext) as PortalVault;
    const memberId = vaultData.memberId;

    renderContact(vaultData.contact);

    const yearSelect = document.getElementById("payment-year") as HTMLSelectElement;
    const statsContainer = document.getElementById("payment-stats")!;
    const matrixContainer = document.getElementById("payment-matrix")!;

    function render(year: number) {
      const payments = buildPayments(vaultData.payments, memberId, year);
      const amount = vaultData.subscriptionAmount;
      const now = new Date();
      const currentMonth = now.getMonth();
      const currentYear = now.getFullYear();
      const targetMonth = year < currentYear ? 11 : (year === currentYear ? currentMonth : -1);

      let totalPaid = 0;
      let totalDue = 0;
      let totalPartial = 0;

      for (let m = 0; m <= targetMonth; m++) {
        const s = payments[`${year}-${m}`];
        if (s === "paid") totalPaid++;
        else if (s === "due") totalDue++;
        else if (s === "partial") totalPartial++;
      }

      const currentKey = `${currentYear}-${currentMonth}`;
      const currentStatus = payments[currentKey] || "not-updated";
      const currentMonthName = MONTHS_FULL[currentMonth];

      const statusIcon = currentStatus === "paid" ? "✓" : currentStatus === "partial" ? "~" : "—";
      const statusColor = currentStatus === "paid" ? "bg-success" : currentStatus === "partial" ? "bg-warning" : "bg-muted/20";

      const totalPending = totalDue + totalPartial;
      const totalPaidAmount = totalPaid * amount;
      const totalDueAmount = totalPending * amount;

      statsContainer.innerHTML = `
        <div class="card p-5 text-center">
          <div class="text-3xl font-black">
            <span class="inline-flex items-center justify-center h-10 w-10 rounded-full text-sm font-bold text-white ${statusColor}">${statusIcon}</span>
          </div>
          <p class="text-xs uppercase tracking-wider text-muted mt-2">${currentMonthName} Status</p>
        </div>
        <div class="card p-5 text-center">
          <div class="text-3xl font-black text-warning">${totalPending}</div>
          <p class="text-xs uppercase tracking-wider text-muted mt-2">Pending Months</p>
        </div>
        <div class="card p-5 text-center">
          <div class="text-3xl font-black text-success">${formatINR(totalPaidAmount)}</div>
          <p class="text-xs uppercase tracking-wider text-muted mt-2">Amount Paid</p>
        </div>
        <div class="card p-5 text-center">
          <div class="text-3xl font-black text-error">${formatINR(totalDueAmount)}</div>
          <p class="text-xs uppercase tracking-wider text-muted mt-2">Amount Due</p>
        </div>
      `;

      let totalCollected = 0;
      const cells = [];

      for (let i = 0; i < 12; i++) {
        const key = `${year}-${i}`;
        const status = payments[key] || "not-updated";
        const color = PAYMENT_COLORS[status] || "text-muted";
        const label = PAYMENT_LABELS[status] || "?";

        if (status === "paid") totalCollected += amount;
        else if (status === "partial") totalCollected += Math.floor(amount / 2);

        cells.push(`<td class="text-center py-3 px-2">
          <span class="inline-flex items-center justify-center text-[12px] font-normal ${color}" title="${label}">
            ${paymentIcon(status)}
          </span>
        </td>`);
      }

      const yearPayments = vaultData.payments.filter((p) => p.year === year);
      const duplicates: Record<string, PortalPayment[]> = {};
      for (const p of yearPayments) {
        const k = `${p.month}`;
        if (!duplicates[k]) duplicates[k] = [];
        duplicates[k].push(p);
      }
      const duplicateKeys = Object.keys(duplicates).filter((k) => duplicates[k].length > 1);

      matrixContainer.innerHTML = `
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-body">Payment Matrix — ${year}</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm whitespace-nowrap">
            <thead>
              <tr class="bg-accent-soft/50 border-b border-border">
                <th class="text-left py-3 px-4 font-medium text-muted">Month</th>
                <th class="text-center py-3 px-4 font-medium text-muted">Status</th>
                <th class="text-right py-3 px-4 font-medium text-muted">Amount</th>
              </tr>
            </thead>
            <tbody>
              ${MONTHS_FULL.map((month, i) => {
                const key = `${year}-${i}`;
                const status = payments[key] || "not-updated";
                const color = PAYMENT_COLORS[status] || "text-muted";
                const label = PAYMENT_LABELS[status] || "?";
                let rowAmount = 0;
                if (status === "paid") rowAmount = amount;
                else if (status === "partial") rowAmount = Math.floor(amount / 2);
                return `<tr class="border-b border-border/50 hover:bg-accent-soft/30 transition-colors">
                  <td class="py-3 px-4 font-medium text-body">${month}</td>
                  <td class="text-center py-3 px-4">
                    <span class="inline-flex items-center justify-center text-[12px] font-normal ${color}" title="${label}">${paymentIcon(status)}</span>
                  </td>
                  <td class="text-right py-3 px-4 text-muted">${rowAmount > 0 ? formatINR(rowAmount) : "\u2014"}</td>
                </tr>`;
              }).join("")}
            </tbody>
            <tfoot>
              <tr class="bg-accent-soft/30 border-t-2 border-border font-semibold">
                <td class="py-3 px-4 text-body">Total</td>
                <td></td>
                <td class="text-right py-3 px-4 text-body">${formatINR(totalCollected)}</td>
              </tr>
            </tfoot>
          </table>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-muted">
          <span class="flex items-center gap-1.5"><span class="inline-flex items-center justify-center h-4 w-4 rounded-full bg-success text-white text-[10px] font-bold">\u2713</span> Paid</span>
          <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-1 bg-muted/30"></span> Due</span>
          <span class="flex items-center gap-1.5"><span class="inline-flex items-center justify-center h-4 w-4 rounded-full bg-warning text-white text-[10px] font-bold">P</span> Partial</span>
          <span class="flex items-center gap-1.5"><span class="inline-block h-1 w-1 rounded-full bg-muted/30"></span> Not Updated</span>
        </div>
        ${duplicateKeys.length > 0 ? `
          <div class="mt-4 p-3 rounded-xl bg-error/10 border border-error/20">
            <p class="text-xs font-semibold text-error">⚠ Duplicate payments found for:</p>
            <ul class="mt-1 text-xs text-error/80">
              ${duplicateKeys.map((k) => {
                return `<li>${MONTHS_FULL[parseInt(k)]} ${year} — ${duplicates[k].length} entries</li>`;
              }).join("")}
            </ul>
          </div>
        ` : ""}
        ${yearPayments.length > 0 ? `
          <div class="mt-4 p-3 rounded-xl bg-accent/5 border border-accent/20">
            <p class="text-xs font-semibold text-accent">✓ ${yearPayments.length} CMS payment record(s) for ${year}</p>
            <ul class="mt-1 text-xs text-muted space-y-0.5">
              ${yearPayments.sort((a, b) => a.month - b.month).map((p) =>
                `<li>${MONTHS_FULL[p.month]} — ${p.status === "paid" ? "Paid" : "Partial"} (₹${p.amount.toLocaleString("en-IN")})</li>`
              ).join("")}
            </ul>
          </div>
        ` : ""}
      `;
    }

    yearSelect.addEventListener("change", () => render(parseInt(yearSelect.value)));
    render(parseInt(yearSelect.value));
  };
</script>
</BaseLayout>
