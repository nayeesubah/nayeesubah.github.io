---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { getCollection } from "astro:content";
import { formatINR, targetMonth } from "../../lib/matrix";

const members = await getCollection("members");
const totalMembers = members.length;
const activeMembers = members.filter((m) => m.data.membershipStatus === "active");
const inactiveMembers = members.filter((m) => m.data.membershipStatus === "inactive");
const activeCount = activeMembers.length;

const plans = [...new Set(members.map((m) => m.data.subscriptionAmount))].sort((a, b) => a - b);

const allPayments = (await getCollection("payments")).map((p) => ({
  memberId: p.data.memberId,
  year: p.data.year,
  month: p.data.month,
  status: p.data.status,
  amount: p.data.amount,
}));
const paymentsByMember: Record<string, { year: number; month: number; status: string }[]> = {};
for (const p of allPayments) {
  const mid = p.memberId;
  if (!paymentsByMember[mid]) paymentsByMember[mid] = [];
  paymentsByMember[mid].push({ year: p.year, month: p.month, status: p.status });
}

const currentMonth = new Date().getMonth();
const currentYear = new Date().getFullYear();
const year = currentYear;

function getPaymentStatus(memberId: string, year: number, month: number): string {
  const real = paymentsByMember[memberId]?.find((p) => p.year === year && p.month === month);
  if (real) return real.status;
  if (month <= targetMonth(year, currentYear, currentMonth)) {
    return "due";
  }
  return "not-updated";
}

let paidThisMonth = 0;
let pendingThisMonth = 0;
let totalMonthlyCollection = 0;
let totalAnnualCollection = 0;
let totalOutstanding = 0;

for (const m of members) {
  const { subscriptionAmount, membershipStatus, memberId } = m.data;
  if (membershipStatus !== "active") continue;
  totalAnnualCollection += subscriptionAmount * 12;
  totalMonthlyCollection += subscriptionAmount;
  const status = getPaymentStatus(memberId, year, currentMonth);
  if (status === "paid") paidThisMonth++;
  else pendingThisMonth++;
  if (status === "due") totalOutstanding += subscriptionAmount;
}

const collectionPercentage = activeCount > 0
  ? Math.round((paidThisMonth / activeCount) * 100)
  : 0;

const newestMembers = members
  .sort((a, b) => new Date(b.data.joiningDate).getTime() - new Date(a.data.joiningDate).getTime())
  .slice(0, 5);
---

<BaseLayout
  title="Member Dashboard"
  description="Contribution dashboard for Nayee Subah Foundation membership."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/members/dashboard/" class="mb-8" />
        <div class="max-w-3xl mb-12">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Dashboard</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Contribution <span class="text-accent">Dashboard</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Real-time overview of membership and contributions. Data reflects the current billing period.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <div class="card p-6 text-center group">
            <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
            </div>
            <div class="text-3xl sm:text-4xl font-black text-accent">{totalMembers}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Total Members</div>
          </div>
          <div class="card p-6 text-center group">
            <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            </div>
            <div class="text-3xl sm:text-4xl font-black text-accent">{activeCount}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Active Members</div>
          </div>
          <div class="card p-6 text-center group">
            <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" /></svg>
            </div>
            <div class="text-3xl sm:text-4xl font-black text-warning">{inactiveMembers.length}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Inactive</div>
          </div>
          <div class="card p-6 text-center group">
            <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            </div>
            <div class="text-3xl sm:text-4xl font-black text-accent">{paidThisMonth}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Paid This Month</div>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <div class="card p-6 text-center group">
            <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 21.75h16.5A2.25 2.25 0 0 0 22.5 19.5v-15a2.25 2.25 0 0 0-2.25-2.25H3.75A2.25 2.25 0 0 0 1.5 4.5v15a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
            </div>
            <div class="text-3xl sm:text-4xl font-black text-accent">{formatINR(totalMonthlyCollection)}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Monthly Target</div>
          </div>
          <div class="card p-6 text-center group">
            <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2.25 8.25 6.75 12 4.5l3.75 2.25L12 2.25ZM12 2.25v12.75M12 15.75a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" /></svg>
            </div>
            <div class="text-3xl sm:text-4xl font-black text-accent">{formatINR(totalAnnualCollection)}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Annual Target</div>
          </div>
          <div class="card p-6 text-center group">
            <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
            </div>
            <div class="text-3xl sm:text-4xl font-black text-error">{formatINR(totalOutstanding)}</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Outstanding Amount</div>
          </div>
          <div class="card p-6 text-center group">
            <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>
            </div>
            <div class="text-3xl sm:text-4xl font-black text-accent">{collectionPercentage}%</div>
            <div class="text-xs uppercase tracking-wider text-muted mt-1">Collection Rate</div>
          </div>

          {pendingThisMonth > 0 && (
            <div class="card p-6 text-center group border-2 border-warning/30">
              <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-warning/10 text-warning">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
              </div>
              <div class="text-3xl sm:text-4xl font-black text-warning">{pendingThisMonth}</div>
              <div class="text-xs uppercase tracking-wider text-muted mt-1">Pending This Month</div>
            </div>
          )}
        </div>

        <div class="grid lg:grid-cols-2 gap-8">
          <div class="card p-6">
            <h2 class="text-xl font-bold mb-6">Newest Members</h2>
            {newestMembers.length > 0 ? (
              <div class="space-y-3">
                {newestMembers.map((m) => {
                  const { data } = m;
                  const initials = data.name.split(" ").map((n) => n[0]).join("").slice(0, 2).toUpperCase();
                  return (
                    <a href={`/members/${m.id}/`} class="flex items-center gap-4 p-3 rounded-xl hover:bg-accent-soft/30 transition-colors -mx-3">
                      <div class="h-10 w-10 rounded-full bg-accent/10 flex items-center justify-center overflow-hidden ring-2 ring-accent/10 shrink-0">
                        {data.photo ? (
                          <img src={data.photo} alt={data.name} class="h-full w-full object-cover" />
                        ) : (
                          <span class="text-accent font-bold text-sm">{initials}</span>
                        )}
                      </div>
                      <div class="flex-1 min-w-0">
                        <p class="font-medium truncate">{data.name}</p>
                        <p class="text-xs text-muted">{data.memberId} &middot; {data.city}</p>
                      </div>
                      <div class="text-right shrink-0">
                        <StatusBadge status={data.membershipStatus} size="sm" />
                        <p class="text-xs text-muted mt-1">{new Date(data.joiningDate).toLocaleDateString("en-IN")}</p>
                      </div>
                    </a>
                  );
                })}
              </div>
            ) : (
              <p class="text-muted text-sm py-8 text-center">No members registered yet.</p>
            )}
          </div>

          <div class="card p-6">
            <h2 class="text-xl font-bold mb-6">Subscription Plan Distribution</h2>
            <div class="space-y-4">
              {plans.map((plan) => {
                const count = members.filter((m) => m.data.subscriptionAmount === plan).length;
                const pct = totalMembers > 0 ? Math.round((count / totalMembers) * 100) : 0;
                return (
                  <div>
                    <div class="flex items-center justify-between text-sm mb-1.5">
                      <span class="font-medium">₹{plan}/month</span>
                      <span class="text-muted">{count} members ({pct}%)</span>
                    </div>
                    <div class="h-2.5 rounded-full bg-section overflow-hidden">
                      <div class="h-full rounded-full bg-accent transition-all" style={`width: ${pct}%`}></div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        <div class="mt-8 grid lg:grid-cols-2 gap-8">
          <div class="card p-6">
            <h2 class="text-xl font-bold mb-6">City-wise Distribution</h2>
            <div class="space-y-3">
              {[...new Set(members.map((m) => m.data.city))].sort().map((city) => {
                const count = members.filter((m) => m.data.city === city).length;
                const pct = Math.round((count / totalMembers) * 100);
                return (
                  <div class="flex items-center gap-4">
                    <span class="text-sm font-medium w-24 shrink-0">{city}</span>
                    <div class="flex-1 h-2 rounded-full bg-section overflow-hidden">
                      <div class="h-full rounded-full bg-accent/60" style={`width: ${pct}%`}></div>
                    </div>
                    <span class="text-xs text-muted w-8 text-right">{count}</span>
                  </div>
                );
              })}
            </div>
          </div>

          <div class="card p-6">
            <h2 class="text-xl font-bold mb-6">Upcoming Renewals</h2>
            <div class="flex flex-col items-center justify-center py-8 text-center">
              <svg class="h-12 w-12 text-muted mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182" />
              </svg>
              <p class="text-muted text-sm">Auto-renewal is enabled for all active members.</p>
              <p class="text-muted text-xs mt-1">Renewal reminders will be sent automatically.</p>
            </div>
          </div>
        </div>

        {members.length === 0 && (
          <div class="text-center py-16">
            <p class="text-muted text-lg">No data to display. Add member content to get started.</p>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
