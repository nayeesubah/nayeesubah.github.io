---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { getCollection } from "astro:content";
import { formatINR, SUBSCRIPTION_PLANS } from "../../lib/site";

const members = await getCollection("members");
const cities = [...new Set(members.map((m) => m.data.city))].sort();
const plans = [...new Set(members.map((m) => m.data.subscriptionAmount))].sort((a, b) => a - b);
---

<BaseLayout
  title="Member Directory — Nayee Subah Foundation Members"
  description="Browse the Nayee Subah Foundation member directory. Search and filter our registered members by name, city, status, or subscription plan."
>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <Breadcrumb path="/members/" class="mb-8" />
        <div class="max-w-3xl mb-8">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Community</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
            Member <span class="text-accent">Directory</span>
          </h1>
          <p class="text-muted text-lg leading-relaxed">
            Connect with the members of Nayee Subah Foundation. Search, filter, and explore the community.
          </p>
        </div>

        <nav class="flex flex-wrap items-center gap-2 mb-10 border-b border-border pb-4">
          <a href="/members/" class="px-4 py-2 rounded-lg text-sm font-medium bg-accent text-accent-text transition-colors">Directory</a>
          <a href="/members/dashboard/" class="px-4 py-2 rounded-lg text-sm font-medium text-muted hover:text-body hover:bg-accent-soft transition-colors">Dashboard</a>
          <a href="/members/join/" class="px-4 py-2 rounded-lg text-sm font-medium text-muted hover:text-body hover:bg-accent-soft transition-colors">Join</a>
        </nav>

        <div id="member-controls" class="flex flex-wrap items-center gap-4 mb-8">
          <div class="relative flex-1 min-w-[200px] max-w-sm">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-muted pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            <input
              type="text"
              id="member-search"
              placeholder="Search by name, ID, or city..."
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-input-border bg-card text-body text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors"
            />
          </div>

          <select id="filter-status" class="px-4 py-2.5 rounded-xl border border-input-border bg-card text-body text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors">
            <option value="all">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="suspended">Suspended</option>
          </select>

          <select id="filter-plan" class="px-4 py-2.5 rounded-xl border border-input-border bg-card text-body text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors">
            <option value="all">All Plans</option>
            {plans.map((p) => (
              <option value={p}>{formatINR(p)}/month</option>
            ))}
          </select>

          <select id="filter-city" class="px-4 py-2.5 rounded-xl border border-input-border bg-card text-body text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-colors">
            <option value="all">All Cities</option>
            {cities.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>

          <div class="flex items-center gap-1 rounded-xl border border-input-border bg-card p-1" role="group" aria-label="View toggle">
            <button id="view-grid" class="view-btn px-3 py-2 rounded-lg text-sm font-medium transition-colors bg-accent text-accent-text" data-view="grid" aria-pressed="true">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
              </svg>
            </button>
            <button id="view-table" class="view-btn px-3 py-2 rounded-lg text-sm font-medium transition-colors bg-accent-soft text-accent hover:bg-accent hover:text-accent-text" data-view="table" aria-pressed="false">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0 1 12 18.375m0 0V5.625m0 12.75c-.621 0-1.125-.504-1.125-1.125m0-12.75c0-.621.504-1.125 1.125-1.125h7.5c.621 0 1.125.504 1.125 1.125m-9.75 0h-7.5" />
              </svg>
            </button>
          </div>
        </div>

        <div id="members-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {members.map((member) => {
            const { data } = member;
            const initials = data.name.split(" ").map((n) => n[0]).join("").slice(0, 2).toUpperCase();
            return (
              <a
                href={`/members/${member.id}/`}
                class="member-card card-hover block p-6"
                data-name={data.name.toLowerCase()}
                data-id={data.memberId.toLowerCase()}
                data-city={data.city.toLowerCase()}
                data-status={data.membershipStatus}
                data-plan={data.subscriptionAmount}
              >
                <div class="flex items-center gap-4 mb-4">
                  <div class="h-12 w-12 rounded-full bg-accent/10 flex items-center justify-center overflow-hidden ring-2 ring-accent/10 shrink-0">
                    {data.photo ? (
                      <img src={data.photo} alt={data.name} class="h-full w-full object-cover" />
                    ) : (
                      <span class="text-accent font-bold text-lg">{initials}</span>
                    )}
                  </div>
                  <div class="min-w-0">
                    <h3 class="font-semibold text-body truncate">{data.name}</h3>
                    <p class="text-xs text-muted">{data.memberId}</p>
                  </div>
                </div>
                <div class="space-y-2 text-sm">
                  <div class="flex items-center gap-2 text-muted">
                    <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                    </svg>
                    <span class="truncate">{data.city}, {data.state}</span>
                  </div>
                  <div class="flex items-center gap-2 text-muted">
                    <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span>{formatINR(data.subscriptionAmount)}/mo</span>
                  </div>
                </div>
                <div class="mt-4 flex items-center justify-between">
                  <StatusBadge status={data.membershipStatus} size="sm" />
                </div>
              </a>
            );
          })}
        </div>

        <div id="members-table" class="overflow-x-auto rounded-xl border border-border hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-accent-soft/50 border-b border-border">
                <th class="text-left py-3 px-4 font-medium text-muted">Member</th>
                <th class="text-left py-3 px-4 font-medium text-muted">Member ID</th>
                <th class="text-left py-3 px-4 font-medium text-muted">City</th>
                <th class="text-left py-3 px-4 font-medium text-muted">State</th>
                <th class="text-left py-3 px-4 font-medium text-muted">Occupation</th>
                <th class="text-left py-3 px-4 font-medium text-muted">Status</th>
                <th class="text-right py-3 px-4 font-medium text-muted">Subscription</th>
              </tr>
            </thead>
            <tbody>
              {members.map((member) => {
                const { data } = member;
                return (
                  <tr
                    class="member-row border-b border-border/50 hover:bg-accent-soft/30 transition-colors cursor-pointer"
                    data-name={data.name.toLowerCase()}
                    data-id={data.memberId.toLowerCase()}
                    data-city={data.city.toLowerCase()}
                    data-status={data.membershipStatus}
                    data-plan={data.subscriptionAmount}
                    data-href={`/members/${member.id}/`}
                  >
                    <td class="py-3 px-4">
                      <div class="flex items-center gap-3">
                        <div class="h-8 w-8 rounded-full bg-accent/20 flex items-center justify-center text-accent font-bold text-xs shrink-0">
                          {data.name.split(" ").map((n) => n[0]).join("").slice(0, 2).toUpperCase()}
                        </div>
                        <span class="font-medium text-body">{data.name}</span>
                      </div>
                    </td>
                    <td class="py-3 px-4 text-muted">{data.memberId}</td>
                    <td class="py-3 px-4 text-muted">{data.city}</td>
                    <td class="py-3 px-4 text-muted">{data.state}</td>
                    <td class="py-3 px-4 text-muted">{data.occupation}</td>
                    <td class="py-3 px-4">
                      <StatusBadge status={data.membershipStatus} size="sm" />
                    </td>
                    <td class="py-3 px-4 text-right font-medium">{formatINR(data.subscriptionAmount)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        {members.length === 0 && (
          <div class="text-center py-20">
            <svg class="mx-auto h-16 w-16 text-muted mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
            </svg>
            <p class="text-muted text-lg">No members found. Add member content to get started.</p>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById("member-search");
  const filterStatus = document.getElementById("filter-status");
  const filterPlan = document.getElementById("filter-plan");
  const filterCity = document.getElementById("filter-city");
  const viewBtns = document.querySelectorAll(".view-btn");
  const grid = document.getElementById("members-grid");
  const table = document.getElementById("members-table");

  function filterMembers() {
    const query = searchInput?.value.toLowerCase().trim() || "";
    const status = filterStatus?.value || "all";
    const plan = filterPlan?.value || "all";
    const city = filterCity?.value.toLowerCase() || "all";

    const cards = document.querySelectorAll(".member-card");
    const rows = document.querySelectorAll(".member-row");

    cards.forEach((card) => {
      const match =
        (query === "" || card.dataset.name.includes(query) || card.dataset.id.includes(query) || card.dataset.city.includes(query)) &&
        (status === "all" || card.dataset.status === status) &&
        (plan === "all" || card.dataset.plan === plan) &&
        (city === "all" || card.dataset.city === city);
      card.style.display = match ? "" : "none";
    });

    rows.forEach((row) => {
      const match =
        (query === "" || row.dataset.name.includes(query) || row.dataset.id.includes(query) || row.dataset.city.includes(query)) &&
        (status === "all" || row.dataset.status === status) &&
        (plan === "all" || row.dataset.plan === plan) &&
        (city === "all" || row.dataset.city === city);
      row.style.display = match ? "" : "none";
    });
  }

  searchInput?.addEventListener("input", filterMembers);
  filterStatus?.addEventListener("change", filterMembers);
  filterPlan?.addEventListener("change", filterMembers);
  filterCity?.addEventListener("change", filterMembers);

  table?.addEventListener("click", (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>(".member-row");
    const href = row?.dataset.href;
    if (href) window.location.href = href;
  });

  viewBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const view = btn.dataset.view;
      viewBtns.forEach((b) => {
        b.className = b.className
          .replace("bg-accent text-accent-text", "bg-accent-soft text-accent hover:bg-accent hover:text-accent-text");
        b.setAttribute("aria-pressed", "false");
      });
      btn.className = btn.className
        .replace("bg-accent-soft text-accent hover:bg-accent hover:text-accent-text", "bg-accent text-accent-text");
      btn.setAttribute("aria-pressed", "true");

      if (view === "grid") {
        grid.classList.remove("hidden");
        table.classList.add("hidden");
      } else {
        grid.classList.add("hidden");
        table.classList.remove("hidden");
      }
    });
  });
</script>
