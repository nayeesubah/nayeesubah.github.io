---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const members = await getCollection("members");
  return members.map((member) => ({
    params: { memberId: member.data.memberId },
    props: { member },
  }));
}

const { member } = Astro.props;
const { data } = member;
const initials = data.name.split(" ").map((n) => n[0]).join("").slice(0, 2).toUpperCase();
const joinedDate = new Date(data.joiningDate).toLocaleDateString("en-IN", {
  year: "numeric", month: "long", day: "numeric",
});
---

<BaseLayout title={`Verify — ${data.memberId}`} description={`Verification page for ${data.name}`} seo={{ noIndex: true }}>
  <div class="pt-24">
    <section class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <span class="text-accent font-semibold text-sm uppercase tracking-widest">Member Verification</span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mt-3">Verify Identity</h1>
          <p class="text-muted mt-2">This page confirms the authenticity of the member's ID card.</p>
        </div>

        <div class="card p-8 sm:p-10 text-center">
          <div class="mx-auto h-28 w-28 rounded-full bg-accent/10 flex items-center justify-center overflow-hidden ring-4 ring-accent/20 mb-6">
            {data.photo ? (
              <img src={data.photo} alt={data.name} class="h-full w-full object-cover" />
            ) : (
              <span class="text-accent font-bold text-4xl">{initials}</span>
            )}
          </div>

          <h2 class="text-2xl font-bold text-body">{data.name}</h2>
          <p class="text-accent font-mono text-lg font-semibold mt-1">{data.memberId}</p>

          <div class="mt-6 inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium"
            class:list={{
              "bg-success/10 text-success": data.membershipStatus === "active",
              "bg-error/10 text-error": data.membershipStatus === "inactive" || data.membershipStatus === "suspended",
            }}
          >
            <span class="inline-block h-2 w-2 rounded-full"
              class:list={{
                "bg-success": data.membershipStatus === "active",
                "bg-error": data.membershipStatus === "inactive" || data.membershipStatus === "suspended",
              }}
            ></span>
            {data.membershipStatus === "active" ? "Active Member" : data.membershipStatus.charAt(0).toUpperCase() + data.membershipStatus.slice(1)}
          </div>

          <div class="mt-8 grid grid-cols-2 gap-4 text-sm">
            <div class="bg-accent-soft rounded-xl p-4">
              <p class="text-muted text-xs uppercase tracking-wider">Member Since</p>
              <p class="font-semibold text-body mt-1">{joinedDate}</p>
            </div>
            <div class="bg-accent-soft rounded-xl p-4">
              <p class="text-muted text-xs uppercase tracking-wider">Location</p>
              <p class="font-semibold text-body mt-1">{data.city}, {data.state}</p>
            </div>
            <div class="bg-accent-soft rounded-xl p-4">
              <p class="text-muted text-xs uppercase tracking-wider">Occupation</p>
              <p class="font-semibold text-body mt-1">{data.occupation}</p>
            </div>
            <div class="bg-accent-soft rounded-xl p-4">
              <p class="text-muted text-xs uppercase tracking-wider">Status</p>
              <p class="font-semibold text-body mt-1">
                {data.membershipStatus === "active" ? "Active" : data.membershipStatus.charAt(0).toUpperCase() + data.membershipStatus.slice(1)}
              </p>
            </div>
          </div>

          <div class="mt-8 p-4 rounded-xl bg-success/5 border border-success/20">
            <p class="text-sm text-success font-medium flex items-center justify-center gap-2">
              <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              This member is verified with Nayee Subah Foundation
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
