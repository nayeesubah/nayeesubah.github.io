---
import type { CollectionEntry } from "astro:content";
import { calculateReadingTime, formatShortDate } from "../lib/site";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { data } = post;
const readingTime = calculateReadingTime(post.body || data.excerpt);
---

<article class="rounded-2xl bg-card border-border shadow-sm hover:shadow-lg hover:border-accent-border hover:-translate-y-1 transition-all duration-300 overflow-hidden group">
  <div class="relative aspect-[16/10] overflow-hidden bg-muted/5">
    <img
      src={data.image || "/images/blog-placeholder.svg"}
      alt={data.title}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-semibold bg-accent text-accent-text">
      {data.category}
    </div>
  </div>

  <div class="p-5">
    <div class="flex items-center gap-2 text-xs text-muted mb-3 flex-wrap">
      <time datetime={data.date.toISOString()}>{formatShortDate(data.date)}</time>
      <span>•</span>
      <span>{data.author}</span>
      <span>•</span>
      <span>{readingTime} min read</span>
    </div>

    <h3 class="text-lg font-semibold mb-2 line-clamp-2">
      <a href={`/blog/${post.id}/`} class="hover:text-accent transition-colors">
        {data.title}
      </a>
    </h3>

    <p class="text-muted text-sm leading-relaxed line-clamp-3 mb-4">
      {data.excerpt}
    </p>

    {data.tags && data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {data.tags.slice(0, 3).map((tag) => (
          <a
            href={`/blog/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`}
            class="px-2 py-0.5 rounded-md bg-muted/10 text-xs text-muted hover:bg-accent-soft hover:text-accent transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    <a
      href={`/blog/${post.id}/`}
      class="inline-flex items-center gap-1 text-sm font-medium text-accent hover:text-accent-hover transition-colors"
      aria-label={`Read more about ${data.title}`}
    >
      Read More
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>
</article>
