---
import StatusBadge from "./StatusBadge.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  event: CollectionEntry<"events">;
}

const { event } = Astro.props;
const { data } = event;

function formatDate(d: Date) {
  return d.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
}

const now = Date.now();
const eventTime = data.date.getTime();
const diffDays = Math.ceil((eventTime - now) / (1000 * 60 * 60 * 24));
const isUpcoming = data.status === "upcoming" || data.status === "ongoing";
const hideCountdown = data.cardDisplay?.hideCountdown === true;
const showCountdown = isUpcoming && diffDays >= 0 && !hideCountdown;
const cardDescription = data.cardDisplay?.shortDescription || data.description;
const badgeText = data.cardDisplay?.badgeText || null;

const googleCalUrl = `https://www.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(data.title)}&dates=${data.date.toISOString().replace(/[-:]/g, "").split(".")[0]}Z/${data.date.toISOString().replace(/[-:]/g, "").split(".")[0]}Z&details=${encodeURIComponent(data.description)}&location=${encodeURIComponent(data.venue)}`;
---

<div class="card-hover card overflow-hidden group">
  <a href={`/events/${event.id}/`} class="block">
    <div class="relative">
      {data.image ? (
        <div class="aspect-[16/9] overflow-hidden">
          <img src={data.image} alt={data.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
        </div>
      ) : (
        <div class="aspect-[16/9] bg-gradient-to-br from-accent-soft to-section flex items-center justify-center">
          <svg class="h-16 w-16 text-accent/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
        </div>
      )}
      {badgeText && (
        <div class="absolute top-3 right-3 px-2 py-0.5 rounded-md bg-accent text-accent-text text-[10px] font-bold uppercase tracking-wider">
          {badgeText}
        </div>
      )}
      {data.featured && !badgeText && (
        <div class="absolute top-3 right-3 px-2 py-0.5 rounded-md bg-warning text-warning-text text-[10px] font-bold uppercase tracking-wider">
          Featured
        </div>
      )}
    </div>
    <div class="p-5">
      <div class="flex items-center justify-between mb-3">
        <StatusBadge status={data.status} />
        <span class="text-xs text-muted">{formatDate(data.date)}</span>
      </div>
      <h3 class="font-semibold mb-2 line-clamp-2 group-hover:text-accent transition-colors">{data.title}</h3>
      <p class="text-muted text-sm flex items-center gap-1.5 mb-3">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>
        {data.venue}
      </p>
      <p class="text-muted text-sm leading-relaxed line-clamp-2">{cardDescription}</p>
    </div>
  </a>
  {(showCountdown || data.registerLink) && (
    <div class="px-5 pb-5 pt-0 border-t border-border mt-0">
      <div class="flex flex-wrap items-center gap-2 pt-3">
        {showCountdown && (
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-accent bg-accent-soft/50 px-3 py-1.5 rounded-full">
            <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse" />
            {diffDays === 0 ? "Today!" : diffDays === 1 ? "Tomorrow!" : `${diffDays} days away`}
          </span>
        )}
        {data.registerLink && (
          <a href={data.registerLink} target="_blank" rel="noopener noreferrer" class="text-xs font-medium text-accent hover:text-accent-hover underline underline-offset-2" onclick="event.stopPropagation()">
            Register Now →
          </a>
        )}
        <a href={googleCalUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-muted hover:text-accent transition-colors ml-auto" onclick="event.stopPropagation()">
          + Add to Calendar
        </a>
      </div>
    </div>
  )}
</div>
