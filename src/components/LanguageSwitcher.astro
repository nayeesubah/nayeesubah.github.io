---
import { languages, defaultLang } from "../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale || defaultLang;
const pathname = Astro.url.pathname
  .replace(/^\/(en|hi|ur)\//, "/")
  .replace(/^\//, "");
const currentPath = pathname === "" ? "" : pathname;

const short = { en: "EN", hi: "हि", ur: "اُردو" } as const;

const links = Object.keys(languages).map((code) => ({
  code,
  label: languages[code as keyof typeof languages],
  href: getRelativeLocaleUrl(code, currentPath),
  current: code === locale,
}));
---

<details class="relative lang-switcher" aria-label={languages[locale as keyof typeof languages]}>
  <summary class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-medium text-body/80 hover:text-accent hover:bg-accent-soft transition-colors cursor-pointer list-none">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3a15 15 0 010 18 15 15 0 010-18z" />
    </svg>
    <span>{short[locale as keyof typeof short]}</span>
    <svg class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </summary>
  <div class="absolute right-0 top-full mt-1 z-50 min-w-36 rounded-xl border border-border bg-card shadow-lg py-1">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={link.current ? "true" : undefined}
          class={`flex items-center justify-between gap-3 px-4 py-2 text-sm transition-colors ${
            link.current
              ? "text-accent font-medium"
              : "text-body/70 hover:text-accent hover:bg-accent-soft"
          }`}
        >
          {link.label}
          {
            link.current && (
              <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            )
          }
        </a>
      ))
    }
  </div>
</details>

<style>
  .lang-switcher summary::-webkit-details-marker {
    display: none;
  }
</style>
