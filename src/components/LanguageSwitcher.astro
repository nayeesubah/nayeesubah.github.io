---
import { languages, defaultLang, t, stripLocalePrefix, type LanguageCode } from "../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";

const currentLocale = (Astro.currentLocale || defaultLang) as LanguageCode;
const localePath = stripLocalePrefix(Astro.url.pathname);
const codes = Object.keys(languages) as LanguageCode[];
---

<div class="relative" data-lang-switcher>
  <button
    type="button"
    data-lang-switcher-btn
    class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-medium text-body/80 hover:text-accent hover:bg-accent-soft transition-colors"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={t(currentLocale, "lang.label")}
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
    </svg>
    <span>{languages[currentLocale]}</span>
    <svg class="h-3.5 w-3.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
  </button>
  <div
    data-lang-switcher-menu
    class="hidden absolute right-0 rtl:right-auto rtl:left-0 top-full mt-2 min-w-36 rounded-xl border border-border bg-card shadow-lg py-1.5 z-50"
    role="menu"
  >
    {codes.map((code) => (
      <a
        href={getRelativeLocaleUrl(code, localePath)}
        lang={code}
        role="menuitem"
        aria-current={code === currentLocale ? "true" : undefined}
        class:list={[
          "block px-4 py-2 text-sm hover:bg-accent-soft hover:text-accent transition-colors",
          code === currentLocale ? "text-accent font-semibold" : "text-body/80",
        ]}
      >
        {languages[code]}
      </a>
    ))}
  </div>
</div>

<script>
  function boot() {
    const allMenus = document.querySelectorAll<HTMLElement>("[data-lang-switcher-menu]");
    document.querySelectorAll<HTMLElement>("[data-lang-switcher]").forEach((wrapper) => {
      const btn = wrapper.querySelector<HTMLButtonElement>("[data-lang-switcher-btn]");
      const menu = wrapper.querySelector<HTMLElement>("[data-lang-switcher-menu]");
      if (!btn || !menu || btn.dataset.wired) return;
      btn.dataset.wired = "1";

      const close = () => {
        menu.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
      };
      const toggle = () => {
        const willOpen = menu.classList.contains("hidden");
        allMenus.forEach((m) => m.classList.add("hidden"));
        menu.classList.toggle("hidden", !willOpen);
        btn.setAttribute("aria-expanded", String(willOpen));
      };

      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        toggle();
      });
      document.addEventListener("click", (e) => {
        if (!wrapper.contains(e.target as Node)) close();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    });
  }

  document.addEventListener("DOMContentLoaded", boot);
  document.addEventListener("astro:page-load", boot);
</script>
