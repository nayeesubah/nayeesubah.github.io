---
import { buildSEO } from "../lib/seo";
import type { SEOProps } from "../lib/seo";

const {
  title,
  description,
  image,
  canonical,
  noIndex,
  type,
  publishedTime,
  modifiedTime,
  author,
  breadcrumbs,
  siteName,
  twitterLabels,
} = buildSEO(Astro.props as SEOProps);

const baseUrl = Astro.site;

const schemaOrg = [];
schemaOrg.push({
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${Astro.site}#organization`,
  name: siteName,
  url: `${Astro.site}`,
  logo: {
    "@type": "ImageObject",
    url: new URL("/images/nsf-logo.webp", baseUrl).href,
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    email: "nsfgiridih@gmail.com",
  },
});
if (breadcrumbs) {
  schemaOrg.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: crumb.label,
      item: `${Astro.site}${crumb.href}`,
    })),
  });
}
if (type === "article" && publishedTime) {
  schemaOrg.push({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description: description,
    author:
      author && author !== siteName
        ? { "@type": "Person", name: author }
        : { "@type": "Organization", name: siteName },
    datePublished: publishedTime,
    dateModified: modifiedTime || publishedTime,
    image: new URL(image, baseUrl).href,
    publisher: {
      "@type": "Organization",
      name: siteName,
      logo: {
        "@type": "ImageObject",
        url: new URL("/images/nsf-logo.webp", baseUrl).href,
      },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical || Astro.url.href },
  });
}
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical || Astro.url.href} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical || Astro.url.href} />
<meta property="og:image" content={new URL(image, baseUrl).href} />
<meta property="og:site_name" content={siteName} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, baseUrl).href} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{author && <meta name="author" content={author} />}
{noIndex && <meta name="robots" content="noindex,nofollow" />}
{twitterLabels?.map((l) => (
  <>
    <meta name="twitter:label1" content={l.label} />
    <meta name="twitter:data1" content={l.value} />
  </>
))}

{schemaOrg.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}

{breadcrumbs && (
  <nav aria-label="Breadcrumb" class="sr-only">
    <ol>
      {breadcrumbs.map((crumb) => (
        <li><a href={crumb.href}>{crumb.label}</a></li>
      ))}
    </ol>
  </nav>
)}
