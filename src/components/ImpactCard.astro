---
interface Props {
  value: string;
  label: string;
  icon?: string;
}

const { value, label, icon } = Astro.props;
---

<div class="card p-6 text-center group hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
  {icon && (
    <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
      </svg>
    </div>
  )}
  <div class="text-3xl sm:text-4xl font-black text-accent mb-1">{value}</div>
  <div class="text-sm text-muted">{label}</div>
</div>
