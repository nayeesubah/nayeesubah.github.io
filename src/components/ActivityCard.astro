---

<a
  href={`/activities/${activity.id}/`}
  class="card-hover card block p-6"
>
  <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent">
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d={categoryIcons[data.category] || categoryIcons["community-development"]} />
    </svg>
  </div>
  <h3 class="text-lg font-semibold mb-2">{data.title}</h3>
  <p class="text-muted text-sm leading-relaxed mb-4">{data.excerpt || data.description.slice(0, 120)}...</p>
  {data.impactNumbers && Object.keys(data.impactNumbers).length > 0 && (
    <div class="flex flex-wrap gap-3 mt-auto pt-4 border-t border-border">
      {Object.entries(data.impactNumbers).slice(0, 2).map(([key, val]) => (
        <span class="text-xs font-medium text-accent">
          {val} {key}
        </span>
      ))}
    </div>
  )}
</a>
