---
import type { CollectionEntry } from "astro:content";
import { activityCategoryIcon, activityCategoryLabel } from "../lib/activityCategories";

interface Props {
  activity: CollectionEntry<"activities">;
}

const { activity } = Astro.props;
const { data } = activity;
const icon = activityCategoryIcon(data.category);
const topImpact = data.impactNumbers ? Object.entries(data.impactNumbers).slice(0, 2) : [];
---

<a
  href={`/activities/${activity.id}/`}
  class="activity-card card-hover card block overflow-hidden group"
  aria-label={`${data.title} — ${activityCategoryLabel(data.category)}`}
>
  <div class="relative aspect-[16/10] overflow-hidden bg-accent-soft">
    {data.image ? (
      <img
        src={data.image}
        alt={data.title}
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
        loading="lazy"
        transition:name={`activity-image-${activity.id}`}
      />
    ) : (
      <div
        class="h-full w-full flex items-center justify-center bg-[radial-gradient(circle_at_30%_20%,var(--color-accent-soft),var(--color-card)_70%)] transition-transform duration-500 ease-out group-hover:scale-105"
        transition:name={`activity-image-${activity.id}`}
      >
        <svg class="h-14 w-14 text-accent/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
          <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
        </svg>
      </div>
    )}
    <div class="absolute inset-0 bg-linear-to-t from-black/55 via-black/0 to-black/0 pointer-events-none" />
    <span class="absolute bottom-3 left-3 inline-flex h-9 w-9 items-center justify-center rounded-xl bg-card/90 backdrop-blur text-accent shadow-sm">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
      </svg>
    </span>
    <span class="absolute top-3 right-3 rounded-full bg-card/90 backdrop-blur px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-accent shadow-sm">
      {activityCategoryLabel(data.category)}
    </span>
  </div>

  <div class="p-6">
    <h3 class="text-lg font-semibold mb-2 group-hover:text-accent transition-colors">{data.title}</h3>
    <p class="text-muted text-sm leading-relaxed mb-4 line-clamp-2">{data.excerpt || data.description}</p>
    <div class="flex items-center justify-between gap-3 pt-4 border-t border-border">
      {topImpact.length > 0 ? (
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          {topImpact.map(([key, val]) => (
            <span class="text-xs font-medium text-accent">
              {val} <span class="text-muted font-normal capitalize">{key}</span>
            </span>
          ))}
        </div>
      ) : <span />}
      <span class="inline-flex items-center gap-1 text-xs font-semibold text-accent shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
        Learn more
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
      </span>
    </div>
  </div>
</a>
