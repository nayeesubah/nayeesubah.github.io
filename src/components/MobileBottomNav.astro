---

<nav
  id="mobile-bottom-nav"
  class="lg:hidden fixed bottom-0 left-0 right-0 z-40 border-t border-border bg-card backdrop-blur-md safe-area-bottom"
  aria-label="Mobile navigation"
>
  <div class="flex items-center justify-around px-2 py-1">
    {items.map((item) => (
      <a
        href={item.href}
        class="flex flex-col items-center gap-0.5 px-3 py-2 text-body/60 hover:text-accent transition-colors min-w-0"
      >
        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
        </svg>
        <span class="text-[10px] font-medium truncate w-full text-center">{item.label}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
</style>

<script>
  const bottomNav = document.getElementById("mobile-bottom-nav");
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  function toggleBottomNav() {
    if (mobileMenu && !mobileMenu.classList.contains("hidden")) {
      bottomNav?.classList.add("hidden");
    } else {
      bottomNav?.classList.remove("hidden");
    }
  }

  mobileBtn?.addEventListener("click", toggleBottomNav);
</script>
