---
import StatusBadge from "../StatusBadge.astro";
import { formatINR } from "../../lib/site";
import { getCollection } from "astro:content";

const projects = await getCollection("investment-projects");
const totalInvestment = projects.reduce((sum, p) => sum + p.data.investmentAmount, 0);
const totalCurrentValue = projects.reduce((sum, p) => sum + p.data.currentValue, 0);
const activeProjects = projects.filter((p) => p.data.status === "active");
const totalExpectedReturn = projects.reduce((sum, p) => sum + p.data.expectedReturn, 0);
const totalActualReturn = projects.reduce((sum, p) => sum + p.data.actualReturn, 0);
const featured = projects.filter((p) => p.data.featured);
const sortedByReturn = [...projects].sort((a, b) => b.data.actualReturn - a.data.actualReturn);
const overallROI = totalInvestment > 0 ? ((totalActualReturn / totalInvestment) * 100).toFixed(1) : "0";

const categoryBreakdown = projects.reduce((acc, p) => {
  const cat = p.data.businessCategory;
  if (!acc[cat]) acc[cat] = { investment: 0, return: 0, count: 0 };
  acc[cat].investment += p.data.investmentAmount;
  acc[cat].return += p.data.actualReturn;
  acc[cat].count++;
  return acc;
}, {} as Record<string, { investment: number; return: number; count: number }>);

const categoryEntries = Object.entries(categoryBreakdown).sort((a, b) => b[1].investment - a[1].investment);

const riskConfig: Record<string, { label: string; class: string }> = {
  low: { label: "Low Risk", class: "bg-success/10 text-success" },
  medium: { label: "Medium Risk", class: "bg-warning/10 text-warning" },
  high: { label: "High Risk", class: "bg-error/10 text-error" },
};
---

<section class="py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="text-accent font-semibold text-sm uppercase tracking-widest">Investment Program</span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mt-3 mb-6">
        Building a <span class="text-accent">Self-Sufficient</span> Future
      </h1>
      <p class="text-muted text-lg leading-relaxed">
        The NSF Investment Program is our strategic initiative to make the Nayee Subah Foundation financially self-dependent. By generating sustainable income through carefully selected investments, we ensure that our mission continues to thrive and expand without relying solely on donations.
      </p>
    </div>
  </div>
</section>

{/* Dashboard */}
<section class="py-16 sm:py-20 lg:py-24 bg-section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="section-title mb-12">
      <h2>Portfolio <span class="text-accent">Dashboard</span></h2>
      <p>Real-time overview of our investment performance and allocation.</p>
    </div>

    <div class="grid lg:grid-cols-5 gap-6 mb-10">
      <div class="card p-5 text-center group">
        <div class="mx-auto mb-2 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        </div>
        <div class="text-xl font-black text-accent">{formatINR(totalInvestment)}</div>
        <div class="text-[10px] uppercase tracking-wider text-muted mt-0.5">Total Invested</div>
      </div>
      <div class="card p-5 text-center group">
        <div class="mx-auto mb-2 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6Z" /></svg>
        </div>
        <div class="text-xl font-black text-accent">{activeProjects.length}</div>
        <div class="text-[10px] uppercase tracking-wider text-muted mt-0.5">Active Projects</div>
      </div>
      <div class="card p-5 text-center group">
        <div class="mx-auto mb-2 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        </div>
        <div class="text-xl font-black text-accent">{formatINR(totalActualReturn)}</div>
        <div class="text-[10px] uppercase tracking-wider text-muted mt-0.5">Actual Return</div>
      </div>
      <div class="card p-5 text-center group">
        <div class="mx-auto mb-2 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625Z" /></svg>
        </div>
        <div class="text-xl font-black text-accent">{formatINR(totalCurrentValue)}</div>
        <div class="text-[10px] uppercase tracking-wider text-muted mt-0.5">Current Value</div>
      </div>
      <div class="card p-5 text-center group">
        <div class="mx-auto mb-2 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h14.25M3 9h9.75M3 13.5h5.25m5.25-.75L17.25 9m0 0L21 12.75M17.25 9v12" /></svg>
        </div>
        <div class="text-xl font-black text-accent">{overallROI}%</div>
        <div class="text-[10px] uppercase tracking-wider text-muted mt-0.5">Overall ROI</div>
      </div>
    </div>

    {/* Allocation & Allocation Breakdown */}
    <div class="grid lg:grid-cols-2 gap-6 mb-10">
      <div class="card p-6">
        <h3 class="font-semibold mb-4">Portfolio Allocation by Category</h3>
        <div class="space-y-4">
          {categoryEntries.map(([cat, data]) => {
            const pct = ((data.investment / totalInvestment) * 100).toFixed(0);
            return (
              <div>
                <div class="flex items-center justify-between text-sm mb-1.5">
                  <span class="font-medium">{cat}</span>
                  <span class="text-muted">{formatINR(data.investment)} ({pct}%)</span>
                </div>
                <div class="h-2 rounded-full bg-muted/10 overflow-hidden">
                  <div class="h-full rounded-full bg-accent transition-all duration-500" style={`width: ${pct}%`} />
                </div>
                <div class="flex items-center gap-3 mt-1 text-xs text-muted">
                  <span>{data.count} project{data.count > 1 ? "s" : ""}</span>
                  <span>Return: {formatINR(data.return)}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div class="card p-6">
        <h3 class="font-semibold mb-4">Return Allocation</h3>
        <p class="text-xs text-muted mb-5">How actual returns are distributed to fulfill our mission.</p>
        <div class="space-y-4">
          {[
            { label: "Profit Distributed to Members", value: Math.round(totalActualReturn * 0.6), color: "bg-success", pct: "60" },
            { label: "Reserve Fund", value: Math.round(totalActualReturn * 0.3), color: "bg-info", pct: "30" },
            { label: "Community Welfare", value: Math.round(totalActualReturn * 0.1), color: "bg-warning", pct: "10" },
          ].map((item) => (
            <div>
              <div class="flex items-center justify-between text-sm mb-1.5">
                <span class="font-medium">{item.label}</span>
                <span class="text-muted">{formatINR(item.value)}</span>
              </div>
              <div class="h-2.5 rounded-full bg-muted/10 overflow-hidden">
                <div class={`h-full rounded-full ${item.color} transition-all duration-500`} style={`width: ${item.pct}%`} />
              </div>
            </div>
          ))}
        </div>
        <div class="mt-5 pt-4 border-t border-border flex items-center justify-between text-sm">
          <span class="text-muted">Total Actual Return</span>
          <span class="font-bold text-accent">{formatINR(totalActualReturn)}</span>
        </div>
      </div>
    </div>

    {/* Expected vs Actual */}
    <div class="card p-6">
      <h3 class="font-semibold mb-4">Expected vs Actual Return by Project</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border">
              <th class="text-left py-3 pr-4 font-semibold">Project</th>
              <th class="text-right py-3 px-4 font-semibold">Investment</th>
              <th class="text-right py-3 px-4 font-semibold">Expected</th>
              <th class="text-right py-3 px-4 font-semibold">Actual</th>
              <th class="text-right py-3 px-4 font-semibold">Achieved</th>
              <th class="text-right py-3 pl-4 font-semibold">Status</th>
            </tr>
          </thead>
          <tbody>
            {sortedByReturn.map((p) => {
              const achieved = p.data.expectedReturn > 0 ? Math.round((p.data.actualReturn / p.data.expectedReturn) * 100) : 0;
              return (
                <tr class="border-b border-border last:border-0 hover:bg-accent-soft/30 transition-colors">
                  <td class="py-3 pr-4">
                    <a href={`/investment/projects/${p.id}/`} class="font-medium hover:text-accent transition-colors">{p.data.title}</a>
                  </td>
                  <td class="text-right py-3 px-4 text-muted">{formatINR(p.data.investmentAmount)}</td>
                  <td class="text-right py-3 px-4 text-muted">{formatINR(p.data.expectedReturn)}</td>
                  <td class="text-right py-3 px-4 font-medium">{formatINR(p.data.actualReturn)}</td>
                  <td class="text-right py-3 px-4">
                    <span class={`inline-flex items-center gap-1 text-xs font-semibold ${achieved >= 100 ? "text-success" : achieved >= 50 ? "text-warning" : "text-error"}`}>
                      {achieved}%
                      {achieved >= 100 ? (
                        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                      ) : (
                        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
                      )}
                    </span>
                  </td>
                  <td class="text-right py-3 pl-4">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold ${
                      p.data.status === "active" ? "bg-success/10 text-success" :
                      p.data.status === "planning" ? "bg-info/10 text-info" :
                      p.data.status === "completed" ? "bg-accent/10 text-accent" :
                      "bg-error/10 text-error"
                    }`}>
                      {p.data.status}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{/* Featured Projects */}
{featured.length > 0 && (
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="section-title mb-12">
        <h2>Featured <span class="text-accent">Projects</span></h2>
        <p>Our flagship initiatives driving sustainable returns and community impact.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {featured.map((p) => {
          const cfg = riskConfig[p.data.riskLevel] || riskConfig.medium;
          const achieved = p.data.expectedReturn > 0 ? Math.round((p.data.actualReturn / p.data.expectedReturn) * 100) : 0;
          return (
            <a href={`/investment/projects/${p.id}/`} class="card-hover card p-6 group">
              <div class="flex items-start justify-between mb-4">
                <div>
                  <span class="text-xs text-muted uppercase tracking-wider">{p.data.businessCategory}</span>
                  <h3 class="text-lg font-semibold mt-0.5 group-hover:text-accent transition-colors">{p.data.title}</h3>
                </div>
                <span class={`px-2 py-0.5 rounded-full text-[10px] font-semibold ${cfg.class}`}>{cfg.label}</span>
              </div>
              <p class="text-sm text-muted line-clamp-2 mb-4">{p.data.description}</p>
              <div class="grid grid-cols-3 gap-3 mb-4">
                <div class="text-center p-2 rounded-lg bg-section">
                  <div class="text-xs text-muted">Invested</div>
                  <div class="text-sm font-bold">{formatINR(p.data.investmentAmount)}</div>
                </div>
                <div class="text-center p-2 rounded-lg bg-section">
                  <div class="text-xs text-muted">Return</div>
                  <div class="text-sm font-bold text-accent">{formatINR(p.data.actualReturn)}</div>
                </div>
                <div class="text-center p-2 rounded-lg bg-section">
                  <div class="text-xs text-muted">Progress</div>
                  <div class="text-sm font-bold">
                    <span class={achieved >= 100 ? "text-success" : achieved >= 50 ? "text-warning" : "text-error"}>
                      {p.data.progress}%
                    </span>
                  </div>
                </div>
              </div>
              <div class="h-2 rounded-full bg-muted/10 overflow-hidden">
                <div class="h-full rounded-full bg-accent transition-all duration-500" style={`width: ${p.data.progress}%`} />
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}

{/* Philosophy */}
<section class="py-16 sm:py-20 lg:py-24 bg-section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="section-title mb-12">
      <h2>Our <span class="text-accent">Philosophy</span></h2>
      <p>Making Nayee Subah Foundation financially self dependent</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {[
        { title: "Generate Sustainable Income", description: "Create reliable, long-term revenue streams that ensure the foundation's operations continue uninterrupted regardless of donation cycles.", icon: "M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" },
        { title: "Support NGO Activities", description: "Profits from investments directly fund our educational programs, healthcare initiatives, community development, and emergency relief efforts.", icon: "M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21" },
        { title: "Socially Responsible Investing", description: "All investments align with our mission and values, focusing on ethical, sustainable, and community-benefiting ventures.", icon: "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" },
        { title: "Transparent Operations", description: "Maintain complete transparency in all investment activities with regular reporting, audits, and community updates.", icon: "M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" },
        { title: "Long-term Stability", description: "Build a robust financial foundation that protects against economic uncertainties and allows for strategic long-term planning.", icon: "M3 4.5h14.25M3 9h9.75M3 13.5h5.25m5.25-.75L17.25 9m0 0L21 12.75M17.25 9v12" },
        { title: "Create Shared Prosperity", description: "Provide our community members with opportunities to participate in wealth-building initiatives and shared prosperity.", icon: "M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07" },
      ].map((point) => (
        <div class="card p-6 text-center group">
          <div class="mx-auto mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent group-hover:bg-accent group-hover:text-accent-text transition-all duration-300">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={point.icon} /></svg>
          </div>
          <h3 class="font-semibold mb-2">{point.title}</h3>
          <p class="text-muted text-sm leading-relaxed">{point.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{/* All Projects */}
<section class="py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="section-title mb-12">
      <h2>All <span class="text-accent">Projects</span></h2>
      <p>Complete portfolio of investment projects.</p>
    </div>
    <div class="grid lg:grid-cols-2 gap-6">
      {projects.map((p) => {
        const cfg = riskConfig[p.data.riskLevel] || riskConfig.medium;
        const achieved = p.data.expectedReturn > 0 ? Math.round((p.data.actualReturn / p.data.expectedReturn) * 100) : 0;
        const isUp = achieved >= 100;
        const isOnTrack = achieved >= 50 && achieved < 100;
        return (
          <a href={`/investment/projects/${p.id}/`} class="card-hover card p-5 group">
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-2">
                <StatusBadge status={p.data.status} />
                <span class={`px-2 py-0.5 rounded-full text-[10px] font-semibold ${cfg.class}`}>{cfg.label}</span>
              </div>
              <svg class="h-5 w-5 text-muted group-hover:text-accent transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
            </div>
            <h3 class="font-semibold group-hover:text-accent transition-colors">{p.data.title}</h3>
            <p class="text-xs text-muted mb-3">{p.data.businessCategory}</p>
            <div class="grid grid-cols-3 gap-2 mb-3">
              <div>
                <div class="text-[10px] text-muted">Invested</div>
                <div class="text-sm font-semibold">{formatINR(p.data.investmentAmount)}</div>
              </div>
              <div>
                <div class="text-[10px] text-muted">Return</div>
                <div class="text-sm font-semibold text-accent">{formatINR(p.data.actualReturn)}</div>
              </div>
              <div>
                <div class="text-[10px] text-muted">Progress</div>
                <div class="text-sm font-semibold">{p.data.progress}%</div>
              </div>
            </div>
            <div class="h-1.5 rounded-full bg-muted/10 overflow-hidden">
              <div class={`h-full rounded-full transition-all duration-500 ${
                isUp ? "bg-success" : isOnTrack ? "bg-warning" : "bg-error"
              }`} style={`width: ${p.data.progress}%`} />
            </div>
            <div class="flex items-center justify-between mt-2">
              <span class="text-[10px] text-muted">Expected: {formatINR(p.data.expectedReturn)}</span>
              <span class={`text-[10px] font-semibold flex items-center gap-0.5 ${
                isUp ? "text-success" : isOnTrack ? "text-warning" : "text-error"
              }`}>
                {achieved}% achieved
                {isUp ? (
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                ) : (
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" /></svg>
                )}
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

{/* CTA */}
<section class="py-16 sm:py-20 lg:py-24 bg-section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="section-title mb-12">
      <h2>Explore <span class="text-accent">More</span></h2>
      <p>Dive deeper into our investment program.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
