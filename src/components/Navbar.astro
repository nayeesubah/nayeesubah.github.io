---
import { t, defaultLang, type UiKey } from "../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale || defaultLang;
const navItems = [
  { key: "nav.home", href: "/" },
  { key: "nav.about", href: "/about/" },
  { key: "nav.activities", href: "/activities/" },
  { key: "nav.events", href: "/events/" },
  { key: "nav.members", href: "/members/" },
  { key: "nav.investment", href: "/investment/" },
  { key: "nav.gallery", href: "/gallery/" },
  { key: "nav.news", href: "/blog/" },
  { key: "nav.contact", href: "/contact/" },
].map((item) => ({
  label: t(locale, item.key as UiKey),
  href: getRelativeLocaleUrl(locale, item.href),
}));
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="navbar">
  <nav class="backdrop-blur-md bg-nav-bg border-b border-nav-border" aria-label="Main navigation">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex h-18 items-center justify-between">
      <a href={getRelativeLocaleUrl(locale, "/")} class="flex items-center gap-3 shrink-0" aria-label="Nayee Subah Foundation Home">
        <img src="/images/nsf-logo.webp" alt="NSF" class="h-8 w-auto block dark:hidden" />
        <img src="/images/nsf-logo-dark.webp" alt="NSF" class="h-8 w-auto hidden dark:block" />
        <!-- <span class="hidden sm:inline text-sm font-medium text-body/80">Nayee Subah Foundation</span> -->
      </a>

      <div class="hidden lg:flex items-center gap-1">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="relative px-4 py-2 text-sm font-medium text-body/80 transition-colors hover:text-accent"
            >
              {item.label}
            </a>
          ))
        }
        <button type="button" data-search-open class="ml-2 p-2 rounded-xl text-body/80 hover:text-accent hover:bg-accent-soft transition-colors" aria-label="Search" title="Search (⌘K)">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </button>
        <button id="theme-toggle" class="p-2 rounded-xl text-body/80 hover:text-accent hover:bg-accent-soft transition-colors" aria-label={t(locale, "nav.toggleTheme")}>
          <svg class="h-5 w-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg class="h-5 w-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
        <a href={getRelativeLocaleUrl(locale, "/donate/")} class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium text-sm hover:bg-accent-hover transition-all duration-200 ml-4">
          {t(locale, "nav.donate")}
        </a>
      </div>

      <button id="mobile-menu-btn" class="lg:hidden p-3" aria-label="Toggle menu" aria-expanded="false">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden border-t border-border bg-card backdrop-blur-md">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4 space-y-1">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="block px-4 py-3 rounded-lg text-sm font-medium text-body/80 hover:bg-accent-soft hover:text-accent transition-colors"
            >
              {item.label}
            </a>
          ))
        }
        <button type="button" data-search-open class="flex items-center gap-3 w-full px-4 py-3 rounded-lg text-sm font-medium text-body/80 hover:bg-accent-soft hover:text-accent transition-colors">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          Search
        </button>
        <button id="theme-toggle-mobile" class="flex items-center gap-3 w-full px-4 py-3 rounded-lg text-sm font-medium text-body/80 hover:bg-accent-soft hover:text-accent transition-colors">
          <svg class="h-5 w-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg class="h-5 w-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span class="dark:hidden">Dark Mode</span><span class="hidden dark:inline">Light Mode</span>
        </button>
        <a href={getRelativeLocaleUrl(locale, "/donate/")} class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent text-accent-text px-6 py-3 font-medium text-sm hover:bg-accent-hover transition-all duration-200 mt-3 w-full">
          {t(locale, "nav.donate")}
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const toggleDesktop = document.getElementById("theme-toggle");
  const toggleMobile = document.getElementById("theme-toggle-mobile");

  let lastScroll = 0;
  window.addEventListener("scroll", () => {
    const current = window.scrollY;
    if (current > 100) {
      if (current > lastScroll && current > 200) {
        navbar.style.transform = "translateY(-100%)";
      } else {
        navbar.style.transform = "translateY(0)";
      }
    } else {
      navbar.style.transform = "translateY(0)";
    }
    lastScroll = current;
  });

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener("click", () => {
      const isOpen = mobileMenu.classList.contains("hidden");
      mobileMenu.classList.toggle("hidden");
      mobileBtn.setAttribute("aria-expanded", isOpen);
    });
  }

  function toggleTheme() {
    const html = document.documentElement;
    const isDark = html.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  }

  toggleDesktop?.addEventListener("click", toggleTheme);
  toggleMobile?.addEventListener("click", toggleTheme);
</script>
