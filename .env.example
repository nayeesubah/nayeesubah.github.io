# Members-area vault passwords are NOT set here. For local builds, copy
# secrets.example.json -> secrets.json (git-ignored). For CI, set MATRIX_PASSWORD
# and MEMBER_PASSWORDS as GitHub repository secrets. See CLAUDE.md > Security.

# Umami Analytics (optional) — https://cloud.umami.is
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# Giscus comments (optional) — https://giscus.app
# Requires a public GitHub repo with Discussions enabled.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Blog
PUBLIC_GISCUS_CATEGORY_ID=
